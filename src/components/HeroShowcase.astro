---
import Icon from './Icon.astro';
---
<div class="w-full max-w-[460px] mx-auto flex flex-col gap-3.5">
  <!-- Studio Status Header Card -->
  <div class="glass-card p-4 flex items-center justify-between gap-3 shadow-md">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-sky-400/10 border border-sky-400/25 flex items-center justify-center text-sky-400 flex-shrink-0">
        <Icon name="Smartphone" class="w-4 h-4" />
      </div>
      <div>
        <span class="text-xs font-bold text-[var(--text-primary)] block leading-tight">BramLabs Studio IP</span>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Active Developer Account</span>
      </div>
    </div>
    <span class="badge badge-emerald text-[10px] font-mono">100% Original</span>
  </div>

  <!-- Live Software Grid Preview -->
  <div class="glass-card p-4 flex flex-col gap-3">
    <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold">Active Product Lanes</span>
    
    <div class="flex flex-col gap-2.5">
      <!-- App Item -->
      <div class="flex items-center justify-between p-2.5 rounded-lg bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-default)] transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="BellOff" class="w-4 h-4 text-sky-400 flex-shrink-0" />
          <span class="text-xs font-bold text-[var(--text-primary)]">ClearCue</span>
        </div>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Appstore · Live</span>
      </div>

      <!-- App Item -->
      <div class="flex items-center justify-between p-2.5 rounded-lg bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-default)] transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="Calendar" class="w-4 h-4 text-sky-400 flex-shrink-0" />
          <span class="text-xs font-bold text-[var(--text-primary)]">ShiftLedger</span>
        </div>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Appstore · Live</span>
      </div>

      <!-- App Item -->
      <div class="flex items-center justify-between p-2.5 rounded-lg bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-default)] transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="Activity" class="w-4 h-4 text-sky-400 flex-shrink-0" />
          <span class="text-xs font-bold text-[var(--text-primary)]">Cadence</span>
        </div>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Mobile · Pending</span>
      </div>

      <!-- Extension Item -->
      <div class="flex items-center justify-between p-2.5 rounded-lg bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-default)] transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="Volume2" class="w-4 h-4 text-indigo-400 flex-shrink-0" />
          <span class="text-xs font-bold text-[var(--text-primary)]">SonicShield</span>
        </div>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Chrome · Live</span>
      </div>

      <!-- Web Item -->
      <div class="flex items-center justify-between p-2.5 rounded-lg bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-default)] transition-colors">
        <div class="flex items-center gap-2.5">
          <Icon name="Workflow" class="w-4 h-4 text-emerald-400 flex-shrink-0" />
          <span class="text-xs font-bold text-[var(--text-primary)]">WorkflowAI.site</span>
        </div>
        <span class="text-[10px] font-mono text-[var(--text-muted)]">Web · Live</span>
      </div>
    </div>
  </div>

  <!-- Merch Compliance Strip -->
  <div class="glass-card p-3 flex items-center justify-between text-xs text-[var(--text-muted)]">
    <span class="flex items-center gap-1.5 font-mono text-[11px]">
      <Icon name="ShieldCheck" class="w-3.5 h-3.5 text-emerald-400" />
      Merch on Demand Reference
    </span>
    <a href="/merch" class="text-sky-400 hover:underline font-semibold text-[11px]">300 DPI Specs →</a>
  </div>
</div>
