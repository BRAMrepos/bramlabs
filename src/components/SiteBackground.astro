---
// Ambient background: CSS aurora + grid (instant) + canvas particles + cursor glow (deferred)
---
<div class="site-bg" aria-hidden="true">
  <div class="site-bg__grid" data-parallax="0.03"></div>
  <div class="site-bg__stars site-bg__stars--a"></div>
  <div class="site-bg__stars site-bg__stars--b"></div>
  <div class="site-bg__aurora site-bg__aurora--a" data-parallax="0.06"></div>
  <div class="site-bg__aurora site-bg__aurora--b" data-parallax="0.09"></div>
  <div class="site-bg__aurora site-bg__aurora--c" data-parallax="0.05"></div>
  <div class="site-bg__orb site-bg__orb--a" data-parallax="0.1"></div>
  <div class="site-bg__orb site-bg__orb--b" data-parallax="0.14"></div>
  <div class="site-bg__noise"></div>
  <div id="cursor-glow" class="site-bg__cursor"></div>
</div>

<script>
  (function() {
    // Cursor glow
    const cursor = document.getElementById('cursor-glow');
    if (!cursor || window.matchMedia('(pointer: coarse)').matches) return;
    let visible = false;
    document.addEventListener('mousemove', (e) => {
      cursor.style.transform = `translate(${e.clientX - 210}px, ${e.clientY - 210}px)`;
      if (!visible) { cursor.style.opacity = '1'; visible = true; }
    });
    document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; visible = false; });

    // Card mouse-tracking glow: updates --mx --my CSS vars
    document.querySelectorAll('.glass-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty('--mx', x + '%');
        card.style.setProperty('--my', y + '%');
      });
    });
  })();
</script>

<style>
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 90% 55% at 50% -8%, rgba(56,189,248,0.13), transparent 55%),
      radial-gradient(ellipse 55% 45% at 92% 8%,  rgba(139,92,246,0.11),  transparent 50%),
      radial-gradient(ellipse 40% 35% at 10% 70%, rgba(34,211,238,0.07),   transparent 55%),
      var(--site-bg-base, #06080f);
    transition: background 0.3s ease;
  }

  :global(html[data-theme='light']) .site-bg {
    background:
      radial-gradient(ellipse 90% 55% at 50% -8%, rgba(14,165,233,0.13),  transparent 55%),
      radial-gradient(ellipse 55% 45% at 92% 8%,  rgba(99,102,241,0.11),  transparent 50%),
      radial-gradient(ellipse 40% 35% at 10% 70%, rgba(6,182,212,0.07),    transparent 55%),
      var(--site-bg-base, #f4f7fb);
  }

  .site-bg__grid {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(rgba(255,255,255,0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.032) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 15%, black 15%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 15%, black 15%, transparent 72%);
    will-change: transform;
    opacity: 0.9;
  }

  :global(html[data-theme='light']) .site-bg__grid {
    opacity: 0.55;
    background-image:
      linear-gradient(rgba(14,165,233,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14,165,233,0.07) 1px, transparent 1px);
  }

  .site-bg__stars {
    position: absolute;
    inset: 0;
    opacity: 0.75;
    background-repeat: repeat;
    animation: stars-drift 80s linear infinite;
  }

  .site-bg__stars--a {
    background-image:
      radial-gradient(1.2px 1.2px at 8% 12%,  rgba(224,242,254,0.85), transparent),
      radial-gradient(1px   1px   at 22% 38%, rgba(165,180,252,0.7),  transparent),
      radial-gradient(1.4px 1.4px at 41% 18%, rgba(125,211,252,0.8),  transparent),
      radial-gradient(1px   1px   at 58% 62%, rgba(255,255,255,0.55), transparent),
      radial-gradient(1.2px 1.2px at 73% 28%, rgba(186,230,253,0.75), transparent),
      radial-gradient(1px   1px   at 88% 48%, rgba(165,180,252,0.65), transparent),
      radial-gradient(1.3px 1.3px at 15% 72%, rgba(125,211,252,0.7),  transparent),
      radial-gradient(1px   1px   at 35% 88%, rgba(255,255,255,0.5),  transparent),
      radial-gradient(1.1px 1.1px at 62% 8%,  rgba(224,242,254,0.7),  transparent),
      radial-gradient(1px   1px   at 92% 82%, rgba(129,140,248,0.65), transparent);
    background-size: 100% 100%;
  }

  .site-bg__stars--b {
    opacity: 0.5;
    animation-duration: 120s;
    animation-direction: reverse;
    background-image:
      radial-gradient(1px   1px   at 12% 24%, rgba(255,255,255,0.5),  transparent),
      radial-gradient(1.5px 1.5px at 30% 55%, rgba(125,211,252,0.55), transparent),
      radial-gradient(1px   1px   at 50% 30%, rgba(165,180,252,0.5),  transparent),
      radial-gradient(1.2px 1.2px at 70% 70%, rgba(224,242,254,0.55), transparent),
      radial-gradient(1px   1px   at 85% 20%, rgba(255,255,255,0.4),  transparent),
      radial-gradient(1.3px 1.3px at 25% 80%, rgba(129,140,248,0.5),  transparent);
    background-size: 100% 100%;
  }

  :global(html[data-theme='light']) .site-bg__stars {
    opacity: 0.6;
    filter: invert(0.7) hue-rotate(180deg);
  }

  .site-bg__aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    opacity: 0.7;
    will-change: transform;
    animation: aurora-shift 22s ease-in-out infinite alternate;
  }

  .site-bg__aurora--a {
    width: min(58vw, 560px);
    height: min(58vw, 560px);
    top: -14%; left: -10%;
    background: radial-gradient(circle, rgba(56,189,248,0.34) 0%, transparent 70%);
  }

  .site-bg__aurora--b {
    width: min(52vw, 500px);
    height: min(52vw, 500px);
    top: 8%; right: -12%;
    background: radial-gradient(circle, rgba(129,140,248,0.32) 0%, transparent 70%);
    animation-duration: 28s;
    animation-delay: -5s;
  }

  .site-bg__aurora--c {
    width: min(42vw, 420px);
    height: min(42vw, 420px);
    bottom: 0%; left: 28%;
    background: radial-gradient(circle, rgba(45,212,191,0.2) 0%, transparent 70%);
    animation-duration: 34s;
    animation-delay: -9s;
  }

  .site-bg__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.4;
    animation: orb-float 18s ease-in-out infinite alternate;
    box-shadow: 0 0 48px rgba(56,189,248,0.28);
  }

  .site-bg__orb--a {
    width: 8px; height: 8px;
    top: 22%; left: 18%;
    background: #7dd3fc;
  }

  .site-bg__orb--b {
    width: 6px; height: 6px;
    top: 58%; right: 22%;
    background: #a5b4fc;
    animation-duration: 24s;
    animation-delay: -4s;
  }

  .site-bg__noise {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .site-bg__cursor {
    position: fixed;
    top: 0; left: 0;
    width: 420px; height: 420px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(circle, rgba(56,189,248,0.14) 0%, rgba(129,140,248,0.07) 35%, transparent 70%);
    mix-blend-mode: screen;
    will-change: transform;
    z-index: 1;
  }

  :global(html[data-theme='light']) .site-bg__cursor {
    mix-blend-mode: normal;
    background: radial-gradient(circle, rgba(14,165,233,0.16) 0%, rgba(99,102,241,0.07) 35%, transparent 70%);
  }

  @keyframes aurora-shift {
    0%   { transform: translate3d(0,0,0) scale(1); }
    50%  { transform: translate3d(32px,-36px,0) scale(1.1); }
    100% { transform: translate3d(-22px,24px,0) scale(0.94); }
  }

  @keyframes stars-drift {
    from { transform: translate3d(0,0,0); }
    to   { transform: translate3d(0,-24px,0); }
  }

  @keyframes orb-float {
    0%   { transform: translate3d(0,0,0); opacity: 0.25; }
    50%  { transform: translate3d(12px,-18px,0); opacity: 0.55; }
    100% { transform: translate3d(-8px,10px,0); opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bg__aurora,
    .site-bg__stars,
    .site-bg__orb { animation: none !important; }
    .site-bg__cursor { display: none !important; }
  }

  @media (max-width: 767px) {
    .site-bg__cursor { display: none !important; }
    .site-bg__aurora { opacity: 0.5; filter: blur(52px); }
    .site-bg__stars  { opacity: 0.6; }
    .site-bg__grid   { background-size: 40px 40px; }
    .site-bg__orb--b { display: none; }
  }
</style>
