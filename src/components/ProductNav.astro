---
/**
 * Sub-navigation shared by every page under /software/[slug]/.
 * Keeps the product's own pages reachable from each other so a visitor who
 * arrives on a privacy page from a store listing can find the product.
 */
import { strings } from "@/data/i18n";
import type { Locale } from "@/data/software";

interface Props {
  slug: string;
  current: "overview" | "privacy" | "support" | "changelog";
  hasChangelog?: boolean;
  locale?: Locale;
}

const { slug, current, hasChangelog = false, locale = "en" } = Astro.props;
const t = strings(locale);

const tabs = [
  { key: "overview", label: t.navOverview, href: `/software/${slug}/` },
  { key: "support", label: t.navSupport, href: `/software/${slug}/support/` },
  { key: "privacy", label: t.navPrivacy, href: `/software/${slug}/privacy/` },
  ...(hasChangelog
    ? [
        {
          key: "changelog",
          label: t.navChangelog,
          href: `/software/${slug}/changelog/`,
        },
      ]
    : []),
] as const;
---

<nav class="product-nav" aria-label="Product pages">
  <ul>
    {
      tabs.map((t) => (
        <li>
          <a
            href={t.href}
            class:list={[{ active: t.key === current }]}
            aria-current={t.key === current ? "page" : undefined}
          >
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  .product-nav {
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-5);
    /* Scrolls only when the tabs outgrow narrow screens; the track itself
       should never be visible. */
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }

    ul {
      display: flex;
      gap: var(--s-4);
      list-style: none;
      padding: 0;
      margin: 0;
      white-space: nowrap;
    }

    a {
      display: inline-block;
      padding: 0.6rem 0;
      font-size: 0.9rem;
      color: var(--muted);
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition:
        color var(--t) var(--ease),
        border-color var(--t) var(--ease);

      &:hover {
        color: var(--ink);
      }

      &.active {
        color: var(--ink);
        font-weight: 500;
        border-bottom-color: var(--ink);
      }
    }
  }
</style>
