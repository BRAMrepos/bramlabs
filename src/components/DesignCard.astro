---
import type { Design } from "@/data/designs";

interface Props {
  design: Design;
}
const { design } = Astro.props;
const n = String(design.order).padStart(2, "0");
---

<article class="design-card">
  <a href={`/designs/${design.slug}/`} class="card-media">
    <img
      src={design.images.primaryMockup}
      alt={`Black heavyweight T-shirt featuring the ${design.title} graphic`}
      width="800"
      height="1000"
      loading="lazy"
      decoding="async"
    />
    <div class="raw-panel" aria-hidden="true">
      <img
        src={design.images.rawArtwork}
        alt=""
        width="400"
        height="400"
        loading="lazy"
      />
    </div>
  </a>
  <div class="card-body">
    <p class="meta">{n} / {design.category}</p>
    <h3 class="h-card">
      <a href={`/designs/${design.slug}/`}>{design.title}</a>
    </h3>
    <p class="body">{design.shortDescription}</p>
    <a href={`/designs/${design.slug}/`} class="btn -link">View Design →</a>
  </div>
</article>

<style lang="scss">
  .design-card {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }
  .card-media {
    position: relative;
    background: var(--canvas);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-soft);
    > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      transition: transform 600ms var(--ease);
    }
    &:hover > img {
      transform: scale(1.03);
    }
    @media (prefers-reduced-motion: reduce) {
      &:hover > img {
        transform: none;
      }
    }
  }
  .raw-panel {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    width: min(30%, 120px);
    aspect-ratio: 1;
    background: var(--paper);
    border-radius: var(--radius);
    padding: 0.4rem;
    box-shadow: 0 8px 24px rgba(17, 19, 21, 0.12);
    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 36rem;
    padding-inline: 0.15rem;
  }
  .h-card a:hover {
    opacity: 0.75;
  }
</style>
