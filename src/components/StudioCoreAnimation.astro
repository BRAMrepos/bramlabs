---
/**
 * StudioCoreAnimation.astro
 * Interactive 60fps canvas visualization representing BramLabs product engine:
 * Central Studio Core with 4 orbiting discipline nodes (Apps, Extensions, Web, Merch)
 * connected by particle data streams, mouse magnetic pull, and glowing pulses.
 */
---
<div class="relative w-full aspect-square max-w-[460px] mx-auto flex items-center justify-center select-none">
  <!-- Backdrop Radial Glow -->
  <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-sky-500/20 via-indigo-500/15 to-teal-400/10 blur-3xl pointer-events-none animate-pulse"></div>

  <!-- Interactive Canvas -->
  <canvas id="studio-core-canvas" class="absolute inset-0 w-full h-full cursor-pointer z-10"></canvas>

  <!-- Central Floating Badge Overlay -->
  <div class="relative z-20 w-24 h-24 rounded-2xl bg-[#0a0e17]/90 border border-sky-400/30 backdrop-blur-md shadow-2xl shadow-sky-500/20 flex flex-col items-center justify-center p-2 text-center pointer-events-none transition-transform duration-300 hover:scale-105">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center shadow-md mb-1">
      <svg width="16" height="16" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.95"/>
        <rect x="8" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.75"/>
        <rect x="1" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.75"/>
        <rect x="8" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.45"/>
      </svg>
    </div>
    <span class="text-[10px] font-bold tracking-wider text-sky-400 uppercase">Studio</span>
    <span class="text-[9px] text-gray-400 font-mono">Engine</span>
  </div>
</div>

<script>
  (function initStudioCore() {
    const canvas = document.getElementById('studio-core-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = window.devicePixelRatio || 1;

    function resize() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx?.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);

    // Mouse tracking
    let mouseX = width / 2;
    let mouseY = height / 2;
    let targetMouseX = width / 2;
    let targetMouseY = height / 2;
    let isHovering = false;

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      targetMouseX = e.clientX - rect.left;
      targetMouseY = e.clientY - rect.top;
      isHovering = true;
    });

    canvas.addEventListener('mouseleave', () => {
      targetMouseX = width / 2;
      targetMouseY = height / 2;
      isHovering = false;
    });

    // Discipline nodes configuration
    const nodes = [
      { name: 'Apps', label: 'Appstore / Android', color: '#38bdf8', angle: 0, radius: 135, speed: 0.005, icon: '📱' },
      { name: 'Extensions', label: 'Chrome Web Store', color: '#818cf8', angle: Math.PI / 2, radius: 135, speed: 0.005, icon: '🧩' },
      { name: 'Web', label: 'WorkflowAI & Tools', color: '#2dd4bf', angle: Math.PI, radius: 135, speed: 0.005, icon: '🌐' },
      { name: 'Merch', label: '300 DPI Original IP', color: '#a78bfa', angle: (3 * Math.PI) / 2, radius: 135, speed: 0.005, icon: '👕' }
    ];

    // Particle streams
    const particles: Array<{
      nodeIdx: number;
      progress: number;
      speed: number;
      size: number;
    }> = [];

    for (let i = 0; i < 28; i++) {
      particles.push({
        nodeIdx: i % 4,
        progress: Math.random(),
        speed: 0.004 + Math.random() * 0.006,
        size: 1.5 + Math.random() * 2
      });
    }

    let animationFrameId: number;

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const centerX = width / 2;
      const centerY = height / 2;

      // Smooth mouse interpolation
      mouseX += (targetMouseX - mouseX) * 0.08;
      mouseY += (targetMouseY - mouseY) * 0.08;

      const mouseOffsetX = (mouseX - centerX) * 0.15;
      const mouseOffsetY = (mouseY - centerY) * 0.15;

      const coreX = centerX + mouseOffsetX * 0.5;
      const coreY = centerY + mouseOffsetY * 0.5;

      // Draw background ring tracks
      ctx.beginPath();
      ctx.arc(coreX, coreY, 135, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.08)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 6]);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.beginPath();
      ctx.arc(coreX, coreY, 80, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(129, 140, 248, 0.06)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Update and draw nodes
      nodes.forEach((node, idx) => {
        node.angle += node.speed;

        const baseNx = coreX + Math.cos(node.angle) * node.radius;
        const baseNy = coreY + Math.sin(node.angle) * node.radius;

        // Magnetic attraction to cursor
        const dx = mouseX - baseNx;
        const dy = mouseY - baseNy;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const pull = isHovering && dist < 120 ? (120 - dist) * 0.18 : 0;

        const nx = baseNx + (dist > 0 ? (dx / dist) * pull : 0);
        const ny = baseNy + (dist > 0 ? (dy / dist) * pull : 0);

        // Connection beam from core to node
        const grad = ctx.createLinearGradient(coreX, coreY, nx, ny);
        grad.addColorStop(0, 'rgba(56, 189, 248, 0.25)');
        grad.addColorStop(0.5, node.color + '44');
        grad.addColorStop(1, node.color + '88');

        ctx.beginPath();
        ctx.moveTo(coreX, coreY);
        ctx.lineTo(nx, ny);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Node Glow Outer Ring
        ctx.beginPath();
        ctx.arc(nx, ny, 22, 0, Math.PI * 2);
        ctx.fillStyle = node.color + '15';
        ctx.fill();
        ctx.strokeStyle = node.color + '40';
        ctx.lineWidth = 1;
        ctx.stroke();

        // Node Solid Core
        ctx.beginPath();
        ctx.arc(nx, ny, 14, 0, Math.PI * 2);
        ctx.fillStyle = '#0a0e17';
        ctx.fill();
        ctx.strokeStyle = node.color;
        ctx.lineWidth = 2;
        ctx.stroke();

        // Node Icon/Text
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(node.icon, nx, ny);

        // Node Label
        ctx.font = '600 11px Outfit, sans-serif';
        ctx.fillStyle = '#f1f5fb';
        const labelOffsetY = ny > coreY ? 32 : -30;
        ctx.fillText(node.name, nx, ny + labelOffsetY);

        ctx.font = '9px Geist Mono, monospace';
        ctx.fillStyle = '#8f99ab';
        ctx.fillText(node.label, nx, ny + labelOffsetY + (ny > coreY ? 12 : -12));
      });

      // Render streaming data particles along connection beams
      particles.forEach((p) => {
        p.progress += p.speed;
        if (p.progress > 1) p.progress = 0;

        const targetNode = nodes[p.nodeIdx];
        const nx = coreX + Math.cos(targetNode.angle) * targetNode.radius;
        const ny = coreY + Math.sin(targetNode.angle) * targetNode.radius;

        const px = coreX + (nx - coreX) * p.progress;
        const py = coreY + (ny - coreY) * p.progress;

        ctx.beginPath();
        ctx.arc(px, py, p.size, 0, Math.PI * 2);
        ctx.fillStyle = targetNode.color;
        ctx.shadowColor = targetNode.color;
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      animationFrameId = requestAnimationFrame(render);
    }

    render();
  })();
</script>
