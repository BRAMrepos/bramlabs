---
import { getPublishedSoftware } from "@/data/software";

const products = getPublishedSoftware();

const studio = [
  { href: "/software/",   label: "Software"   },
  { href: "/collection/", label: "Apparel"    },
  { href: "/process/",    label: "Process"    },
  { href: "/journal/",    label: "Journal"    },
  { href: "/about/",      label: "About"      },
];
const help = [
  { href: "/feedback/", label: "Send feedback" },
  { href: "/contact/",  label: "Contact"       },
  { href: "/security/", label: "Security"      },
  { href: "/privacy/",  label: "Privacy"       },
  { href: "/terms/",    label: "Terms"         },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="BramLabs home">
          <img src="/brand/mark.svg" alt="" width="24" height="24" />
          <span>BramLabs</span>
        </a>
        <p class="brand-desc">
          Independent software studio run by Bram — small tools for shift work,
          routine and focus, plus original apparel graphics from the same desk.
        </p>
        <p class="brand-by">Built and maintained by one person</p>
      </div>
      <nav aria-label="Footer">
        <div class="col">
          <h2 class="col-head">Products</h2>
          <ul>
            {products.map((p) => (
              <li><a href={`/software/${p.slug}/`}>{p.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="col">
          <h2 class="col-head">Studio</h2>
          <ul>
            {studio.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="col">
          <h2 class="col-head">Help</h2>
          <ul>
            {help.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} BramLabs</p>
      <a href="mailto:contact@bramlabs.co">contact@bramlabs.co</a>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--line);
    padding: var(--s-7) 0 var(--s-5);
    background: var(--canvas);
  }

  .footer-grid {
    display: grid;
    gap: var(--s-6);

    @media (width >= 900px) {
      grid-template-columns: 1.1fr 1.4fr;
      gap: var(--s-7);
    }
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;

    img {
      width: 24px;
      height: 24px;
    }
  }

  .brand-desc {
    margin-top: var(--s-3);
    max-width: 28rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .brand-by {
    margin-top: var(--s-2);
    font-size: 0.875rem;
    color: var(--muted);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-5) var(--s-4);

    @media (width >= 560px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .col ul {
    display: flex;
    flex-direction: column;
  }

  .col-head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  nav a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.9375rem;
    color: var(--muted);
    transition: color var(--t) var(--ease);

    &:hover { color: var(--ink); }
  }

  .footer-bottom {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);

    a {
      transition: color var(--t);
      &:hover { color: var(--ink); }
    }
  }
</style>
