---
const primary = [
  { href: "/collection/", label: "Collection" },
  { href: "/process/", label: "Process" },
  { href: "/studio/", label: "Studio" },
  { href: "/journal/", label: "Journal" },
];
const secondary = [
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="BramLabs home">
          <img src="/brand/mark.svg" alt="" width="24" height="24" />
          <span>BramLabs</span>
        </a>
        <p>
          Original apparel graphics and independent software by BramLabs.
        </p>
        <p class="by">Designed by Bram.</p>
      </div>
      <nav aria-label="Footer">
        <ul>
          {primary.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
        <ul>
          {secondary.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} BramLabs</p>
      <a href="mailto:contact@bramlabs.co">contact@bramlabs.co</a>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 5rem 0 2.5rem;
    background: var(--canvas);
  }
  .footer-grid {
    display: grid;
    gap: 3rem;
    @media (width >= 800px) {
      grid-template-columns: 1.35fr 1fr;
    }
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    img {
      width: 24px;
      height: 24px;
    }
  }
  .footer-brand p {
    margin-top: 1.15rem;
    max-width: 28rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .by {
    margin-top: 0.75rem !important;
    font-size: 0.875rem !important;
  }
  nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  nav a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.9375rem;
    color: var(--muted);
    transition: color var(--t);
    &:hover {
      color: var(--ink);
    }
  }
  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
