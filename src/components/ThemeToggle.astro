---
import { Sun, Moon } from 'lucide-astro';
---

<button
  class="theme-toggle p-2 bg-transparent border-0 text-muted hover:text-text cursor-pointer transition-colors duration-150 flex items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus:outline-none"
  aria-label="Toggle theme"
>
  <!-- Moon icon (visible in light mode, hidden in dark mode) -->
  <span class="icon-moon flex">
    <Moon class="w-[18px] h-[18px]" />
  </span>
  <!-- Sun icon (hidden in light mode, visible in dark mode) -->
  <span class="icon-sun hidden">
    <Sun class="w-[18px] h-[18px]" />
  </span>
</button>
