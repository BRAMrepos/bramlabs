---
import { Sun, Moon } from 'lucide-astro';
---

<button
  type="button"
  id="theme-toggle-btn"
  class="p-2 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.06] transition-colors cursor-pointer focus:outline-none"
  aria-label="Toggle light/dark theme"
>
  <span class="dark:hidden flex items-center justify-center icon-sun">
    <Sun class="w-4 h-4 text-amber-400" />
  </span>
  <span class="hidden dark:flex items-center justify-center icon-moon">
    <Moon class="w-4 h-4 text-sky-400" />
  </span>
</button>

<script is:inline>
  (function() {
    var btn = document.getElementById('theme-toggle-btn');
    if (!btn) return;

    btn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme') || 'dark';
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('bramlabs-theme', next);
      } catch(e) {}
    });
  })();
</script>
