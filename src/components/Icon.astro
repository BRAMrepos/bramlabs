---
import * as Icons from 'lucide-astro';

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = '', strokeWidth = 1.5 } = Astro.props;

// Resolve the icon dynamically from the lucide-astro package
const IconComponent = (Icons as any)[name] || Icons.HelpCircle;
---

<IconComponent class={className} stroke-width={strokeWidth} />
