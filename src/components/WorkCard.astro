---
interface Props {
  href: string;
  title: string;
  tagline: string;
  meta?: string;
  icon?: string;
  badge?: string;
  external?: boolean;
}

import Icon from './Icon.astro';

const { href, title, tagline, meta, icon, badge, external = false } = Astro.props;
---

<a
  href={href}
  class="glass-card group flex flex-col gap-4 p-6 no-underline focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-0)] outline-none"
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <!-- Header row -->
  <div class="flex items-start justify-between gap-3">
    {icon && (
      <div class="w-10 h-10 rounded-lg bg-sky-400/10 border border-sky-400/20 flex items-center justify-center flex-shrink-0">
        <Icon name={icon} class="w-5 h-5 text-sky-400" />
      </div>
    )}
    {badge && (
      <span class="badge badge-sky ml-auto text-[10px]">{badge}</span>
    )}
  </div>

  <!-- Body -->
  <div class="flex flex-col gap-1.5 flex-grow">
    <h3 class="text-[var(--text-primary)] font-semibold text-base leading-tight group-hover:text-sky-300 transition-colors duration-150">
      {title}
    </h3>
    <p class="text-[var(--text-muted)] text-sm leading-relaxed">{tagline}</p>
  </div>

  <!-- Footer -->
  <div class="flex items-center justify-between pt-3 border-t border-white/[0.06] mt-auto">
    {meta && <span class="text-[11px] text-[var(--text-faint)] font-medium">{meta}</span>}
    <span class="text-sky-400 text-sm font-medium flex items-center gap-1 ml-auto group-hover:gap-2 transition-all duration-150">
      {external ? 'Visit' : 'View'}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {external
          ? <><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></>
          : <><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></>
        }
      </svg>
    </span>
  </div>
</a>
