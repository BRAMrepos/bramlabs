---
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  tagline: string;
  meta?: string;
  icon: string;
  badge?: string;
  external?: boolean;
}

const { href, title, tagline, meta, icon, badge, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="group bg-surface border border-border rounded-xl p-6 flex flex-col gap-4 shadow-sm transition-transform duration-200 hover:translate-y-[-2px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <div class="flex items-start justify-between gap-3">
    <div class="w-10 h-10 rounded-lg bg-accent/5 border border-accent/15 flex items-center justify-center text-accent flex-shrink-0">
      <Icon name={icon} class="w-5 h-5 text-accent" />
    </div>
    {badge && (
      <span class="text-mono text-[10px] px-2.5 py-0.5 rounded-full bg-accent-muted text-accent font-semibold border border-accent/10">
        {badge}
      </span>
    )}
  </div>
  <div class="flex flex-col gap-2 flex-grow">
    <h3 class="text-h3 text-text group-hover:text-accent transition-colors">{title}</h3>
    <p class="text-small text-muted leading-relaxed">{tagline}</p>
  </div>
  <div class="flex items-center justify-between gap-3 pt-2 border-t border-border/60">
    {meta ? <span class="text-mono text-xs text-muted">{meta}</span> : <span></span>}
    <span class="text-accent text-sm font-medium flex items-center gap-1">
      {external ? 'Open' : 'View'}
      <Icon name="ArrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
