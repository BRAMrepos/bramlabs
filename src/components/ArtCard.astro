---
interface Props {
  title: string;
  series: string;
  description: string;
  productName?: string;
  productLink?: string;
  motif: string;
  palette: string[];
  dpi: number;
  format: string;
  color: string;
  notes: string;
  status: string;
  year: string;
}

const {
  title,
  series,
  description,
  productName,
  productLink,
  motif,
  palette,
  dpi,
  format,
  color,
  notes,
  status,
  year,
} = Astro.props;

const statusLabel = status === 'ready' ? 'Print-ready' : status === 'in-progress' ? 'In progress' : 'Archived';
const badgeStyle = status === 'ready' ? 'badge-emerald' : 'badge-amber';
---

<article class="glass-card flex flex-col overflow-hidden group">
  <!-- Visual artwork motif preview -->
  <div class="relative h-44 flex items-center justify-center overflow-hidden bg-[#09090b] border-b border-[var(--border-default)] p-6">
    <!-- Background grid & accent glow -->
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:12px_12px] opacity-40"></div>
    <div
      class="absolute w-32 h-32 rounded-full blur-2xl opacity-20 pointer-events-none"
      style={`background: ${palette[0] || '#3b82f6'};`}
    ></div>

    <!-- Vector Art Motif Display -->
    <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2 max-w-[200px]">
      <div
        class="w-16 h-16 rounded-2xl flex items-center justify-center border border-white/10 shadow-xl transition-transform duration-300 group-hover:scale-110"
        style={`background: linear-gradient(135deg, ${palette[0] || '#3b82f6'}, ${palette[1] || '#6366f1'});`}
      >
        <span class="text-white font-mono font-bold text-xl tracking-tighter">
          {title.split(' ').map(w => w[0]).join('').slice(0, 3)}
        </span>
      </div>
      <span class="text-[11px] font-mono font-medium text-white/80 truncate max-w-full">
        {motif}
      </span>
    </div>

    <!-- Series Tag -->
    <div class="absolute top-2.5 left-2.5 pointer-events-none">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-white/90 bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm border border-white/10">
        {series}
      </span>
    </div>

    <!-- Year Tag -->
    <div class="absolute top-2.5 right-2.5 pointer-events-none">
      <span class="text-[10px] font-mono text-white/70 bg-black/40 px-2 py-0.5 rounded">
        {year}
      </span>
    </div>
  </div>

  <!-- Color Palette Stripe Bar -->
  <div class="h-2 flex overflow-hidden border-b border-[var(--border-default)]">
    {palette.map((hex) => (
      <div
        class="flex-1 h-full transition-opacity hover:opacity-90"
        style={`background-color: ${hex};`}
        title={hex}
      />
    ))}
  </div>

  <div class="p-5 flex flex-col gap-3.5 flex-grow">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-bold text-[var(--text-primary)] leading-tight">{title}</h3>
        {productName && (
          <div class="mt-1 flex items-center gap-1.5 text-xs font-medium text-blue-400">
            <span>Apparel for:</span>
            {productLink ? (
              <a href={productLink} class="hover:underline font-semibold flex items-center gap-0.5">
                {productName} →
              </a>
            ) : (
              <span class="font-semibold">{productName}</span>
            )}
          </div>
        )}
      </div>
      <span class={`badge text-[10px] font-mono ${badgeStyle}`}>{statusLabel}</span>
    </div>

    <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{description}</p>

    <!-- Palette Swatches -->
    <div class="flex gap-2 flex-wrap items-center pt-1">
      {palette.map((hex) => (
        <span class="inline-flex items-center gap-1.5 text-[10px] font-mono text-[var(--text-secondary)]">
          <span
            class="w-3.5 h-3.5 rounded-full border border-white/20 flex-shrink-0 shadow-xs"
            style={`background-color: ${hex};`}
            title={hex}
          ></span>
          {hex}
        </span>
      ))}
    </div>

    <dl class="mt-auto pt-3 border-t border-[var(--border-default)] grid grid-cols-2 gap-2 text-xs">
      <div>
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">DPI</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{dpi}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Format</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{format}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Color Mode</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{color}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Print Notes</dt>
        <dd class="text-[var(--text-muted)] mt-0.5 leading-relaxed text-[11px]">{notes}</dd>
      </div>
    </dl>
  </div>
</article>
