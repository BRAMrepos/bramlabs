---
interface Props {
  title: string;
  series: string;
  description: string;
  productName?: string;
  productLink?: string;
  motif: string;
  palette: string[];
  dpi: number;
  format: string;
  color: string;
  notes: string;
  status: string;
  year: string;
}

const {
  title,
  series,
  description,
  productName,
  productLink,
  motif,
  palette,
  dpi,
  format,
  color,
  notes,
  status,
  year,
} = Astro.props;

const statusLabel = status === 'ready' ? 'Print-ready' : status === 'in-progress' ? 'In progress' : 'Archived';
const statusColor = status === 'ready' ? 'text-emerald-400' : status === 'in-progress' ? 'text-amber-400' : 'text-muted';
const monogram = (productName ?? title).slice(0, 2).toUpperCase();
---

<article class="bg-surface border border-border rounded-xl overflow-hidden shadow-sm flex flex-col transition-all duration-200 hover:translate-y-[-2px] hover:border-accent/30 hover:shadow-md">
  <!-- Colour palette preview bar - renders actual hex values -->
  <div class="relative h-36 flex overflow-hidden border-b border-border">
    {palette.length > 0
      ? palette.map((hex) => (
          <div
            class="flex-1 h-full"
            style={`background-color: ${hex};`}
            title={hex}
          />
        ))
      : (
          <div class="w-full h-full bg-dark-bg flex items-center justify-center">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,color-mix(in_srgb,var(--color-accent)_30%,transparent)_0%,transparent_55%)]"></div>
            <span class="relative font-heading font-bold text-2xl tracking-tight text-dark-text opacity-40">{monogram}</span>
          </div>
        )
    }
    <!-- Series label overlay -->
    {palette.length > 0 && (
      <div class="absolute inset-0 flex items-end p-3 pointer-events-none">
        <span class="text-[10px] font-mono uppercase tracking-widest text-white/70 bg-black/30 rounded px-1.5 py-0.5 backdrop-blur-sm">
          {series}
        </span>
      </div>
    )}
  </div>

  <div class="p-5 flex flex-col gap-3 flex-grow">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-text leading-tight">{title}</h3>
        <p class="text-mono text-[11px] text-muted mt-0.5">{year}</p>
      </div>
      <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
        <span class={`text-mono text-[10px] font-semibold ${statusColor}`}>{statusLabel}</span>
        {productLink ? (
          <a href={productLink} class="text-mono text-[10px] px-2 py-0.5 rounded-full border border-border text-muted hover:text-accent hover:border-accent/30 transition-colors">
            {productName ?? 'Product'}
          </a>
        ) : productName ? (
          <span class="text-mono text-[10px] px-2 py-0.5 rounded-full border border-border text-muted">{productName}</span>
        ) : null}
      </div>
    </div>

    <p class="text-sm text-muted leading-relaxed">{description}</p>
    <p class="text-xs text-muted"><span class="text-text font-medium">Motif:</span> {motif}</p>

    <!-- Palette swatches with actual hex colours -->
    <div class="flex gap-2 flex-wrap items-center">
      {palette.map((hex) => (
        <span class="inline-flex items-center gap-1.5 text-mono text-[11px] text-muted">
          <span
            class="w-3.5 h-3.5 rounded-full border border-border/60 flex-shrink-0"
            style={`background-color: ${hex};`}
            title={hex}
          ></span>
          {hex}
        </span>
      ))}
    </div>

    <dl class="mt-auto pt-3 border-t border-border grid grid-cols-2 gap-2 text-xs">
      <div>
        <dt class="text-mono text-muted uppercase tracking-wider text-[10px]">DPI</dt>
        <dd class="text-text font-medium mt-0.5">{dpi}</dd>
      </div>
      <div>
        <dt class="text-mono text-muted uppercase tracking-wider text-[10px]">Format</dt>
        <dd class="text-text font-medium mt-0.5">{format}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-mono text-muted uppercase tracking-wider text-[10px]">Color mode</dt>
        <dd class="text-text font-medium mt-0.5">{color}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-mono text-muted uppercase tracking-wider text-[10px]">Print notes</dt>
        <dd class="text-muted mt-0.5 leading-relaxed text-[11px]">{notes}</dd>
      </div>
    </dl>
  </div>
</article>
