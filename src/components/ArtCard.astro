---
interface Props {
  title: string;
  series: string;
  description: string;
  productName?: string;
  productLink?: string;
  motif: string;
  palette: string[];
  dpi: number;
  format: string;
  color: string;
  notes: string;
  status: string;
  year: string;
}

const {
  title,
  series,
  description,
  productName,
  productLink,
  motif,
  palette,
  dpi,
  format,
  color,
  notes,
  status,
  year,
} = Astro.props;

const statusLabel = status === 'ready' ? 'Print-ready' : status === 'in-progress' ? 'In progress' : 'Archived';
const badgeStyle = status === 'ready' ? 'badge-emerald' : 'badge-amber';
---

<article class="glass-card flex flex-col overflow-hidden">
  <!-- Colour palette stripe bar -->
  <div class="relative h-24 flex overflow-hidden border-b border-[var(--border-default)]">
    {palette.map((hex) => (
      <div
        class="flex-1 h-full transition-opacity hover:opacity-90"
        style={`background-color: ${hex};`}
        title={hex}
      />
    ))}
    <div class="absolute bottom-2 left-2 pointer-events-none">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-white/90 bg-black/50 px-2 py-0.5 rounded backdrop-blur-sm">
        {series}
      </span>
    </div>
  </div>

  <div class="p-5 flex flex-col gap-3.5 flex-grow">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-bold text-[var(--text-primary)] leading-tight">{title}</h3>
        <p class="text-[10px] font-mono text-[var(--text-muted)] mt-0.5">{year}</p>
      </div>
      <span class={`badge text-[10px] font-mono ${badgeStyle}`}>{statusLabel}</span>
    </div>

    <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{description}</p>
    <p class="text-xs text-[var(--text-muted)]"><strong class="text-[var(--text-primary)]">Motif:</strong> {motif}</p>

    <!-- Palette swatches -->
    <div class="flex gap-2 flex-wrap items-center pt-1">
      {palette.map((hex) => (
        <span class="inline-flex items-center gap-1.5 text-[10px] font-mono text-[var(--text-secondary)]">
          <span
            class="w-3 h-3 rounded-full border border-white/20 flex-shrink-0"
            style={`background-color: ${hex};`}
            title={hex}
          ></span>
          {hex}
        </span>
      ))}
    </div>

    <dl class="mt-auto pt-3 border-t border-[var(--border-default)] grid grid-cols-2 gap-2 text-xs">
      <div>
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">DPI</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{dpi}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Format</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{format}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Color mode</dt>
        <dd class="text-[var(--text-primary)] font-semibold mt-0.5">{color}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Print notes</dt>
        <dd class="text-[var(--text-muted)] mt-0.5 leading-relaxed text-[11px]">{notes}</dd>
      </div>
    </dl>
  </div>
</article>
