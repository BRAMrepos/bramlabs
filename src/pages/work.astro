---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');
const apps       = await getCollection('apps');
const web        = await getCollection('web');
const art        = await getCollection('art');

const filter = Astro.url.searchParams.get('type') ?? 'all';
---

<BaseLayout
  title="All Studio Work"
  description="Explore the complete BramLabs software portfolio — Amazon Appstore apps, Android utilities, Chrome extensions, web platforms, and Merch on Demand artwork."
>
  <section class="section-block pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-10 reveal" data-reveal>
        <span class="badge badge-sky text-xs font-mono mb-3">Complete Portfolio</span>
        <h1 class="mb-4">Studio Work</h1>
        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          All active products shipped and maintained under BramLabs across mobile, browser extensions, web infrastructure, and apparel art.
        </p>
      </div>

      <!-- Filter Bar -->
      <div class="flex flex-wrap gap-2 mb-12 reveal" data-reveal style="--reveal-delay:60ms">
        {[
          { id: 'all',        label: `All (${apps.length + extensions.length + web.length + art.length})` },
          { id: 'apps',       label: `Apps (${apps.length})` },
          { id: 'extensions', label: `Extensions (${extensions.length})` },
          { id: 'web',        label: `Web (${web.length})` },
          { id: 'art',        label: `Art & Merch (${art.length})` },
        ].map((item) => (
          <a
            href={item.id === 'all' ? '/work' : `/work?type=${item.id}`}
            class:list={[
              'filter-chip',
              filter === item.id ? 'active' : '',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Apps Section -->
      {(filter === 'all' || filter === 'apps') && (
        <div class="mb-14 reveal" data-reveal>
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-6">
            <h2 class="text-xl font-bold text-[var(--text-primary)]">
              Mobile Applications <span class="text-xs font-mono text-[var(--text-faint)] font-normal ml-2">({apps.length})</span>
            </h2>
            <a href="/apps" class="text-xs text-sky-400 font-semibold hover:underline">View Apps Page →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {apps.map((app) => (
              <WorkCard
                href="/apps"
                title={app.data.title}
                tagline={app.data.tagline}
                meta={`${app.data.platform} · ${app.data.category}`}
                icon={app.data.icon}
                badge={app.data.status === 'live' ? 'Live' : 'Coming Soon'}
              />
            ))}
          </div>
        </div>
      )}

      <!-- Extensions Section -->
      {(filter === 'all' || filter === 'extensions') && (
        <div class="mb-14 reveal" data-reveal>
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-6">
            <h2 class="text-xl font-bold text-[var(--text-primary)]">
              Chrome Extensions <span class="text-xs font-mono text-[var(--text-faint)] font-normal ml-2">({extensions.length})</span>
            </h2>
            <a href="/extensions" class="text-xs text-sky-400 font-semibold hover:underline">View Extensions Directory →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {extensions.map((ext) => (
              <WorkCard
                href={`/extensions/${ext.slug}`}
                title={ext.data.title}
                tagline={ext.data.tagline}
                meta={`v${ext.data.version} · Chrome`}
                icon={ext.data.icon}
                badge={ext.data.status === 'live' ? 'Live' : 'Coming Soon'}
              />
            ))}
          </div>
        </div>
      )}

      <!-- Web Section -->
      {(filter === 'all' || filter === 'web') && (
        <div class="mb-14 reveal" data-reveal>
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-6">
            <h2 class="text-xl font-bold text-[var(--text-primary)]">
              Web Applications <span class="text-xs font-mono text-[var(--text-faint)] font-normal ml-2">({web.length})</span>
            </h2>
            <a href="/web" class="text-xs text-sky-400 font-semibold hover:underline">View Web Page →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {web.map((project) => (
              <WorkCard
                href={project.data.url}
                title={project.data.title}
                tagline={project.data.tagline}
                meta={project.data.stack.slice(0, 3).join(' · ')}
                icon={project.data.icon}
                badge={project.data.status === 'live' ? 'Live' : 'Coming Soon'}
                external
              />
            ))}
          </div>
        </div>
      )}

      <!-- Art & Merch Section -->
      {(filter === 'all' || filter === 'art') && (
        <div class="mb-8 reveal" data-reveal>
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-6">
            <h2 class="text-xl font-bold text-[var(--text-primary)]">
              Art &amp; Merch Marks <span class="text-xs font-mono text-[var(--text-faint)] font-normal ml-2">({art.length})</span>
            </h2>
            <a href="/merch" class="text-xs text-sky-400 font-semibold hover:underline">View MBA Reference →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {art.map((piece) => (
              <WorkCard
                href="/merch"
                title={piece.data.title}
                tagline={piece.data.description}
                meta={`${piece.data.series} · ${piece.data.printSpecs.dpi} DPI`}
                icon="Palette"
                badge={piece.data.status === 'ready' ? 'Print-ready' : 'In progress'}
              />
            ))}
          </div>
        </div>
      )}

    </div>
  </section>
</BaseLayout>
