---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignCard from "@/components/DesignCard.astro";
import { getAllDesigns, getFeaturedDesigns } from "@/data/designs";

const designs = getAllDesigns();
const featured = getFeaturedDesigns();
const niches = [...new Set(designs.map((d) => d.category))];
---

<BaseLayout
  title="Merch Portfolio — BramLabs Original Apparel Graphics"
  description="Original BramLabs apparel graphics portfolio for marketplace review: in-house concepts, garment mockups, process documentation and print-ready masters prepared to Merch specifications."
  image="/mockups/rotation-dial-tee.jpg"
>
  <section class="section page-top">
    <div class="wrap">
      <header class="page-head">
        <p class="eyebrow">Merch portfolio</p>
        <h1 class="h-page">Original apparel graphics for marketplace review</h1>
        <p class="lede">
          BramLabs is an independent design practice. This page is the application
          portfolio for original apparel graphics — mockups, raw artwork and
          construction notes. There is no checkout on this site.
        </p>
      </header>

      <ul class="proof-bar" aria-label="Portfolio facts">
        <li>
          <strong>{designs.length}</strong>
          <span>Original designs</span>
        </li>
        <li>
          <strong>{niches.length}</strong>
          <span>Intentional niches</span>
        </li>
        <li>
          <strong>100%</strong>
          <span>In-house concepts</span>
        </li>
        <li>
          <strong>4500×5400</strong>
          <span>Print master spec</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section originality">
    <div class="wrap grid-two">
      <div>
        <h2 class="h-card">Originality statement</h2>
        <p class="body">
          Every graphic begins as a BramLabs concept. Artwork is drawn and
          constructed in-house as vector systems — not stock clipart, not licensed
          characters, not brand marks, and not slight variations of existing
          marketplace bestsellers.
        </p>
        <p class="body muted">
          Rejected directions (app-icon containers, trademark-adjacent motifs,
          literal clichés) are documented on design and process pages so the
          construction trail is visible.
        </p>
      </div>
      <div>
        <h2 class="h-card">Print readiness</h2>
        <ul class="checklist">
          <li>Print masters: 4500×5400 px, sRGB, transparent PNG</li>
          <li>Line weights and type tuned for chest-scale readability</li>
          <li>Web previews optimized separately from production files</li>
          <li>IP and marketplace-policy review before any listing submission</li>
          <li>Garment mockups show application, not a live store inventory</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="designs">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-section">Featured designs</h2>
        <p class="lede">
          Six highlights with garment application and raw artwork. Open any
          piece for concept notes, palette and rejected directions.
        </p>
      </div>
      <div class="design-grid">
        {featured.map((d) => <DesignCard design={d} />)}
      </div>
      <div class="section-cta">
        <a href="/collection/" class="btn -primary">View full collection</a>
        <a href="/process/" class="btn -ghost">Process case studies</a>
      </div>
    </div>
  </section>

  <section class="section niches">
    <div class="wrap">
      <h2 class="h-card">Niches in this collection</h2>
      <ul class="niche-list">
        {
          niches.map((n) => {
            const count = designs.filter((d) => d.category === n).length;
            return (
              <li>
                <span class="meta">{n}</span>
                <span class="count">{count} design{count === 1 ? "" : "s"}</span>
              </li>
            );
          })
        }
      </ul>
      <p class="body muted niche-note">
        Themes are intentional: shift work, developer culture, focus systems,
        audio and studio craft — not random slogan spam.
      </p>
    </div>
  </section>

  <section class="section index-section">
    <div class="wrap">
      <h2 class="h-card">Complete design index</h2>
      <ul class="index">
        {
          designs.map((d) => (
            <li>
              <a href={`/designs/${d.slug}/`}>
                <span class="meta">{String(d.order).padStart(2, "0")}</span>
                <span class="title">{d.title}</span>
                <span class="meta cat">{d.category}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section closer">
    <div class="wrap closer-inner">
      <div>
        <h2 class="h-card">Designer</h2>
        <p class="body">
          Designed by Bram, founder of BramLabs. Research, sketch, vector
          construction and print preparation happen in-house. For licensing or
          partnership inquiries only — this is not a retail cart.
        </p>
        <div class="closer-actions">
          <a href="/about/" class="btn -ghost">About the designer</a>
          <a href="/contact/" class="btn -link">Contact →</a>
        </div>
      </div>
      <div class="reviewer-box">
        <p class="eyebrow">For reviewers</p>
        <p class="body">
          Primary portfolio URL: this page or
          <a href="/collection/">/collection/</a>. Process proof:
          <a href="/process/">/process/</a>. Designer:
          <a href="/about/">/about/</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-top {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    margin-bottom: var(--s-6);
  }

  .proof-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: var(--s-4) 0;

    @media (width >= 720px) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    strong {
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    span {
      font-size: 0.875rem;
      color: var(--muted);
    }
  }

  .originality {
    background: var(--canvas);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .grid-two {
    display: grid;
    gap: var(--s-6);

    @media (width >= 900px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .grid-two .h-card {
    margin-bottom: 0.85rem;
  }

  .body.muted,
  .muted {
    color: var(--muted);
  }

  .body + .body {
    margin-top: 1rem;
  }

  .checklist {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.25rem;

    li {
      position: relative;
      padding-left: 1.15rem;
      color: var(--muted);
      font-size: 0.975rem;
      line-height: 1.55;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--ink);
      }
    }
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    max-width: 40rem;
  }

  .design-grid {
    display: grid;
    gap: var(--s-6) var(--s-5);
    grid-template-columns: 1fr;

    @media (width >= 720px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .section-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--s-5);
  }

  .niches {
    background: var(--canvas);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .niche-list {
    display: grid;
    gap: 0;
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);

    @media (width >= 640px) {
      grid-template-columns: 1fr 1fr;
    }

    li {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--line);
    }

    .count {
      font-size: 0.875rem;
      color: var(--muted);
    }
  }

  .niche-note {
    margin-top: 1.5rem;
    max-width: 36rem;
  }

  .index-section {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .index {
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);

    a {
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: 0.75rem 1rem;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;

      @media (width >= 640px) {
        grid-template-columns: 3rem 1fr auto;
      }

      &:hover .title {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
    }

    .title {
      font-weight: 500;
    }

    .cat {
      display: none;
      @media (width >= 640px) { display: inline; }
    }
  }

  .closer {
    background: var(--canvas);
    border-top: 1px solid var(--line);
  }

  .closer-inner {
    display: grid;
    gap: var(--s-5);

    @media (width >= 900px) {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
    }
  }

  .closer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .reviewer-box {
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);

    .eyebrow {
      margin-bottom: 0.65rem;
    }

    a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>
