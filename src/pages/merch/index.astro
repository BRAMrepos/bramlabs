---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ArtCard from '../../components/ArtCard.astro';
import { getCollection } from 'astro:content';

const art = (await getCollection('art')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "BramLabs Apparel & IP Art Portfolio",
  "url": "https://bramlabs.co/merch",
  "description": "Original print-ready apparel graphics designed by BramLabs Studio for our software IP and evergreen gift niches.",
  "isPartOf": {
    "@type": "Organization",
    "name": "BramLabs",
    "url": "https://bramlabs.co"
  }
};
---

<BaseLayout
  title="Apparel Art Portfolio"
  description="Original print-ready apparel graphics designed by BramLabs Studio for our software IP and evergreen gift niches."
  structuredData={structuredData}
>

  <!-- High contrast portfolio canvas wrapper -->
  <div class="bg-[#f8fafc] text-[#0f172a] min-h-screen">

    <!-- ========================================================
         HERO SECTION (2-Line Max + Artist Context)
         ======================================================== -->
    <section class="py-12 md:py-16 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl flex flex-col gap-3">
          
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Original apparel graphics by BramLabs.<br />
            <span class="text-blue-600">Designed in-house, print-ready at 300 DPI.</span>
          </h1>

          <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-medium pt-1">
            Active Amazon Appstore developer. Apparel designs created by BramLabs Lead Designer for our software IP and evergreen gift niches.
          </p>

          <!-- Artist Context Line -->
          <div class="flex items-center gap-3 pt-2 text-xs font-mono text-slate-500">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-200 text-slate-800 font-bold">
              <Icon name="User" class="w-3.5 h-3.5 text-blue-600" />
              Lead Artist: BramLabs Design Studio
            </span>
            <span>&bull;</span>
            <span>8+ Years Vector &amp; Print Production</span>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================================
         THE 10 APPAREL DESIGNS GRID (80% of Page)
         ======================================================== -->
    <section class="py-12 md:py-16 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
          <div>
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-blue-600 block mb-1">Portfolio</span>
            <h2 class="text-2xl font-bold text-slate-900">Featured Garment Collection (10 Designs)</h2>
            <p class="text-slate-600 text-sm mt-1">
              Click "View Vector Art" on any card to toggle between the apparel mockup and the 300 DPI transparent master.
            </p>
          </div>
          <span class="text-xs font-mono font-bold text-slate-500 bg-slate-200 px-3 py-1.5 rounded-lg flex-shrink-0">
            10 / 10 Print Ready
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {art.map((piece) => (
            <ArtCard
              title={piece.data.title}
              series={piece.data.series}
              description={piece.data.description}
              productName={piece.data.productName}
              productLink={piece.data.productLink}
              niche={piece.data.niche}
              inkSpec={piece.data.inkSpec}
              garmentType={piece.data.garmentType}
              motif={piece.data.motif}
              palette={piece.data.palette}
              dpi={piece.data.printSpecs.dpi}
              format={piece.data.printSpecs.format}
              color={piece.data.printSpecs.color}
              notes={piece.data.printSpecs.notes}
              status={piece.data.status}
              year={piece.data.year}
            />
          ))}
        </div>

      </div>
    </section>

    <!-- ========================================================
         PROCESS STRIP: 4 REAL DESIGN PIPELINE STAGES
         ======================================================== -->
    <section class="py-12 md:py-16 border-b border-slate-200 bg-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-xl mb-10">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-blue-600 block mb-1">Authentic Process</span>
          <h2 class="text-2xl font-bold text-slate-900">Design &amp; Print Production Pipeline</h2>
          <p class="text-slate-600 text-sm mt-1">Every apparel piece goes through a 4-step vector and print pre-flight process.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-3">
            <span class="text-xs font-mono font-bold text-blue-600">STAGE 01</span>
            <h3 class="text-base font-bold text-slate-900">Pencil &amp; Concept Sketch</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Initial composition sketch mapping text hierarchy, dial geometry, or signal wave layout.
            </p>
            <div class="mt-auto pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-400">
              Tooling: Paper &amp; Stylus
            </div>
          </div>

          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-3">
            <span class="text-xs font-mono font-bold text-blue-600">STAGE 02</span>
            <h3 class="text-base font-bold text-slate-900">Vector Nodes &amp; Paths</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Vector tracing in Illustrator. Precision Bezier curves, custom typography, and zero unwanted paths.
            </p>
            <div class="mt-auto pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-400">
              Tooling: Vector Editor
            </div>
          </div>

          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-3">
            <span class="text-xs font-mono font-bold text-blue-600">STAGE 03</span>
            <h3 class="text-base font-bold text-slate-900">Ink &amp; Color Separation</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Color separation into 1, 2, or 3 solid ink plates. Export at native 300 DPI (4500x5400 px transparent PNG).
            </p>
            <div class="mt-auto pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-400">
              Master: 300 DPI PNG
            </div>
          </div>

          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-3">
            <span class="text-xs font-mono font-bold text-blue-600">STAGE 04</span>
            <h3 class="text-base font-bold text-slate-900">Garment Print Mockup</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pre-flight mockup on dark tees, hoodies, and heather fleece to verify placement and contrast.
            </p>
            <div class="mt-auto pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-400">
              Pre-flight: Tee &amp; Hoodie
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================================
         ARTIST PROFILE & COMPLIANCE BLOCK (SINGLE INSTANCE)
         ======================================================== -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Artist Profile -->
          <div class="lg:col-span-6 bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-lg font-mono flex-shrink-0">
                BL
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900">BramLabs Lead Designer</h3>
                <span class="text-xs font-mono text-slate-500">Vector Artist &amp; Print Designer</span>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Experienced graphic designer specializing in minimalist vector line art, technical typography, and screen print apparel graphics. Designing apparel for BramLabs software IP and evergreen gift niches.
            </p>
          </div>

          <!-- Single Compliance Card (Four Lines Only) -->
          <div class="lg:col-span-6 bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-3">
            <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">Quality &amp; Compliance Guarantee</span>
            <h3 class="text-lg font-bold text-slate-900">Merch Technical Standards</h3>
            <ul class="flex flex-col gap-2.5 text-xs text-slate-600 font-mono pt-1">
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>300 DPI minimum resolution (4500x5400 px transparent PNG master)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>USPTO TESS trademark search executed per slogan and mark</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Pre-submission review against Merch Content Policy guidelines</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Strictly 100% original studio artwork — zero third-party IP or logos</span>
              </li>
            </ul>
          </div>

        </div>
      </div>
    </section>

  </div>

</BaseLayout>
