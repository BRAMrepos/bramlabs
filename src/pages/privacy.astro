---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy — BramLabs"
  description="How BramLabs handles personal information on bramlabs.co and related products."
>
  <section class="section">
    <div class="wrap prose">
      <h1 class="h-section">Privacy</h1>
      <p class="meta">Last updated: 1 January 2026</p>
      <p>
        BramLabs (“we”) operates bramlabs.co and related software products. This
        policy explains what information we collect and how we use it.
      </p>
      <h2>Information we collect</h2>
      <p>
        When you contact us we receive the information you choose to send (such as
        name, email and message content). Product-specific apps and extensions may
        process additional data described on their individual privacy pages.
      </p>
      <h2>How we use information</h2>
      <ul>
        <li>Respond to inquiries and support requests</li>
        <li>Operate and improve our websites and products</li>
        <li>Meet legal obligations</li>
      </ul>
      <h2>Sharing</h2>
      <p>
        We do not sell personal information. We may use infrastructure providers
        (hosting, email) who process data on our behalf under appropriate terms.
      </p>
      <h2>Contact</h2>
      <p>
        Questions: <a href="mailto:contact@bramlabs.co">contact@bramlabs.co</a>
      </p>
      <p>
        Product-specific policies:
        <a href="/apps/clearcue/privacy/">ClearCue</a>,
        <a href="/apps/shiftledger/privacy/">ShiftLedger</a>,
        <a href="/extensions/sonicshield/privacy/">SonicShield</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--muted);
    line-height: 1.7;
  }
  .prose h1 {
    color: var(--ink);
  }
  .prose h2 {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 500;
    margin-top: 1rem;
  }
  .prose ul {
    list-style: disc;
    padding-left: 1.2rem;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
