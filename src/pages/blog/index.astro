---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Developer Blog & Engineering Journal"
  description="Technical articles, privacy guides, and design system retrospectives from BramLabs."
>
  <section class="section-block pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="max-w-3xl mb-12 reveal" data-reveal>
        <span class="badge badge-sky text-xs font-mono mb-3">Engineering Journal</span>
        <h1 class="mb-4">Developer Blog</h1>
        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          Technical deep-dives on local-first privacy, browser extension architecture, Merch on Demand IP compliance, and software engineering.
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="flex flex-col gap-6 max-w-4xl">
        {sortedPosts.map((post, i) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
            <article
              class="glass-card p-8 flex flex-col gap-4 reveal"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <div class="flex items-center gap-3 text-xs font-mono text-[var(--text-faint)]">
                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                <span>·</span>
                <span>By {post.data.author}</span>
              </div>
              
              <h2 class="text-xl font-bold text-[var(--text-primary)] hover:text-sky-300 transition-colors">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              
              <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                {post.data.description}
              </p>

              <div class="flex flex-wrap gap-2 my-1">
                {post.data.tags.map((tag) => (
                  <span class="text-[11px] font-mono text-[var(--text-faint)] px-2.5 py-0.5 rounded-full border border-white/[0.08] bg-white/[0.03]">
                    #{tag}
                  </span>
                ))}
              </div>

              <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between mt-1">
                <a href={`/blog/${post.slug}`} class="text-sky-400 hover:text-sky-300 text-xs font-semibold flex items-center gap-1.5 transition-colors">
                  Read Full Article →
                </a>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>
