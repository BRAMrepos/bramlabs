---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Feedback | BramLabs",
  "description": "Send us your thoughts, bug reports, feature requests, or uninstallation feedback.",
  "url": "https://bramlabs.co/feedback"
};
---

<BaseLayout
  title="Share Your Feedback"
  description="Help us make BramLabs browser extensions better. Send us bug reports, feature suggestions, or general feedback."
  structuredData={structuredData}
>
  <section class="py-32 bg-bg flex items-center min-h-[75vh]">
    <div class="max-w-xl mx-auto px-6 w-full text-center">
      <!-- Back Link -->
      <a href="/" class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-8 uppercase tracking-wider">
        <Icon name="ArrowLeft" class="w-3.5 h-3.5" />
        Back to Home
      </a>

      <!-- Feedback Card -->
      <div class="bg-surface border border-border rounded-2xl p-8 md:p-10 shadow-md text-left transition-all duration-200" id="feedback-card">
        <!-- Uninstall Header (Shown if event=uninstall) -->
        <div id="header-uninstall" class="hidden flex-col gap-3 mb-8">
          <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500">
            <Icon name="Trash2" class="w-6 h-6" />
          </div>
          <h1 class="text-h2 text-text font-bold leading-tight">We're sorry to see you go!</h1>
          <p class="text-small text-muted leading-relaxed">
            Please help us improve by letting us know why you uninstalled <span id="app-name-display" class="font-semibold text-text">the extension</span>.
          </p>
        </div>

        <!-- General Header (Shown by default) -->
        <div id="header-general" class="flex flex-col gap-3 mb-8">
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent">
            <Icon name="MessageSquare" class="w-6 h-6 text-accent" />
          </div>
          <h1 class="text-h2 text-text font-bold leading-tight">Share your feedback</h1>
          <p class="text-small text-muted leading-relaxed">
            Have a suggestion, found a bug, or want to request a feature? Let us know what you think.
          </p>
        </div>

        <!-- Form -->
        <form id="feedback-form" class="flex flex-col gap-6">
          <input type="hidden" name="app" id="input-app" value="" />
          <input type="hidden" name="event" id="input-event" value="" />

          <!-- Reason (Uninstall Only) -->
          <div id="uninstall-reasons" class="hidden flex-col gap-2">
            <label class="text-mono text-xs font-bold text-text uppercase tracking-wider">Why did you uninstall? <span class="text-red-500">*</span></label>
            <div class="flex flex-col gap-2.5 mt-1.5">
              <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent hover:bg-accent/5 transition-all duration-150 cursor-pointer text-xs font-medium text-muted hover:text-text">
                <input type="radio" name="reason" value="not-working" class="mt-0.5 accent-accent" required />
                <span>It didn't work as expected / had bugs</span>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent hover:bg-accent/5 transition-all duration-150 cursor-pointer text-xs font-medium text-muted hover:text-text">
                <input type="radio" name="reason" value="alternative" class="mt-0.5 accent-accent" />
                <span>I found a better alternative extension</span>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent hover:bg-accent/5 transition-all duration-150 cursor-pointer text-xs font-medium text-muted hover:text-text">
                <input type="radio" name="reason" value="temporary" class="mt-0.5 accent-accent" />
                <span>I only needed it for a specific task / temporary use</span>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent hover:bg-accent/5 transition-all duration-150 cursor-pointer text-xs font-medium text-muted hover:text-text">
                <input type="radio" name="reason" value="slow" class="mt-0.5 accent-accent" />
                <span>It was slow or degraded browser performance</span>
              </label>
              <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent hover:bg-accent/5 transition-all duration-150 cursor-pointer text-xs font-medium text-muted hover:text-text">
                <input type="radio" name="reason" value="other" class="mt-0.5 accent-accent" />
                <span>Other reason (please clarify below)</span>
              </label>
            </div>
          </div>

          <!-- Category (General Only) -->
          <div id="general-categories" class="flex flex-col gap-2">
            <label for="category" class="text-mono text-xs font-bold text-text uppercase tracking-wider">Feedback Category <span class="text-red-500">*</span></label>
            <select
              id="category"
              name="category"
              class="w-full bg-surface border border-border rounded-lg px-4 py-3 text-sm text-text focus:outline-none focus:border-accent transition-colors duration-150 appearance-none cursor-pointer"
              required
            >
              <option value="feature">Feature Request</option>
              <option value="bug">Bug Report</option>
              <option value="inquiry">General Inquiry</option>
              <option value="partnership">Partnership Proposal</option>
            </select>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label id="message-label" for="message" class="text-mono text-xs font-bold text-text uppercase tracking-wider">Your Message <span class="text-red-500">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full bg-surface border border-border rounded-lg px-4 py-3 text-sm text-text placeholder-muted focus:outline-none focus:border-accent transition-colors duration-150 resize-none"
              placeholder="Tell us what's on your mind..."
              required
            ></textarea>
          </div>

          <!-- Contact Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="text-mono text-xs font-bold text-text uppercase tracking-wider">Email Address (Optional)</label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full bg-surface border border-border rounded-lg px-4 py-3 text-sm text-text placeholder-muted focus:outline-none focus:border-accent transition-colors duration-150"
              placeholder="your@email.com"
            />
            <p class="text-[10px] text-muted leading-relaxed">
              Provide your email if you'd like a response from our developer team.
            </p>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="bg-accent hover:bg-accent-hover text-white py-3.5 rounded-lg text-sm font-semibold transition-colors duration-150 shadow-sm text-center flex items-center justify-center gap-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer mt-2"
          >
            Submit Feedback
            <Icon name="Send" class="w-4 h-4 text-white" />
          </button>
        </form>

        <!-- Success Message (Hidden by default) -->
        <div id="success-message" class="hidden flex-col items-center text-center gap-5 py-8">
          <div class="w-16 h-16 rounded-full bg-green-500/10 border border-green-500/20 flex items-center justify-center text-green-500 mb-2">
            <Icon name="CheckCircle" class="w-8 h-8 text-green-500" />
          </div>
          <h2 class="text-h2 text-text font-bold">Feedback Submitted!</h2>
          <p class="text-small text-muted leading-relaxed max-w-sm">
            Thank you for helping us improve our tools. We read every submission and appreciate your help.
          </p>
          <a href="/" class="bg-surface border border-border hover:border-text text-text px-6 py-2.5 rounded-lg text-xs font-semibold transition-all duration-150 mt-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none">
            Return to Home
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Client side parameters parsing
  const params = new URLSearchParams(window.location.search);
  const app = params.get('app');
  const event = params.get('event');

  const headerUninstall = document.getElementById('header-uninstall');
  const headerGeneral = document.getElementById('header-general');
  const uninstallReasons = document.getElementById('uninstall-reasons');
  const generalCategories = document.getElementById('general-categories');
  const appNameDisplay = document.getElementById('app-name-display');
  const messageLabel = document.getElementById('message-label');
  const messageInput = document.getElementById('message');
  const inputApp = document.getElementById('input-app');
  const inputEvent = document.getElementById('input-event');

  // Format App Name
  const formatAppName = (slug) => {
    if (!slug) return 'the extension';
    if (slug.toLowerCase() === 'snapelite') return 'SnapElite';
    if (slug.toLowerCase() === 'sonicshield' || slug.toLowerCase() === 'sonic-shield') return 'SonicShield';
    if (slug.toLowerCase() === 'storypeek' || slug.toLowerCase() === 'story-peek') return 'StoryPeek';
    return slug.charAt(0).toUpperCase() + slug.slice(1);
  };

  // Populate hidden inputs
  if (app) inputApp.value = app;
  if (event) inputEvent.value = event;

  if (event === 'uninstall') {
    headerGeneral.classList.add('hidden');
    headerUninstall.classList.remove('hidden');
    uninstallReasons.classList.remove('hidden');
    generalCategories.classList.add('hidden');
    
    // Customize text
    appNameDisplay.innerText = formatAppName(app);
    messageLabel.innerHTML = 'Additional Comments (Optional)';
    messageInput.placeholder = 'Any details you can share helps us fix problems or build features you needed...';
    messageInput.removeAttribute('required');
  }

  // Handle Form Submission Mock
  const form = document.getElementById('feedback-form');
  const successMsg = document.getElementById('success-message');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Retrieve inputs for logging / debug
    const formData = new FormData(form);
    console.log('Feedback submitted:', Object.fromEntries(formData.entries()));

    // Slide up / transition
    form.classList.add('hidden');
    headerGeneral.classList.add('hidden');
    headerUninstall.classList.add('hidden');
    successMsg.classList.remove('hidden');
  });
</script>
