---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

const apps = await getCollection('apps');
---

<BaseLayout
  title="Apps"
  description="BramLabs on Amazon Appstore — original apps and games. Merch is designed for our own products only."
>
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl flex flex-col gap-4 mb-16">
        <span class="text-mono text-xs text-accent uppercase tracking-wider font-semibold">Amazon Appstore</span>
        <h1 class="text-h1 text-text">Apps &amp; games</h1>
        <p class="text-body text-muted">
          BramLabs is an active Amazon Appstore developer. We publish original software, then design apparel and branded goods for those products — not third-party IP.
        </p>
      </div>

      <div class="flex flex-col gap-10">
        {await Promise.all(apps.map(async (app) => {
          const { Content } = await render(app);
          return (
            <article class="bg-surface border border-border rounded-xl p-8 md:p-10 shadow-sm flex flex-col gap-8">
              <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent flex-shrink-0">
                    <Icon name={app.data.icon} class="w-6 h-6 text-accent" />
                  </div>
                  <div class="flex flex-col gap-2">
                    <h2 class="text-h2 text-text">{app.data.title}</h2>
                    <p class="text-body text-muted max-w-prose">{app.data.tagline}</p>
                    <div class="flex flex-wrap gap-2 pt-1">
                      <span class="text-mono text-[11px] px-2.5 py-0.5 rounded-full border border-border text-muted">{app.data.platform}</span>
                      <span class="text-mono text-[11px] px-2.5 py-0.5 rounded-full border border-border text-muted">{app.data.category}</span>
                      <span class="text-mono text-[11px] px-2.5 py-0.5 rounded-full bg-accent-muted text-accent border border-accent/10">
                        {app.data.status === 'live' ? 'Live' : app.data.status}
                      </span>
                    </div>
                  </div>
                </div>
                {app.data.storeUrl ? (
                  <a
                    href={app.data.storeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-accent hover:bg-accent-hover text-white py-3 px-6 rounded-lg font-medium transition-colors text-center text-sm flex-shrink-0 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 outline-none"
                  >
                    View on Appstore
                  </a>
                ) : (
                  <a
                    href="/merch"
                    class="border border-accent text-accent py-3 px-6 rounded-lg font-medium transition-colors text-center text-sm flex-shrink-0 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 outline-none"
                  >
                    Related merch →
                  </a>
                )}
              </div>

              <div class="prose prose-sm max-w-none text-muted [&_h2]:text-h3 [&_h2]:text-text [&_h2]:mt-6 [&_h2]:mb-3 [&_p]:mb-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-3 [&_li]:mb-1 [&_strong]:text-text">
                <Content />
              </div>
            </article>
          );
        }))}
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-border rounded-xl p-6 bg-surface shadow-sm">
          <Icon name="Puzzle" class="w-5 h-5 text-accent mb-3" />
          <h3 class="text-h3 text-text mb-2">Also shipping</h3>
          <p class="text-small text-muted mb-3">Browser extensions on the Chrome Web Store.</p>
          <a href="/extensions" class="text-accent text-sm font-medium hover:underline">Extensions →</a>
        </div>
        <div class="border border-border rounded-xl p-6 bg-surface shadow-sm">
          <Icon name="Globe" class="w-5 h-5 text-accent mb-3" />
          <h3 class="text-h3 text-text mb-2">Web products</h3>
          <p class="text-small text-muted mb-3">Production sites including WorkflowAI.site.</p>
          <a href="/web" class="text-accent text-sm font-medium hover:underline">Web →</a>
        </div>
        <div class="border border-border rounded-xl p-6 bg-surface shadow-sm">
          <Icon name="Shirt" class="w-5 h-5 text-accent mb-3" />
          <h3 class="text-h3 text-text mb-2">Merch for our IP</h3>
          <p class="text-small text-muted mb-3">Print-ready art and compliance process for MBA.</p>
          <a href="/merch" class="text-accent text-sm font-medium hover:underline">Merch →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
