---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

const apps = await getCollection('apps');
---

<BaseLayout
  title="Amazon Appstore & Mobile Applications"
  description="Original mobile apps published by BramLabs on the Amazon Appstore and Android platforms — ClearCue, ShiftWorkApp, Cadence, FocusPulse, and GridCraft."
>
  <section class="section-block pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-12 reveal" data-reveal>
        <span class="badge badge-sky text-xs font-mono mb-3">Amazon Appstore Developer</span>
        <h1 class="mb-4">Mobile &amp; Desktop Applications</h1>
        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          BramLabs builds original mobile software focused on personal focus, schedule management, daily habit tracking, and procedural audio synthesis. All apparel and merch designed for our apps carry 100% original studio artwork.
        </p>
      </div>

      <!-- Apps Directory -->
      <div class="flex flex-col gap-8 mb-16">
        {await Promise.all(apps.map(async (app, i) => {
          const { Content } = await render(app);
          return (
            <article
              class="glass-card p-8 md:p-10 flex flex-col gap-8 reveal"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-6 border-b border-white/[0.06]">
                <div class="flex items-start gap-4">
                  <div class="w-14 h-14 rounded-2xl bg-sky-400/10 border border-sky-400/20 flex items-center justify-center text-sky-400 flex-shrink-0">
                    <Icon name={app.data.icon} class="w-7 h-7 text-sky-400" />
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-3 flex-wrap">
                      <h2 class="text-xl font-bold text-[var(--text-primary)]">{app.data.title}</h2>
                      <span class={`badge text-[10px] font-mono ${app.data.status === 'live' ? 'badge-emerald' : 'badge-amber'}`}>
                        {app.data.status === 'live' ? 'Live' : app.data.status === 'in-review' ? 'Store Review' : 'Coming Soon'}
                      </span>
                    </div>
                    <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-2xl">{app.data.tagline}</p>
                    <div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px]">
                      <span class="px-2.5 py-0.5 rounded-full border border-white/[0.1] bg-white/[0.03] text-[var(--text-muted)]">{app.data.platform}</span>
                      <span class="px-2.5 py-0.5 rounded-full border border-white/[0.1] bg-white/[0.03] text-[var(--text-muted)]">{app.data.category}</span>
                      <span class="px-2.5 py-0.5 rounded-full border border-sky-400/20 bg-sky-400/10 text-sky-300">{app.data.year}</span>
                    </div>
                  </div>
                </div>

                {app.data.storeUrl ? (
                  <a
                    href={app.data.storeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary text-xs flex-shrink-0"
                  >
                    Appstore Listing →
                  </a>
                ) : (
                  <span class="text-xs font-mono text-[var(--text-faint)] px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.06] flex-shrink-0">
                    Release Pending
                  </span>
                )}
              </div>

              <!-- Markdown Article Content -->
              <div class="prose prose-invert prose-sm max-w-none text-[var(--text-secondary)] [&_h2]:text-base [&_h2]:font-bold [&_h2]:text-[var(--text-primary)] [&_h2]:mt-4 [&_h2]:mb-2 [&_p]:mb-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-3 [&_li]:mb-1 [&_strong]:text-[var(--text-primary)]">
                <Content />
              </div>
            </article>
          );
        }))}
      </div>

      <!-- Secondary Lanes Banner -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/extensions" class="glass-card p-6 flex flex-col gap-2 group">
          <Icon name="Puzzle" class="w-5 h-5 text-sky-400 mb-1" />
          <h3 class="text-base font-bold text-[var(--text-primary)] group-hover:text-sky-300 transition-colors">Browser Extensions</h3>
          <p class="text-xs text-[var(--text-muted)]">SonicShield, SnapElite, Tab Snoozer Chrome utilities.</p>
          <span class="text-sky-400 text-xs font-medium mt-2">Explore Extensions →</span>
        </a>
        <a href="/web" class="glass-card p-6 flex flex-col gap-2 group">
          <Icon name="Globe" class="w-5 h-5 text-sky-400 mb-1" />
          <h3 class="text-base font-bold text-[var(--text-primary)] group-hover:text-sky-300 transition-colors">Web Products</h3>
          <p class="text-xs text-[var(--text-muted)]">WorkflowAI.site, DesignTokens.dev platforms.</p>
          <span class="text-sky-400 text-xs font-medium mt-2">Explore Web Projects →</span>
        </a>
        <a href="/merch" class="glass-card p-6 flex flex-col gap-2 group">
          <Icon name="Shirt" class="w-5 h-5 text-sky-400 mb-1" />
          <h3 class="text-base font-bold text-[var(--text-primary)] group-hover:text-sky-300 transition-colors">Merch Portfolio</h3>
          <p class="text-xs text-[var(--text-muted)]">300 DPI original product marks and Amazon compliance notes.</p>
          <span class="text-sky-400 text-xs font-medium mt-2">View MBA Reference →</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
