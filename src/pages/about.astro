---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedSoftware } from "@/data/software";
import { getAllDesigns } from "@/data/designs";

const products = getPublishedSoftware();
const designs = getAllDesigns();
---

<BaseLayout
  title="About — BramLabs"
  description="BramLabs is an independent studio run by Bram, publishing small software products and original apparel graphics from one desk."
>
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <h1 class="h-page">About BramLabs</h1>
        <p class="lede">
          BramLabs is an independent studio run by Bram. It publishes
          {products.length} software products — shift and routine apps, browser
          utilities, and web tools — alongside {designs.length} original apparel
          graphics. Everything comes off one desk.
        </p>
      </header>

      <section id="designer" class="block designer-block">
        <h2 class="h-card">Designed by Bram</h2>
        <div class="designer">
          <figure class="portrait">
            <picture>
              <source srcset="/studio/workspace.webp" type="image/webp" />
              <img
                src="/studio/workspace.jpg"
                alt="BramLabs studio workspace with technical vector blueprints, fabric swatches and precision drafting tools"
                width="800"
                height="1000"
              />
            </picture>
            <figcaption class="meta">
              BramLabs Studio Workspace — Systems Design & Vector Craft
            </figcaption>
          </figure>
          <div class="bio">
            <p class="body">
              I’m Bram. I write the software, design the graphics, answer the
              support mail and keep the privacy policies current. There is no
              team behind this — when you email support, you get me.
            </p>
            <p class="body">
              The software side is deliberately small. Each product does one job
              for people whose working day does not fit a nine-to-five: rotating
              shifts, spoken routines, browser audio that will not behave. They
              run on your device wherever they can, because that is both simpler
              to build and less of your data to be responsible for.
            </p>
            <p class="body">
              Graphics come off the same desk. Every apparel concept is built
              in-house — domain research, raw sketches, vector geometry, colorway
              testing, then print preparation. Systems thinking, clear hierarchy
              and exact line weight carry across both mediums. If a design does
              not hold up as standalone art from across the room, it does not ship.
            </p>
            <p class="body">
              Vector artwork is constructed to 4500×5400 sRGB transparent master
              files. The public archive shows high-fidelity previews; the original
              vector files stay in the studio.
            </p>
          </div>
        </div>
      </section>

      <section class="block">
        <h2 class="h-card">Principles</h2>
        <ul class="principles">
          <li>
            <h3>Your data stays yours</h3>
            <p>
              The apps work on device wherever that is possible. Nothing is sold,
              no advertising trackers ship in any product, and the site itself
              sets no cookies.
            </p>
          </li>
          <li>
            <h3>Documented, not just listed</h3>
            <p>
              Every published product has a support page that answers real
              questions and a privacy policy that names what is collected, why,
              and for how long.
            </p>
          </li>
          <li>
            <h3>Original concepts</h3>
            <p>
              Every graphic begins with a BramLabs-created idea rather than stock
              artwork, licensed characters or copied branding.
            </p>
          </li>
          <li>
            <h3>Honest credentials</h3>
            <p>
              Software is listed publicly only when a real storefront URL exists.
              Support pages stay up for as long as anyone is still running the
              product.
            </p>
          </li>
        </ul>
      </section>

      <section class="block">
        <h2 class="h-card">Contact</h2>
        <p class="body">
          Studio inquiries: <a href="mailto:contact@bramlabs.co">contact@bramlabs.co</a
          ><br />
          Product support: <a href="mailto:support@bramlabs.co">support@bramlabs.co</a>
        </p>
        <p class="body meta-line">
          Bug reports and feature requests are best sent through the
          <a href="/feedback/">feedback form</a>, which routes by product.
          For anything else, use the <a href="/contact/">contact page</a>.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-head {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .block {
    margin-bottom: 3.5rem;
  }
  .designer {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
    @media (width >= 900px) {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }
  .portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--canvas);
    img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
    figcaption {
      padding: 0.75rem 1rem;
      border-top: 1px solid var(--line);
    }
  }
  .bio .body + .body {
    margin-top: 1rem;
    color: var(--muted);
  }
  .principles {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
    @media (width >= 800px) {
      grid-template-columns: 1fr 1fr;
    }
    li {
      border-top: 1px solid var(--line);
      padding-top: 1rem;
    }
    h3 {
      font-size: 1.05rem;
      font-weight: 500;
      margin-bottom: 0.4rem;
    }
    p {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
  }
  .meta-line {
    margin-top: 1rem;
    font-size: 0.95rem;
    a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
  .body a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
