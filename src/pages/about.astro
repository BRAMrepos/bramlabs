---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About BramLabs Studio",
  "url": "https://bramlabs.co/about",
  "mainEntity": {
    "@type": "Organization",
    "name": "BramLabs",
    "url": "https://bramlabs.co",
    "email": "support@bramlabs.co",
    "description": "Independent product studio building mobile apps, browser extensions, web platforms, and original brand merchandise for our own IP."
  }
};
---

<BaseLayout
  title="About BramLabs Studio"
  description="BramLabs is an independent software product studio shipping Amazon Appstore apps, Chrome extensions, production web platforms, and original merch for our own IP."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="section-block pt-16 md:pt-24 border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-400/10 border border-sky-400/20 text-sky-400 text-xs font-mono font-semibold w-fit">
          <Icon name="Smartphone" class="w-3.5 h-3.5" />
          Independent Product Studio &amp; Appstore Developer
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] leading-[1.1]">
          We build focused software tools<br />
          <span class="text-gradient">and design original apparel IP.</span>
        </h1>

        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          BramLabs is an independent software studio founded on a clear mission: engineer low-friction utility software across mobile and browser platforms, and produce official print merchandise strictly for <strong class="text-[var(--text-primary)] font-semibold">our own software titles and studio IP</strong>.
        </p>

        <!-- Studio Quick Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 font-mono text-xs text-[var(--text-secondary)]">
          <div class="glass-card p-4 flex flex-col gap-1">
            <span class="text-[var(--text-muted)] text-[10px] uppercase font-bold">Appstore Status</span>
            <span class="text-[var(--text-primary)] font-bold text-sm">Active Developer</span>
          </div>
          <div class="glass-card p-4 flex flex-col gap-1">
            <span class="text-[var(--text-muted)] text-[10px] uppercase font-bold">Live Apps</span>
            <span class="text-[var(--text-primary)] font-bold text-sm">ClearCue &amp; ShiftLedger</span>
          </div>
          <div class="glass-card p-4 flex flex-col gap-1">
            <span class="text-[var(--text-muted)] text-[10px] uppercase font-bold">Chrome Store</span>
            <span class="text-[var(--text-primary)] font-bold text-sm">SonicShield Live</span>
          </div>
          <div class="glass-card p-4 flex flex-col gap-1">
            <span class="text-[var(--text-muted)] text-[10px] uppercase font-bold">IP Policy</span>
            <span class="text-emerald-400 font-bold text-sm">100% Original</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio Ethos & Software Craftsmanship -->
  <section class="section-block border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mb-12">
        <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold block mb-1">Foundational Vision</span>
        <h2 class="text-[var(--text-primary)] mb-2">Software Craftsmanship</h2>
        <p class="text-[var(--text-secondary)] text-sm">How we approach product design, performance, and user privacy.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-7 flex flex-col gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-500 mb-1">
            <Icon name="Zap" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)]">01. Local-First &amp; Fast</h3>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Our applications execute directly on the user's device without requiring background telemetry or continuous server handshakes. Fast first-paints and lightweight memory footprints are non-negotiable.
          </p>
        </div>

        <div class="glass-card p-7 flex flex-col gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-500 mb-1">
            <Icon name="Lock" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)]">02. Zero Paywall Bloat</h3>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Every product features full transparent privacy documentation, zero dark patterns, and simple core utilities that work straight out of the box.
          </p>
        </div>

        <div class="glass-card p-7 flex flex-col gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 mb-1">
            <Icon name="ShieldCheck" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)]">03. In-House Apparel IP</h3>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            We design print-ready vector artwork to complement our software titles. Every shirt and hoodie graphic originates from studio vector masters — zero third-party brands or copyrighted material.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Developer Credibility & Policy Compliance -->
  <section class="section-block border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="glass-card p-8 flex flex-col gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-400/10 border border-emerald-400/20 flex items-center justify-center text-emerald-400 mb-2">
            <Icon name="Target" class="w-5 h-5" />
          </div>
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Publisher Standards</h2>
          <ul class="flex flex-col gap-3 text-xs sm:text-sm text-[var(--text-muted)]">
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Publish verified Android/Fire OS applications to the Amazon Appstore</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Maintain active Chrome Web Store extension listings with Manifest V3 security</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Operate production web platforms like WorkflowAI.site and BramLabs Publisher Hub</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Maintain dedicated per-product terms, privacy statements, and changelogs</span>
            </li>
          </ul>
        </div>

        <div class="glass-card p-8 flex flex-col gap-4">
          <div class="w-10 h-10 rounded-lg bg-sky-400/10 border border-sky-400/20 flex items-center justify-center text-sky-400 mb-2">
            <Icon name="ShieldCheck" class="w-5 h-5" />
          </div>
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Merch on Demand Compliance</h2>
          <ul class="flex flex-col gap-3 text-xs sm:text-sm text-[var(--text-muted)]">
            <li class="flex items-center gap-2.5">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Strictly zero third-party brands, sports logos, or copyrighted characters</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-sky-400 font-bold">✓</span>
              <span>300 DPI native resolution working files (4500x5400 px transparent PNG)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Pre-flight USPTO trademark search before submitting print designs</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Pre-submission line-by-line review against Merch Content Policy</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Four Disciplines Navigation -->
  <section class="section-block border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mb-10">
        <span class="text-[11px] font-mono uppercase tracking-widest text-sky-400 font-semibold block mb-1">Directory</span>
        <h2 class="text-[var(--text-primary)]">Explore Studio Lanes</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { href: '/apps',       icon: 'Smartphone', title: 'Mobile Apps',  desc: 'Amazon Appstore developer titles — ClearCue and ShiftLedger.' },
          { href: '/extensions', icon: 'Puzzle',     title: 'Extensions',   desc: 'SonicShield, SnapElite, and Tab Snoozer Chrome utilities.' },
          { href: '/web',        icon: 'Globe',      title: 'Web Platforms', desc: 'WorkflowAI.site and BramLabs Publisher Platform.' },
          { href: '/merch',      icon: 'Shirt',      title: 'Apparel & Art', desc: '300 DPI print-ready vector series and compliance reference.' },
        ].map((lane) => (
          <a
            href={lane.href}
            class="glass-card p-6 flex flex-col gap-3 group"
          >
            <div class="w-10 h-10 rounded-lg bg-sky-400/10 border border-sky-400/20 flex items-center justify-center">
              <Icon name={lane.icon} class="w-5 h-5 text-sky-400" />
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] group-hover:text-sky-300 transition-colors">{lane.title}</h3>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">{lane.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Studio Contact Reference -->
  <section class="section-block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 md:p-12 max-w-2xl">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-bold mb-1 block">Developer Contact</span>
        <h2 class="text-[var(--text-primary)] mb-3">Studio Contact &amp; Support</h2>
        <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4">
          For technical support, store reviewer inquiries, or Merch on Demand developer verification:
        </p>
        <a href="mailto:support@bramlabs.co" class="text-sky-400 hover:underline font-bold text-xl block mb-6">
          support@bramlabs.co
        </a>
        <div class="text-xs text-[var(--text-faint)] flex items-center gap-4 pt-4 border-t border-[var(--border-subtle)] font-mono">
          <a href="/privacy" class="hover:text-[var(--text-muted)] transition-colors">Privacy Policy</a> · 
          <a href="/terms" class="hover:text-[var(--text-muted)] transition-colors">Terms of Service</a> · 
          <a href="/merch" class="hover:text-[var(--text-muted)] transition-colors">MBA Reference</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
