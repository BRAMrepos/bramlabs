---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About BramLabs",
  "url": "https://bramlabs.co/about",
  "mainEntity": {
    "@type": "Organization",
    "name": "BramLabs",
    "url": "https://bramlabs.co",
    "email": "support@bramlabs.co",
    "description": "Indie product studio building apps, browser extensions, web products, and original merchandise."
  }
};
---

<BaseLayout
  title="About"
  description="BramLabs is an indie product studio: Amazon Appstore apps, Chrome extensions, web products, and original merch for our own IP."
  structuredData={structuredData}
>
  <section class="py-20 border-b border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl flex flex-col gap-6">
        <span class="text-mono text-xs text-accent uppercase tracking-wider font-semibold">About</span>
        <h1 class="text-h1 text-text">BramLabs is a product studio</h1>
        <p class="text-body text-muted leading-relaxed">
          We build small, focused software — apps on Amazon Appstore, utilities on the Chrome Web Store, and web products like WorkflowAI.site — then design original merchandise that belongs to those products.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-surface border border-border rounded-xl p-8 flex flex-col gap-4 shadow-sm">
          <Icon name="Target" class="w-5 h-5 text-accent" />
          <h2 class="text-h3 text-text">What we optimize for</h2>
          <ul class="flex flex-col gap-3 text-small text-muted">
            <li class="flex gap-2"><Icon name="Check" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Ship real listings users can install</li>
            <li class="flex gap-2"><Icon name="Check" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Keep tools local-first where it matters</li>
            <li class="flex gap-2"><Icon name="Check" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Own our brand marks end to end</li>
            <li class="flex gap-2"><Icon name="Check" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Document support, privacy, and terms per product</li>
          </ul>
        </div>
        <div class="bg-surface border border-border rounded-xl p-8 flex flex-col gap-4 shadow-sm">
          <Icon name="Ban" class="w-5 h-5 text-accent" />
          <h2 class="text-h3 text-text">What we do not do</h2>
          <ul class="flex flex-col gap-3 text-small text-muted">
            <li class="flex gap-2"><Icon name="X" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Sell third-party brand or character merch</li>
            <li class="flex gap-2"><Icon name="X" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Ship extensions that phone home without reason</li>
            <li class="flex gap-2"><Icon name="X" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Publish art we cannot defend as original</li>
            <li class="flex gap-2"><Icon name="X" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />Skip trademark or Content Policy review</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 border-b border-border bg-surface">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h2 text-text mb-10">Studio lanes</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { href: '/apps', icon: 'Smartphone', title: 'Apps', body: 'Amazon Appstore developer account and original titles.' },
          { href: '/extensions', icon: 'Puzzle', title: 'Extensions', body: 'StoryPeek, SnapElite, SonicShield — Chrome utilities.' },
          { href: '/web', icon: 'Globe', title: 'Web', body: 'WorkflowAI.site and this publisher platform.' },
          { href: '/merch', icon: 'Shirt', title: 'Art & Merch', body: '300 DPI originals for our products only.' },
        ].map((lane) => (
          <a href={lane.href} class="bg-bg border border-border rounded-xl p-6 flex flex-col gap-3 shadow-sm transition-transform duration-200 hover:translate-y-[-2px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <Icon name={lane.icon} class="w-5 h-5 text-accent" />
            <h3 class="text-h3 text-text">{lane.title}</h3>
            <p class="text-small text-muted leading-relaxed">{lane.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl flex flex-col gap-4">
        <h2 class="text-h2 text-text">Contact</h2>
        <p class="text-body text-muted">
          Support, partnerships, or Merch by Amazon verification:
        </p>
        <a href="mailto:support@bramlabs.co" class="text-accent font-medium hover:underline text-lg">support@bramlabs.co</a>
        <p class="text-small text-muted pt-4">
          Legal: <a href="/privacy" class="text-accent hover:underline">Privacy</a> · <a href="/terms" class="text-accent hover:underline">Terms</a> · <a href="/feedback" class="text-accent hover:underline">Feedback</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
