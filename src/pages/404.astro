---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — BramLabs" description="Page not found." noindex>
  <section class="section">
    <div class="wrap center">
      <p class="meta">404</p>
      <h1 class="h-page">Page not found</h1>
      <p class="lede">The page may have moved. Try the collection or studio.</p>
      <div class="actions">
        <a href="/" class="btn -primary">Home</a>
        <a href="/collection/" class="btn -ghost">Collection</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .center {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
