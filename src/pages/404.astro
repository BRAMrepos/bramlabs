---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — BramLabs"
  description="That page does not exist on bramlabs.co. Links to the software products, the apparel collection, and support are below."
  noindex
>
  <section class="section">
    <div class="wrap center">
      <p class="meta">404</p>
      <h1 class="h-page">Page not found</h1>
      <p class="lede">
        This page has moved or never existed. If you followed a link from an app
        store listing, the product pages below have the support and privacy
        documents you are looking for.
      </p>
      <div class="actions">
        <a href="/software/" class="btn -primary">Software</a>
        <a href="/collection/" class="btn -ghost">Apparel</a>
        <a href="/feedback/" class="btn -ghost">Report a broken link</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .center {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
