---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { journalPosts } from "@/data/journal";

const featuredPost = journalPosts[0];
const remainingPosts = journalPosts.slice(1);
---

<BaseLayout
  title="Journal — BramLabs Studio Writing & Essays"
  description="Process notes, design research, technical decisions, and apparel craft by Bram."
>
  <section class="section py-10 md:py-16">
    <div class="wrap">
      
      <!-- Page Header -->
      <header class="page-head">
        <p class="eyebrow">Studio Writing &amp; Essays</p>
        <h1 class="h-page">Journal</h1>
        <p class="lede">
          Process notes, design research, technical decisions, and apparel craft by Bram.
        </p>
      </header>

      <!-- Featured Post Block -->
      {featuredPost && (
        <article class="featured-block">
          <a href={`/journal/${featuredPost.slug}/`} class="featured-media" aria-label={featuredPost.title}>
            <div class="media-container">
              <img
                src={featuredPost.image}
                alt={featuredPost.title}
                width="600"
                height="375"
                loading="eager"
              />
              <span class="media-badge">FEATURED ESSAY</span>
            </div>
          </a>

          <div class="featured-text">
            <div class="meta-row">
              <span class="category">{featuredPost.category}</span>
              <span class="dot">•</span>
              <span class="date">{featuredPost.dateLabel}</span>
              <span class="dot">•</span>
              <span class="read-time">{featuredPost.readTime}</span>
            </div>

            <h2 class="featured-title">
              <a href={`/journal/${featuredPost.slug}/`}>{featuredPost.title}</a>
            </h2>

            <p class="excerpt">{featuredPost.excerpt}</p>

            <div class="featured-actions">
              <a href={`/journal/${featuredPost.slug}/`} class="btn -primary">Read Article →</a>
            </div>
          </div>
        </article>
      )}

      <!-- Grid Header -->
      <div class="grid-header">
        <h2 class="h-section">Recent Essays</h2>
      </div>

      <!-- Journal Grid (Remaining 5 Posts) -->
      <div class="journal-grid">
        {
          remainingPosts.map((p) => (
            <article class="journal-card">
              <a href={`/journal/${p.slug}/`} class="card-img-link" aria-label={p.title}>
                <div class="card-img-wrap">
                  <img
                    src={p.image}
                    alt={`${p.title} article illustration`}
                    width="400"
                    height="250"
                    loading="lazy"
                  />
                </div>
              </a>
              <div class="card-content">
                <div class="card-meta">
                  <span class="category-badge">{p.category}</span>
                  <span class="date-label">{p.dateLabel}</span>
                </div>
                <h3 class="h-card">
                  <a href={`/journal/${p.slug}/`}>{p.title}</a>
                </h3>
                <p class="excerpt">{p.excerpt}</p>
                <div class="card-footer">
                  <span class="byline">By {p.byline}</span>
                  <a href={`/journal/${p.slug}/`} class="read-more">Read →</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    max-width: 42rem;
  }

  .h-page {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* Featured Post Layout */
  .featured-block {
    display: grid;
    gap: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 4rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);

    @media (width >= 840px) {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      padding: 2rem;
    }
  }

  .featured-media {
    display: block;
    background: #09090b;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    width: 100%;
  }

  .media-container {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    max-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: #09090b;
    overflow: hidden;

    img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .media-badge {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.675rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.5rem;
      background: var(--cyan);
      color: #09090b;
      border-radius: 4px;
    }
  }

  .featured-text {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--muted);

    .category {
      color: var(--accent);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .dot {
      color: var(--line);
    }
  }

  .featured-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.25;

    a {
      color: var(--ink);
      transition: color 200ms var(--ease);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .excerpt {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .featured-actions {
    margin-top: 0.5rem;
  }

  /* Grid Header */
  .grid-header {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);

    .h-section {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      font-weight: 700;
    }
  }

  /* Journal Grid */
  .journal-grid {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .journal-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t) var(--ease), transform var(--t) var(--ease);

    &:hover {
      box-shadow: var(--shadow-lift);
      transform: translateY(-2px);

      .h-card a {
        color: var(--accent);
      }
    }
  }

  .card-img-link {
    display: block;
    background: #09090b;
    border-bottom: 1px solid var(--line);
    width: 100%;
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    max-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: #09090b;
    overflow: hidden;

    img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .category-badge {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
  }

  .date-label {
    color: var(--muted);
  }

  .h-card {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;

    a {
      color: var(--ink);
      transition: color 200ms var(--ease);
    }
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    margin-top: auto;
    font-size: 0.85rem;
  }

  .byline {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .read-more {
    font-weight: 600;
    color: var(--accent);

    &:hover {
      text-decoration: underline;
    }
  }
</style>
