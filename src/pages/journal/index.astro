---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { journalPosts } from "@/data/journal";
---

<BaseLayout
  title="Journal — BramLabs"
  description="Process notes, studio writing and apparel development from BramLabs."
>
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <h1 class="h-section">Journal</h1>
        <p class="lede">Process, studio and apparel writing by Bram.</p>
      </header>
      <div class="grid">
        {
          journalPosts.map((p) => (
            <article>
              <a href={`/journal/${p.slug}/`} class="card">
                <img src={p.image} alt="" width="800" height="800" loading="lazy" />
                <p class="meta">
                  {p.dateLabel} · {p.category}
                </p>
                <h2 class="h-card">{p.title}</h2>
                <p class="body">{p.excerpt}</p>
                <p class="meta">By {p.byline}</p>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    max-width: 36rem;
  }
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (width >= 800px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .card img {
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--canvas);
  }
</style>
