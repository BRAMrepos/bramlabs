---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { journalPosts } from "@/data/journal";
---

<BaseLayout
  title="Journal — BramLabs"
  description="Process notes, studio writing and apparel development from BramLabs."
>
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <p class="eyebrow">Studio Writing & Essays</p>
        <h1 class="h-page">Journal</h1>
        <p class="lede">
          Process notes, design research, technical decisions, and apparel craft by Bram.
        </p>
      </header>

      <div class="journal-grid">
        {
          journalPosts.map((p) => (
            <article class="journal-card">
              <a href={`/journal/${p.slug}/`} class="card-img-link" aria-label={p.title}>
                <div class="card-img-wrap">
                  <img
                    src={p.image}
                    alt={`${p.title} article illustration`}
                    width="800"
                    height="800"
                    loading="lazy"
                  />
                </div>
              </a>
              <div class="card-content">
                <div class="card-meta">
                  <span class="category-badge">{p.category}</span>
                  <span class="date-label">{p.dateLabel}</span>
                </div>
                <h2 class="h-card">
                  <a href={`/journal/${p.slug}/`}>{p.title}</a>
                </h2>
                <p class="excerpt">{p.excerpt}</p>
                <div class="card-footer">
                  <span class="byline">By {p.byline}</span>
                  <a href={`/journal/${p.slug}/`} class="read-more">Read article →</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
    max-width: 40rem;
  }

  .h-page {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .lede {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .journal-grid {
    display: grid;
    gap: 2rem;

    @media (width >= 680px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .journal-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--t) var(--ease),
      transform var(--t) var(--ease);

    &:hover {
      box-shadow: var(--shadow-lift);
      transform: translateY(-2px);

      .card-img-wrap img {
        transform: scale(1.03);
      }

      .h-card a {
        color: var(--accent);
      }
    }
  }

  .card-img-link {
    display: block;
    overflow: hidden;
    background: var(--canvas);
    border-bottom: 1px solid var(--line);
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 400ms var(--ease);
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .category-badge {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 600;
  }

  .date-label {
    color: var(--muted);
  }

  .h-card {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;

    a {
      color: var(--ink);
      transition: color 200ms var(--ease);
    }
  }

  .excerpt {
    font-size: 0.925rem;
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .byline {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .read-more {
    font-weight: 500;
    color: var(--accent);
    &:hover {
      text-decoration: underline;
    }
  }
</style>
