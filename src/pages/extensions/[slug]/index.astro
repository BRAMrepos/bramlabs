---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
const { Content } = await ext.render();

// Setup SoftwareApplication schema for Google search rich snippet
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": ext.data.title,
  "operatingSystem": "Chrome, Firefox, Edge, Safari",
  "applicationCategory": "BrowserApplication",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "84"
  },
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title={ext.data.title}
  description={ext.data.tagline}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="py-32 bg-bg border-b border-border">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left: Extension info -->
      <div class="lg:col-span-7 flex flex-col items-start gap-6 text-left">
        <!-- Back Link -->
        <a href="/extensions" class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-2 uppercase tracking-wider">
          <Icon name="ArrowLeft" class="w-3.5 h-3.5" />
          Back to Directory
        </a>
        
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center text-white shadow-sm">
            <Icon name={ext.data.icon} class="w-9 h-9 text-white" />
          </div>
          <div>
            <h1 class="text-h1 text-text leading-tight">
              {ext.data.title}
            </h1>
            <p class="text-mono text-xs text-muted mt-1">
              Version {ext.data.version} &bull; Updated {ext.data.lastUpdated}
            </p>
          </div>
        </div>

        <p class="text-body text-muted max-w-prose">
          {ext.data.tagline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-2.5 w-full sm:w-auto mt-2">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
            <a
              href={ext.data.storeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent hover:bg-accent-hover text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 shadow-sm text-center flex items-center justify-center gap-2 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Add to Chrome (Free)
              <Icon name="ArrowUpRight" class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
            <a
              href={`/extensions/${slug}/privacy`}
              class="border border-border bg-surface text-text hover:border-text px-6 py-3.5 rounded-lg font-semibold transition-all duration-150 text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Privacy Policy
            </a>
          </div>
          <p class="text-[11px] text-muted text-left mt-1">
            Free to install &bull; Pro upgrade available for advanced features
          </p>
        </div>

        <!-- Meta badges -->
        <div class="flex flex-wrap items-center gap-6 mt-4 text-mono text-xs text-muted">
          <div class="flex items-center gap-1.5">
            <Icon name="Download" class="w-4 h-4 text-accent" />
            <span>{ext.data.downloadCount}</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <Icon name="Shield" class="w-4 h-4 text-green-600" />
            <span>GDPR Compliant</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <Icon name="Github" class="w-4 h-4 text-text" />
            <span>Open Source</span>
          </div>
        </div>
      </div>

      <!-- Right: Real Toolbar/Popup UI rendered in CSS -->
      <div class="lg:col-span-5 flex justify-center w-full">
        <div class="w-full max-w-sm bg-surface rounded-xl border border-border shadow-sm overflow-hidden flex flex-col transition-all duration-200">
          <!-- Window Header -->
          <div class="bg-surface-2 px-4 py-3 border-b border-border flex items-center justify-between">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></span>
            </div>
            <!-- Mock URL bar -->
            <div class="bg-surface border border-border rounded-md px-3 py-0.5 text-mono text-xs text-muted w-40 text-center truncate select-none">
              {slug === 'tab-snoozer' ? 'github.com/BRAMrepos/bramlabs' : 'instagram.com'}
            </div>
            <!-- Mock extension icon in toolbar -->
            <div class="w-10 flex justify-end">
              <span class="w-5 h-5 rounded bg-accent flex items-center justify-center text-xs text-white">
                <Icon name={ext.data.icon} class="w-3.5 h-3.5 text-white" />
              </span>
            </div>
          </div>

          <!-- Popup Content -->
          <div class={slug === 'tab-snoozer' ? "p-6 bg-surface min-h-[320px] flex flex-col justify-between text-left" : "bg-surface min-h-[320px] flex flex-col justify-between text-left"}>
            <!-- Render custom popup based on the extension -->
            {slug === 'tab-snoozer' ? (
              <div class="flex flex-col gap-5 flex-grow">
                <!-- Popup Header -->
                <div class="flex items-center gap-3 border-b border-border pb-3">
                  <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center text-white text-sm font-bold">TS</div>
                  <div>
                    <h4 class="font-heading font-semibold text-text text-sm">Tab Snoozer</h4>
                    <p class="text-xs text-muted">Snooze active tab</p>
                  </div>
                </div>
                <!-- Snooze presets -->
                <div class="flex flex-col gap-2">
                  <span class="text-mono text-[10px] font-bold text-muted uppercase tracking-wider">Presets</span>
                  <div class="grid grid-cols-1 gap-2">
                    <button class="flex items-center justify-between border border-border hover:border-accent hover:bg-accent/5 rounded-lg p-2.5 text-xs text-left transition-colors font-medium">
                      <span class="flex items-center gap-2"><Icon name="Clock" class="w-4 h-4 text-accent" /> Later Today</span>
                      <span class="text-muted font-mono text-[10px]">In 3 hours</span>
                    </button>
                    <button class="flex items-center justify-between border border-border hover:border-accent hover:bg-accent/5 rounded-lg p-2.5 text-xs text-left transition-colors font-medium">
                      <span class="flex items-center gap-2"><Icon name="Calendar" class="w-4 h-4 text-accent" /> Tomorrow Morning</span>
                      <span class="text-muted font-mono text-[10px]">09:00 AM</span>
                    </button>
                    <button class="flex items-center justify-between border border-border hover:border-accent hover:bg-accent/5 rounded-lg p-2.5 text-xs text-left transition-colors font-medium">
                      <span class="flex items-center gap-2"><Icon name="Coffee" class="w-4 h-4 text-accent" /> Next Weekend</span>
                      <span class="text-muted font-mono text-[10px]">Saturday</span>
                    </button>
                  </div>
                </div>
                <!-- Mini warning / note -->
                <div class="text-xs text-muted bg-surface-2 border border-border rounded p-2.5 flex items-start gap-2">
                  <Icon name="Info" class="w-3.5 h-3.5 text-accent flex-shrink-0 mt-0.5" />
                  <span>Your active tab will be securely closed and reopened automatically.</span>
                </div>
              </div>
            ) : (
              <div class="flex flex-col flex-grow bg-surface text-text font-body text-xs select-none">
                <!-- Extension Header -->
                <div class="px-4 py-3 border-b border-border flex items-center justify-between bg-surface">
                  <div class="flex items-center gap-1.5">
                    <span class="w-5 h-5 rounded-md bg-[#6366f1] flex items-center justify-center text-white p-0.5">
                      <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 2v2m0 16v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M2 12h2m16 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                      </svg>
                    </span>
                    <span class="font-heading font-extrabold text-sm text-text leading-none">Story<span class="text-[#6366f1]">Peek</span></span>
                  </div>
                  <!-- Header Actions -->
                  <div class="flex items-center gap-2.5 text-muted">
                    <Icon name="RefreshCw" class="w-3.5 h-3.5 hover:text-text cursor-pointer" />
                    <Icon name="Instagram" class="w-3.5 h-3.5 hover:text-text cursor-pointer" />
                    <Icon name="Settings" class="w-3.5 h-3.5 hover:text-text cursor-pointer" />
                    <Icon name="Moon" class="w-3.5 h-3.5 hover:text-text cursor-pointer" />
                  </div>
                </div>

                <!-- Tabs Navigation -->
                <div class="px-4 border-b border-border bg-surface flex gap-5 text-[11px] font-medium">
                  <button class="py-2.5 border-b-2 border-[#6366f1] text-[#6366f1] flex items-center gap-1 cursor-pointer">
                    <Icon name="User" class="w-3.5 h-3.5" />
                    Stories
                  </button>
                  <button class="py-2.5 text-muted hover:text-text flex items-center gap-1 cursor-pointer">
                    <Icon name="Download" class="w-3.5 h-3.5" />
                    Download
                  </button>
                  <button class="py-2.5 text-muted hover:text-text flex items-center gap-1 cursor-pointer">
                    <Icon name="Search" class="w-3.5 h-3.5" />
                    Search
                  </button>
                  <button class="py-2.5 text-muted hover:text-text flex items-center gap-1 cursor-pointer">
                    <Icon name="Star" class="w-3.5 h-3.5" />
                    Pro
                  </button>
                </div>

                <!-- Banner -->
                <div class="m-3 p-2 bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200/50 dark:border-emerald-900/30 rounded-lg text-emerald-800 dark:text-emerald-400 flex items-start gap-2 text-[10px] leading-relaxed">
                  <Icon name="ShieldCheck" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5" />
                  <span>Anonymous mode active — stories viewed without seen receipts</span>
                </div>

                <!-- Active Stories Section -->
                <div class="px-3 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold text-muted uppercase tracking-wider">Active Stories</span>
                    <span class="text-[9px] bg-emerald-100 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-400 font-semibold px-2 py-0.5 rounded-full">17 ACTIVE</span>
                  </div>

                  <!-- Stories Carousel Container -->
                  <div class="relative flex items-center">
                    <!-- Left Arrow -->
                    <span class="absolute -left-1 z-10 w-5 h-5 rounded-full border border-border bg-surface flex items-center justify-center text-[10px] text-muted shadow-sm cursor-pointer hover:text-text">
                      ‹
                    </span>
                    <!-- Stories Bubbles -->
                    <div class="flex gap-3 overflow-x-auto py-1 px-4 w-full scrollbar-none">
                      <!-- Bubble 1 (Khabib) -->
                      <div class="flex flex-col items-center gap-1 cursor-pointer">
                        <div class="w-11 h-11 rounded-full p-[2.5px] bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 relative">
                          <div class="w-full h-full rounded-full bg-surface border border-surface flex items-center justify-center text-[10px] font-bold text-text">
                            KB
                          </div>
                          <!-- Count badge -->
                          <span class="absolute -bottom-1 -right-1 bg-[#6366f1] text-white font-mono text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-surface">
                            7
                          </span>
                        </div>
                        <span class="text-[9px] text-muted truncate w-12 text-center">khabib_n...</span>
                      </div>

                      <!-- Bubble 2 (Inidnews) -->
                      <div class="flex flex-col items-center gap-1 cursor-pointer">
                        <div class="w-11 h-11 rounded-full p-[2.5px] bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 relative">
                          <div class="w-full h-full rounded-full bg-surface border border-surface flex items-center justify-center text-[10px] font-bold text-text">
                            IN
                          </div>
                          <span class="absolute -bottom-1 -right-1 bg-[#6366f1] text-white font-mono text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-surface">
                            4
                          </span>
                        </div>
                        <span class="text-[9px] text-muted truncate w-12 text-center">inidnews</span>
                      </div>

                      <!-- Bubble 3 (Equipe) -->
                      <div class="flex flex-col items-center gap-1 cursor-pointer">
                        <div class="w-11 h-11 rounded-full p-[2.5px] bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 relative">
                          <div class="w-full h-full rounded-full bg-surface border border-surface flex items-center justify-center text-[10px] font-bold text-text">
                            EQ
                          </div>
                          <span class="absolute -bottom-1 -right-1 bg-[#6366f1] text-white font-mono text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-surface">
                            10
                          </span>
                        </div>
                        <span class="text-[9px] text-muted truncate w-12 text-center">equipedu...</span>
                      </div>

                      <!-- Bubble 4 (NatGeo) -->
                      <div class="flex flex-col items-center gap-1 cursor-pointer">
                        <div class="w-11 h-11 rounded-full p-[2.5px] bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 relative">
                          <div class="w-full h-full rounded-full bg-surface border border-surface flex items-center justify-center text-[10px] font-bold text-text">
                            NG
                          </div>
                          <span class="absolute -bottom-1 -right-1 bg-[#6366f1] text-white font-mono text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-surface">
                            3
                          </span>
                        </div>
                        <span class="text-[9px] text-muted truncate w-12 text-center">natgeo</span>
                      </div>

                      <!-- Bubble 5 (NatGeoAnimals) -->
                      <div class="flex flex-col items-center gap-1 cursor-pointer">
                        <div class="w-11 h-11 rounded-full p-[2.5px] bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 relative">
                          <div class="w-full h-full rounded-full bg-surface border border-surface flex items-center justify-center text-[10px] font-bold text-text">
                            NA
                          </div>
                          <span class="absolute -bottom-1 -right-1 bg-[#6366f1] text-white font-mono text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-surface">
                            2
                          </span>
                        </div>
                        <span class="text-[9px] text-muted truncate w-12 text-center">natgeoan...</span>
                      </div>
                    </div>
                    <!-- Right Arrow -->
                    <span class="absolute -right-1 z-10 w-5 h-5 rounded-full border border-border bg-surface flex items-center justify-center text-[10px] text-muted shadow-sm cursor-pointer hover:text-text">
                      ›
                    </span>
                  </div>
                </div>

                <!-- Recent Highlights Section -->
                <div class="px-3 mt-4 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold text-muted uppercase tracking-wider">Recent Highlights</span>
                    <span class="text-[9px] text-[#6366f1] hover:underline cursor-pointer font-medium">See all</span>
                  </div>
                  <div class="flex gap-4 overflow-x-auto py-1 px-1">
                    <!-- Highlight 1 -->
                    <div class="flex flex-col items-center gap-1 cursor-pointer">
                      <div class="w-9 h-9 rounded-full border border-border bg-surface-2 flex items-center justify-center text-[9px] font-semibold text-text">
                        H1
                      </div>
                      <span class="text-[9px] text-muted truncate w-12 text-center">Highligh...</span>
                    </div>
                    <!-- Highlight 2 -->
                    <div class="flex flex-col items-center gap-1 cursor-pointer">
                      <div class="w-9 h-9 rounded-full border border-border bg-surface-2 flex items-center justify-center text-[9px] font-semibold text-text">
                        H2
                      </div>
                      <span class="text-[9px] text-muted truncate w-12 text-center">Highligh...</span>
                    </div>
                    <!-- Highlight 3 -->
                    <div class="flex flex-col items-center gap-1 cursor-pointer">
                      <div class="w-9 h-9 rounded-full border border-border bg-surface-2 flex items-center justify-center text-[9px] font-semibold text-text">
                        H3
                      </div>
                      <span class="text-[9px] text-muted truncate w-12 text-center">Highligh...</span>
                    </div>
                    <!-- Highlight 4 -->
                    <div class="flex flex-col items-center gap-1 cursor-pointer">
                      <div class="w-9 h-9 rounded-full border border-border bg-surface-2 flex items-center justify-center text-[9px] font-semibold text-text">
                        H4
                      </div>
                      <span class="text-[9px] text-muted truncate w-12 text-center">Highligh...</span>
                    </div>
                  </div>
                </div>

                <!-- Footer Status Bar -->
                <div class="mt-4 px-3 py-2 bg-surface-2 border-t border-border flex items-center justify-between text-[9px] text-muted rounded-b-xl">
                  <div class="flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>17 stories found</span>
                  </div>
                  <div class="flex gap-2">
                    <span class="hover:text-text cursor-pointer">Help</span>
                    <span class="hover:text-text cursor-pointer">Privacy</span>
                    <span class="hover:text-text cursor-pointer">Terms</span>
                  </div>
                </div>
              </div>
            )}
          </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 bg-surface border-b border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl flex flex-col gap-4 mb-16 text-left">
        <h2 class="text-h2 text-text">Engineered for utility.</h2>
        <p class="text-body text-muted max-w-prose">
          Here is exactly what {ext.data.title} brings to your browsing workflow. No fluff, just functionality.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-left">
        {ext.data.features.map((feat) => (
          <div class="flex flex-col items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
              <Icon name={feat.icon} class="w-6 h-6 text-accent" />
            </div>
            <h3 class="text-h3 text-text">{feat.title}</h3>
            <p class="text-small text-muted max-w-prose">
              {feat.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detail Markdown Content Section -->
  <section class="py-24 bg-bg">
    <div class="max-w-3xl mx-auto px-6 text-left">
      <h2 class="text-h2 text-text mb-8 border-b border-border/50 pb-4">Deep Dive & Technical Insights</h2>
      <div class="prose prose-stone leading-relaxed text-muted flex flex-col gap-6 text-base">
        <Content />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-surface border-t border-border">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center flex flex-col gap-4 mb-16">
        <h2 class="text-h2 text-text">Frequently Asked Questions</h2>
        <p class="text-body text-muted max-w-prose mx-auto">
          Everything you need to know about permissions, data policies, and functionality.
        </p>
      </div>

      <div class="flex flex-col gap-4 text-left">
        {ext.data.faq.map((item) => (
          <details class="group bg-surface border border-border rounded-xl transition-all duration-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center p-6 font-semibold text-text cursor-pointer focus:outline-none select-none">
              <span class="font-heading pr-4">{item.question}</span>
              <span class="transition-transform duration-200 group-open:rotate-180 text-muted">
                <Icon name="ChevronDown" class="w-5 h-5 text-muted" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-sm text-muted leading-relaxed border-t border-border/30 pt-4">
              <p class="max-w-prose">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Markdown subcontent rendering */
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    font-family: var(--font-heading);
  }
  .prose p {
    color: var(--color-muted);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    color: var(--color-text);
  }
</style>
