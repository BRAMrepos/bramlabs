---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
const { Content } = await ext.render();

// Setup SoftwareApplication schema for Google search rich snippet
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": ext.data.title,
  "operatingSystem": "Chrome, Firefox, Edge, Safari",
  "applicationCategory": "BrowserApplication",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "84"
  },
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title={ext.data.title}
  description={ext.data.tagline}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="py-32 bg-bg border-b border-border">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left: Extension info -->
      <div class={slug === 'story-peek' ? "lg:col-span-10 lg:col-start-2 flex flex-col items-center text-center gap-6" : "lg:col-span-6 flex flex-col items-start gap-6 text-left"}>
        <!-- Back Link -->
        <a href="/extensions" class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-2 uppercase tracking-wider">
          <Icon name="ArrowLeft" class="w-3.5 h-3.5" />
          Back to Directory
        </a>
        
        <div class={`flex items-center gap-4 ${slug === 'story-peek' ? 'flex-col text-center' : ''}`}>
          <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center text-white shadow-sm">
            <Icon name={ext.data.icon} class="w-9 h-9 text-white" />
          </div>
          <div class={slug === 'story-peek' ? 'flex flex-col items-center' : ''}>
            <h1 class="text-h1 text-text leading-tight">
              {ext.data.title}
            </h1>
            <p class="text-mono text-xs text-muted mt-1">
              Version {ext.data.version} &bull; Updated {ext.data.lastUpdated}
            </p>
          </div>
        </div>

        <p class={`text-body text-muted max-w-prose ${slug === 'story-peek' ? 'text-center' : 'text-left'}`}>
          {ext.data.tagline}
        </p>

        <!-- CTAs -->
        <div class={`flex flex-col gap-2.5 w-full sm:w-auto mt-2 ${slug === 'story-peek' ? 'items-center' : 'items-start'}`}>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
            <a
              href={ext.data.storeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent hover:bg-accent-hover text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 shadow-sm text-center flex items-center justify-center gap-2 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Add to Chrome (Free)
              <Icon name="ArrowUpRight" class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
            <a
              href={`/extensions/${slug}/privacy`}
              class="border border-border bg-surface text-text hover:border-text px-6 py-3.5 rounded-lg font-semibold transition-all duration-150 text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Privacy Policy
            </a>
          </div>
          <p class={`text-[11px] text-muted mt-1 ${slug === 'story-peek' ? 'text-center' : 'text-left'}`}>
            Free to install &bull; Pro upgrade available for advanced features
          </p>
          
          <!-- Helper resource sub-navigation links -->
          <div class={`flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-muted mt-3 border-t border-border/40 pt-3 w-full font-mono ${slug === 'story-peek' ? 'justify-center' : 'justify-start'}`}>
            <a href={`/extensions/${slug}/help`} class="hover:text-accent transition-colors font-medium">User Guide</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/pricing`} class="hover:text-accent transition-colors font-medium">Pricing</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/activate`} class="hover:text-accent transition-colors font-medium">Activation</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/support`} class="hover:text-accent transition-colors font-medium">Support & FAQ</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/changelog`} class="hover:text-accent transition-colors font-medium">Changelog</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/terms`} class="hover:text-accent transition-colors font-medium">Terms</a>
          </div>
        </div>

        <!-- Meta badges -->
        <div class={`flex flex-wrap items-center gap-6 mt-4 text-mono text-xs text-muted ${slug === 'story-peek' ? 'justify-center' : 'justify-start'}`}>
          <div class="flex items-center gap-1.5">
            <Icon name="Download" class="w-4 h-4 text-accent" />
            <span>{ext.data.downloadCount}</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <Icon name="Shield" class="w-4 h-4 text-green-600" />
            <span>GDPR Compliant</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <Icon name="Github" class="w-4 h-4 text-text" />
            <span>Open Source</span>
          </div>
        </div>
      </div>

      <!-- Right: Real Toolbar/Popup UI rendered in CSS -->
      {slug !== 'story-peek' && (
        <div class="lg:col-span-6 flex justify-center w-full">
          <div class="w-full max-w-md bg-surface rounded-xl border border-border shadow-md overflow-hidden flex flex-col transition-all duration-200">
            <!-- Window Header -->
            <div class="bg-surface-2 px-4 py-3 border-b border-border flex items-center justify-between">
              <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></span>
              </div>
              <!-- Mock URL bar -->
              <div class="bg-surface border border-border rounded-md px-3 py-0.5 text-mono text-xs text-muted w-40 text-center truncate select-none">
                {slug === 'snap-elite' ? 'github.com' : 'youtube.com'}
              </div>
              <!-- Mock extension icon in toolbar -->
              <div class="w-10 flex justify-end">
                <span class="w-5 h-5 rounded bg-accent flex items-center justify-center text-xs text-white">
                  <Icon name={ext.data.icon} class="w-3.5 h-3.5 text-white" />
                </span>
              </div>
            </div>

            <!-- Popup Content -->
            <div class="p-5 bg-surface text-text select-none min-h-[350px] flex flex-col justify-between text-left font-sans">
              {slug === 'snap-elite' ? (
                <div class="flex flex-col gap-4 flex-grow">
                  <!-- Header -->
                  <div class="flex items-center justify-between border-b border-border pb-3">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded bg-accent flex items-center justify-center text-white">
                        <Icon name="Camera" class="w-4 h-4 text-white" />
                      </div>
                      <span class="font-heading font-extrabold text-sm text-text">SnapElite</span>
                    </div>
                    <div class="flex items-center gap-2 text-muted">
                      <Icon name="History" class="w-4.5 h-4.5 hover:text-text cursor-pointer" />
                      <Icon name="Settings" class="w-4.5 h-4.5 hover:text-text cursor-pointer" />
                    </div>
                  </div>

                  <!-- Mode selector -->
                  <div class="grid grid-cols-4 gap-1 text-[10px] font-semibold text-center border-b border-border pb-3">
                    <div class="flex flex-col items-center gap-1 p-1 bg-accent/10 border border-accent/20 rounded text-accent cursor-pointer">
                      <Icon name="Maximize" class="w-4.5 h-4.5 text-accent" />
                      <span>Full Page</span>
                    </div>
                    <div class="flex flex-col items-center gap-1 p-1 hover:bg-surface-2 rounded text-muted cursor-pointer">
                      <Icon name="Smartphone" class="w-4.5 h-4.5" />
                      <span>Viewport</span>
                    </div>
                    <div class="flex flex-col items-center gap-1 p-1 hover:bg-surface-2 rounded text-muted cursor-pointer">
                      <Icon name="Grid" class="w-4.5 h-4.5" />
                      <span>Element</span>
                    </div>
                    <div class="flex flex-col items-center gap-1 p-1 hover:bg-surface-2 rounded text-muted cursor-pointer">
                      <Icon name="Crop" class="w-4.5 h-4.5" />
                      <span>Region</span>
                    </div>
                  </div>

                  <!-- Capture Button -->
                  <div class="flex flex-col gap-2.5">
                    <button class="w-full bg-accent hover:bg-accent-hover text-white py-2.5 rounded-lg text-xs font-bold flex items-center justify-center gap-2 shadow-sm cursor-pointer">
                      <Icon name="Camera" class="w-4 h-4 text-white" />
                      Capture Full Page
                    </button>

                    <!-- Delay selector -->
                    <div class="flex items-center justify-between text-xs border border-border rounded-lg p-2 bg-surface-2">
                      <span class="text-muted">Capture Delay ⓘ</span>
                      <div class="flex gap-1">
                        <span class="px-1.5 py-0.5 rounded bg-accent text-white font-bold text-[10px]">0s</span>
                        <span class="px-1.5 py-0.5 rounded hover:bg-border font-bold text-[10px] text-muted">3s</span>
                        <span class="px-1.5 py-0.5 rounded hover:bg-border font-bold text-[10px] text-muted">5s</span>
                        <span class="px-1.5 py-0.5 rounded hover:bg-border font-bold text-[10px] text-muted">10s</span>
                      </div>
                    </div>
                  </div>

                  <!-- Recent list -->
                  <div class="flex flex-col gap-1.5 mt-2">
                    <div class="flex justify-between items-center text-[10px] font-bold text-muted uppercase tracking-wider">
                      <span>Recent Screenshots</span>
                      <span class="text-accent hover:underline cursor-pointer">View all</span>
                    </div>
                    <div class="grid grid-cols-4 gap-2">
                      <div class="aspect-video bg-surface-2 border border-border rounded flex items-center justify-center text-[8px] text-muted font-mono overflow-hidden">
                        <Icon name="Image" class="w-4.5 h-4.5 text-muted/40" />
                      </div>
                      <div class="aspect-video bg-surface-2 border border-border rounded flex items-center justify-center text-[8px] text-muted font-mono overflow-hidden">
                        <Icon name="Image" class="w-4.5 h-4.5 text-muted/40" />
                      </div>
                      <div class="aspect-video bg-surface-2 border border-border rounded flex items-center justify-center text-[8px] text-muted font-mono overflow-hidden">
                        <Icon name="Image" class="w-4.5 h-4.5 text-muted/40" />
                      </div>
                      <div class="aspect-video bg-surface-2 border border-border rounded flex items-center justify-center text-[8px] text-muted font-mono overflow-hidden">
                        <Icon name="Image" class="w-4.5 h-4.5 text-muted/40" />
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <div class="flex flex-col gap-4 flex-grow font-sans">
                  <!-- SonicShield Panel -->
                  <div class="flex items-center justify-between border-b border-border pb-3">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-accent flex items-center justify-center text-white">
                        <Icon name="Volume2" class="w-4 h-4 text-white" />
                      </div>
                      <div>
                        <span class="font-heading font-extrabold text-sm text-text block leading-none">SonicShield</span>
                        <span class="text-[9px] text-muted">youtube.com</span>
                      </div>
                    </div>
                    <span class="text-[9px] font-mono bg-accent-muted text-accent px-1.5 py-0.5 rounded-full font-bold">Free Tier</span>
                  </div>

                  <!-- Navigation -->
                  <div class="flex gap-2 border-b border-border text-xs font-semibold text-muted pb-2">
                    <span class="text-accent border-b border-accent pb-1 cursor-pointer">Control</span>
                    <span class="hover:text-text cursor-pointer">Profiles</span>
                    <span class="hover:text-text cursor-pointer text-amber-500">Upgrade</span>
                  </div>

                  <!-- Volume Card -->
                  <div class="bg-surface-2 border border-border rounded-xl p-3.5 flex flex-col gap-2.5">
                    <div class="flex justify-between items-center text-xs">
                      <span class="font-semibold">Target Volume</span>
                      <span class="font-mono text-accent font-bold">140%</span>
                    </div>

                    <!-- Waveform visualizer mockup -->
                    <div class="flex items-center justify-between h-8 px-2 gap-[2px]">
                      <div class="h-2 w-1 bg-accent/40 rounded-full"></div>
                      <div class="h-4 w-1 bg-accent/40 rounded-full"></div>
                      <div class="h-6 w-1 bg-accent/60 rounded-full"></div>
                      <div class="h-3 w-1 bg-accent/50 rounded-full"></div>
                      <div class="h-7 w-1 bg-accent rounded-full animate-pulse"></div>
                      <div class="h-5 w-1 bg-accent rounded-full animate-pulse"></div>
                      <div class="h-8 w-1 bg-accent rounded-full animate-pulse"></div>
                      <div class="h-4 w-1 bg-accent rounded-full animate-pulse"></div>
                      <div class="h-6 w-1 bg-accent rounded-full animate-pulse"></div>
                      <div class="h-2 w-1 bg-accent/40 rounded-full"></div>
                    </div>

                    <!-- Slider track -->
                    <div class="relative w-full h-1.5 bg-border rounded-full mt-1">
                      <div class="absolute top-0 left-0 w-[70%] h-full bg-accent rounded-full"></div>
                      <div class="absolute top-1/2 left-[70%] -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 bg-accent border-2 border-white dark:border-black rounded-full shadow-sm"></div>
                    </div>
                    <div class="flex justify-between text-[9px] text-muted font-mono mt-0.5">
                      <span>0%</span>
                      <span>100% (Max)</span>
                      <span>200% (Boost)</span>
                    </div>
                  </div>

                  <!-- Presets -->
                  <div class="flex flex-col gap-1.5">
                    <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Equalizer Profiles</span>
                    <div class="grid grid-cols-3 gap-1.5 text-[10px] text-center font-medium">
                      <div class="py-1.5 px-1 border border-accent bg-accent/5 text-accent rounded cursor-pointer flex items-center justify-center gap-1">
                        <Icon name="Activity" class="w-3.5 h-3.5" />
                        <span>Flat</span>
                      </div>
                      <div class="py-1.5 px-1 border border-border hover:border-accent rounded text-muted cursor-pointer flex items-center justify-center gap-1">
                        <Icon name="Sliders" class="w-3.5 h-3.5 animate-pulse" />
                        <span>Bass Boost</span>
                      </div>
                      <div class="py-1.5 px-1 border border-border hover:border-accent rounded text-muted cursor-pointer flex items-center justify-center gap-1">
                        <Icon name="Shield" class="w-3.5 h-3.5" />
                        <span>Vocals</span>
                      </div>
                    </div>
                  </div>

                  <!-- Toggles -->
                  <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="flex justify-between items-center p-2 border border-border rounded-lg bg-surface-2">
                      <span class="text-muted font-medium">Peak Limiter</span>
                      <span class="w-6 h-3.5 bg-accent rounded-full relative p-0.5 cursor-pointer">
                        <span class="w-2.5 h-2.5 bg-white rounded-full block float-right"></span>
                      </span>
                    </div>
                    <div class="flex justify-between items-center p-2 border border-border rounded-lg bg-surface-2">
                      <span class="text-muted font-medium">Mono Mix</span>
                      <span class="w-6 h-3.5 bg-border rounded-full relative p-0.5 cursor-pointer">
                        <span class="w-2.5 h-2.5 bg-white rounded-full block float-left"></span>
                      </span>
                    </div>
                  </div>
                </div>
              )}

              <!-- Common popup footer -->
              <div class="border-t border-border/60 pt-2 flex items-center justify-between text-[10px] text-muted">
                {slug === 'snap-elite' ? (
                  <>
                    <span class="hover:text-text cursor-pointer">Help & Feedback</span>
                    <span>·</span>
                    <span class="text-amber-500 font-bold hover:underline cursor-pointer">Upgrade to Pro ⚡</span>
                  </>
                ) : (
                  <>
                    <span class="hover:text-text cursor-pointer">⭐ Rate Us</span>
                    <span>·</span>
                    <span class="hover:text-text cursor-pointer">🚀 More Apps</span>
                  </>
                )}
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 bg-surface border-b border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl flex flex-col gap-4 mb-16 text-left">
        <h2 class="text-h2 text-text">Engineered for utility.</h2>
        <p class="text-body text-muted max-w-prose">
          Here is exactly what {ext.data.title} brings to your browsing workflow. No fluff, just functionality.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-left">
        {ext.data.features.map((feat) => (
          <div class="flex flex-col items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
              <Icon name={feat.icon} class="w-6 h-6 text-accent" />
            </div>
            <h3 class="text-h3 text-text">{feat.title}</h3>
            <p class="text-small text-muted max-w-prose">
              {feat.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detail Markdown Content Section -->
  <section class="py-24 bg-bg">
    <div class="max-w-3xl mx-auto px-6 text-left">
      <h2 class="text-h2 text-text mb-8 border-b border-border/50 pb-4">Deep Dive & Technical Insights</h2>
      <div class="prose prose-stone leading-relaxed text-muted flex flex-col gap-6 text-base">
        <Content />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-surface border-t border-border">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center flex flex-col gap-4 mb-16">
        <h2 class="text-h2 text-text">Frequently Asked Questions</h2>
        <p class="text-body text-muted max-w-prose mx-auto">
          Everything you need to know about permissions, data policies, and functionality.
        </p>
      </div>

      <div class="flex flex-col gap-4 text-left">
        {ext.data.faq.map((item) => (
          <details class="group bg-surface border border-border rounded-xl transition-all duration-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center p-6 font-semibold text-text cursor-pointer focus:outline-none select-none">
              <span class="font-heading pr-4">{item.question}</span>
              <span class="transition-transform duration-200 group-open:rotate-180 text-muted">
                <Icon name="ChevronDown" class="w-5 h-5 text-muted" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-sm text-muted leading-relaxed border-t border-border/30 pt-4">
              <p class="max-w-prose">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Markdown subcontent rendering */
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    font-family: var(--font-heading);
  }
  .prose p {
    color: var(--color-muted);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    color: var(--color-text);
  }
</style>
