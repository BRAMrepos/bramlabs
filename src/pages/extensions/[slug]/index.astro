---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
const { Content } = await ext.render();

// Setup SoftwareApplication schema for Google search rich snippet
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": ext.data.title,
  "operatingSystem": "Chrome, Firefox, Edge, Safari",
  "applicationCategory": "BrowserApplication",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "84"
  },
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout
  title={ext.data.title}
  description={ext.data.tagline}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="py-32 bg-bg border-b border-border">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left: Extension info -->
      <div class="lg:col-span-7 flex flex-col items-start gap-6 text-left">
        <!-- Back Link -->
        <a href="/extensions" class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-2 uppercase tracking-wider">
          <Icon name="ArrowLeft" class="w-3.5 h-3.5" />
          Back to Directory
        </a>
        
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center text-white shadow-sm">
            <Icon name={ext.data.icon} class="w-9 h-9 text-white" />
          </div>
          <div>
            <h1 class="text-h1 text-text leading-tight">
              {ext.data.title}
            </h1>
            <p class="text-mono text-xs text-muted mt-1">
              Version {ext.data.version} &bull; Updated {ext.data.lastUpdated}
            </p>
          </div>
        </div>

        <p class="text-body text-muted max-w-prose">
          {ext.data.tagline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col gap-2.5 w-full sm:w-auto mt-2">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
            <a
              href={ext.data.storeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent hover:bg-accent-hover text-white px-8 py-3.5 rounded-lg font-semibold transition-colors duration-150 shadow-sm text-center flex items-center justify-center gap-2 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Add to Chrome (Free)
              <Icon name="ArrowUpRight" class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
            <a
              href={`/extensions/${slug}/privacy`}
              class="border border-border bg-surface text-text hover:border-text px-6 py-3.5 rounded-lg font-semibold transition-all duration-150 text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
            >
              Privacy Policy
            </a>
          </div>
          <p class="text-[11px] text-muted text-left mt-1">
            Free to install &bull; Pro upgrade available for advanced features
          </p>
          
          <!-- Helper resource sub-navigation links -->
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-muted mt-3 border-t border-border/40 pt-3 w-full font-mono justify-start">
            <a href={`/extensions/${slug}/help`} class="hover:text-accent transition-colors font-medium">User Guide</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/pricing`} class="hover:text-accent transition-colors font-medium">Pricing</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/activate`} class="hover:text-accent transition-colors font-medium">Activation</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/support`} class="hover:text-accent transition-colors font-medium">Support & FAQ</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/changelog`} class="hover:text-accent transition-colors font-medium">Changelog</a>
            <span>&bull;</span>
            <a href={`/extensions/${slug}/terms`} class="hover:text-accent transition-colors font-medium">Terms</a>
          </div>
        </div>

        <!-- Meta badges -->
        <div class="flex flex-wrap items-center gap-6 mt-4 text-mono text-xs text-muted justify-start">
          <div class="flex items-center gap-1.5">
            <Icon name="Zap" class="w-4 h-4 text-accent" />
            <span>Lightweight &amp; Fast</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <Icon name="User" class="w-4 h-4 text-accent" />
            <span>No Account Needed</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Product Spec Cards -->
      <div class="lg:col-span-5 flex justify-center w-full">
        {slug === 'story-peek' && (
          <!-- Product Spec Card for StoryPeek -->
          <div class="w-full max-w-md bg-surface-2 border border-border/85 rounded-2xl shadow-xl p-6 flex flex-col gap-6 relative overflow-hidden transition-all duration-200 text-left">
            <div class="absolute -right-24 -top-24 w-48 h-48 rounded-full bg-accent/5 blur-3xl"></div>
            
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                  <Icon name="EyeOff" class="w-5 h-5 text-accent" />
                </div>
                <div>
                  <h3 class="text-xs font-bold text-text leading-none font-heading">StoryPeek Overview</h3>
                  <span class="text-[9px] font-mono text-muted mt-1 block">Capabilities &amp; Specs</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent font-mono text-[9px] font-bold">
                v2.0.0 Stable
              </span>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Compatibility</span>
                <span class="font-bold text-text text-[11px] truncate">Chrome, Edge, Brave</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Media Format</span>
                <span class="font-bold text-text text-accent">Stories, Reels, Posts</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Package Size</span>
                <span class="font-bold text-text font-mono">112.5 KB (Ultra light)</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Requirements</span>
                <span class="font-bold text-text">No account / login</span>
              </div>
            </div>

            <!-- Features Checklist -->
            <div class="flex flex-col gap-2.5">
              <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Product Features</span>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Watch stories anonymously on the web</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Download images &amp; videos in one click</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Clean overlay controls on host pages</span>
                </div>
              </div>
            </div>

            <!-- Status banner -->
            <div class="border-t border-border pt-4 flex items-center justify-between text-[10px] text-muted">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
                <span class="font-bold text-text">Available in Chrome Web Store</span>
              </span>
            </div>
          </div>
        )}

        {slug === 'snap-elite' && (
          <!-- Product Spec Card for SnapElite -->
          <div class="w-full max-w-md bg-surface-2 border border-border/85 rounded-2xl shadow-xl p-6 flex flex-col gap-6 relative overflow-hidden transition-all duration-200 text-left">
            <div class="absolute -right-24 -top-24 w-48 h-48 rounded-full bg-accent/5 blur-3xl"></div>
            
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                  <Icon name="Camera" class="w-5 h-5 text-accent" />
                </div>
                <div>
                  <h3 class="text-xs font-bold text-text leading-none font-heading">SnapElite Overview</h3>
                  <span class="text-[9px] font-mono text-muted mt-1 block">Capabilities &amp; Specs</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent font-mono text-[9px] font-bold">
                v1.0.0 Stable
              </span>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Capture Modes</span>
                <span class="font-bold text-text text-[11px] truncate">Full Page, Viewport, Crop</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Output Formats</span>
                <span class="font-bold text-text text-accent">PNG, JPEG, PDF</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Package Size</span>
                <span class="font-bold text-text font-mono">180.2 KB (Lightweight)</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Editor Tools</span>
                <span class="font-bold text-text">Shapes, Blur, Highlighter</span>
              </div>
            </div>

            <!-- Features Checklist -->
            <div class="flex flex-col gap-2.5">
              <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Product Features</span>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Stitch scrolling full-page capture</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Built-in shape &amp; text annotation canvas</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Custom filename templates &amp; history</span>
                </div>
              </div>
            </div>

            <!-- Status banner -->
            <div class="border-t border-border pt-4 flex items-center justify-between text-[10px] text-muted">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
                <span class="font-bold text-text">Available in Chrome Web Store</span>
              </span>
            </div>
          </div>
        )}

        {slug === 'sonic-shield' && (
          <!-- Product Spec Card for SonicShield -->
          <div class="w-full max-w-md bg-surface-2 border border-border/85 rounded-2xl shadow-xl p-6 flex flex-col gap-6 relative overflow-hidden transition-all duration-200 text-left">
            <div class="absolute -right-24 -top-24 w-48 h-48 rounded-full bg-accent/5 blur-3xl"></div>
            
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                  <Icon name="Volume2" class="w-5 h-5 text-accent" />
                </div>
                <div>
                  <h3 class="text-xs font-bold text-text leading-none font-heading">SonicShield Overview</h3>
                  <span class="text-[9px] font-mono text-muted mt-1 block">Capabilities &amp; Specs</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent font-mono text-[9px] font-bold">
                v1.0.0 Stable
              </span>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Sound Boost</span>
                <span class="font-bold text-text text-[11px] truncate">Up to 200% Safe Boosting</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Audio Processing</span>
                <span class="font-bold text-text text-accent">Peak Limiter &amp; Equalizer</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Package Size</span>
                <span class="font-bold text-text font-mono">92.4 KB (Ultra light)</span>
              </div>
              <div class="p-3 rounded-xl bg-surface border border-border/60 flex flex-col gap-1">
                <span class="text-muted text-[10px] uppercase font-semibold">Mute Modes</span>
                <span class="font-bold text-text">Hotkeys / Tab-specific</span>
              </div>
            </div>

            <!-- Features Checklist -->
            <div class="flex flex-col gap-2.5">
              <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Product Features</span>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>DynamicsCompressor sound peak limiter</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Site-specific volume normalizers</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <Icon name="CheckCircle" class="w-4 h-4 text-accent flex-shrink-0" />
                  <span>Mono mixing toggles for voice tracks</span>
                </div>
              </div>
            </div>

            <!-- Status banner -->
            <div class="border-t border-border pt-4 flex items-center justify-between text-[10px] text-muted">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
                <span class="font-bold text-text">Available in Chrome Web Store</span>
              </span>
            </div>
          </div>
        )}
      </div> 
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 bg-surface border-b border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl flex flex-col gap-4 mb-16 text-left">
        <h2 class="text-h2 text-text">Engineered for utility.</h2>
        <p class="text-body text-muted max-w-prose">
          Here is exactly what {ext.data.title} brings to your browsing workflow. No fluff, just functionality.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-left">
        {ext.data.features.map((feat) => (
          <div class="flex flex-col items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
              <Icon name={feat.icon} class="w-6 h-6 text-accent" />
            </div>
            <h3 class="text-h3 text-text">{feat.title}</h3>
            <p class="text-small text-muted max-w-prose">
              {feat.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detail Markdown Content Section -->
  <section class="py-24 bg-bg">
    <div class="max-w-3xl mx-auto px-6 text-left">
      <h2 class="text-h2 text-text mb-8 border-b border-border/50 pb-4">Deep Dive & Technical Insights</h2>
      <div class="prose prose-stone leading-relaxed text-muted flex flex-col gap-6 text-base">
        <Content />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-surface border-t border-border">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center flex flex-col gap-4 mb-16">
        <h2 class="text-h2 text-text">Frequently Asked Questions</h2>
        <p class="text-body text-muted max-w-prose mx-auto">
          Everything you need to know about permissions, data policies, and functionality.
        </p>
      </div>

      <div class="flex flex-col gap-4 text-left">
        {ext.data.faq.map((item) => (
          <details class="group bg-surface border border-border rounded-xl transition-all duration-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center p-6 font-semibold text-text cursor-pointer focus:outline-none select-none">
              <span class="font-heading pr-4">{item.question}</span>
              <span class="transition-transform duration-200 group-open:rotate-180 text-muted">
                <Icon name="ChevronDown" class="w-5 h-5 text-muted" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-sm text-muted leading-relaxed border-t border-border/30 pt-4">
              <p class="max-w-prose">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Markdown subcontent rendering */
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    font-family: var(--font-heading);
  }
  .prose p {
    color: var(--color-muted);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    color: var(--color-text);
  }
</style>
