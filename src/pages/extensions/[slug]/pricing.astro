---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${ext.data.title} Pricing — Free vs Pro`}
  description={`Compare Free vs Pro tiers for the ${ext.data.title} extension and unlock bulk downloads, 4K quality, and priority support.`}
>
  <section class="py-24 bg-bg">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="flex flex-col items-center gap-4 mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/15 text-accent text-xs font-mono font-semibold">
          <span>Simple, Honest Pricing</span>
        </div>
        <h1 class="text-h1 text-text leading-tight">
          Supercharge your {ext.data.title} experience
        </h1>
        <p class="text-body text-muted max-w-prose">
          Unlock advanced automation, higher resolution media downloads, and priority support with a simple, one-time payment. No recurring monthly subscriptions.
        </p>
      </div>

      <!-- Pricing Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto items-start text-left mb-16">
        <!-- Free Plan -->
        <div class="bg-surface border border-border rounded-2xl p-8 flex flex-col gap-6 shadow-sm">
          <div class="flex flex-col gap-2">
            <h3 class="text-lg font-bold text-text">StoryPeek Free</h3>
            <p class="text-xs text-muted">Essential incognito story viewing and basic downloads.</p>
          </div>
          
          <div class="flex items-baseline gap-1 py-4 border-b border-border/60">
            <span class="text-4xl font-extrabold font-heading text-text">$0</span>
            <span class="text-xs text-muted">/ forever</span>
          </div>

          <a href={ext.data.storeUrl} target="_blank" rel="noopener noreferrer" class="border border-border hover:bg-surface text-text py-3 rounded-lg font-semibold text-center text-xs transition-colors">
            Install Free Extension
          </a>

          <div class="flex flex-col gap-3">
            <span class="text-[10px] font-mono uppercase tracking-wider text-muted font-bold">Included Features</span>
            <ul class="flex flex-col gap-2.5 text-xs text-muted">
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>Unlimited anonymous story viewing</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>Download standard stories & posts</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>100% Client-side sandbox execution</span>
              </li>
              <li class="flex items-center gap-2 text-muted/50 line-through">
                <Icon name="XCircle" class="w-4 h-4 text-muted/40" />
                <span>One-click bulk profile downloader</span>
              </li>
              <li class="flex items-center gap-2 text-muted/50 line-through">
                <Icon name="XCircle" class="w-4 h-4 text-muted/40" />
                <span>High-resolution 4K media saving</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Pro Plan (Spotlight) -->
        <div class="bg-surface border-2 border-accent rounded-2xl p-8 flex flex-col gap-6 shadow-md relative">
          <span class="absolute -top-3.5 right-6 bg-accent text-white px-3 py-1 rounded-full text-[10px] font-bold font-mono uppercase tracking-wider">Most Popular</span>
          <div class="flex flex-col gap-2">
            <h3 class="text-lg font-bold text-text">StoryPeek Pro</h3>
            <p class="text-xs text-muted">Complete control over media downloads and browsing automation.</p>
          </div>
          
          <div class="flex items-baseline gap-1 py-4 border-b border-border/60">
            <span class="text-4xl font-extrabold font-heading text-text">$12.99</span>
            <span class="text-xs text-muted">/ one-time lifetime payment</span>
          </div>

          <a href="https://lemon-squeezy-mock-checkout.com" target="_blank" rel="noopener noreferrer" class="bg-accent hover:bg-accent-hover text-white py-3 rounded-lg font-semibold text-center text-xs transition-colors shadow-sm">
            Upgrade to Pro Now
          </a>

          <div class="flex flex-col gap-3">
            <span class="text-[10px] font-mono uppercase tracking-wider text-muted font-bold">Everything in Free, plus:</span>
            <ul class="flex flex-col gap-2.5 text-xs text-muted">
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span><strong>Bulk Downloader:</strong> Download all stories/posts at once</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span><strong>High-Resolution CDN:</strong> Pull original uncompressed source</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>Auto-downloads for targeted content authors</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>Multi-profile support (use on up to 3 browser profiles)</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="CheckCircle" class="w-4 h-4 text-accent" />
                <span>Lifetime free updates & priority support ticket queue</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 pt-8 border-t border-border/60 text-left mb-24">
        <div class="flex items-start gap-3">
          <Icon name="ShieldCheck" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
          <div>
            <h4 class="text-xs font-bold text-text mb-1">30-Day Money-Back</h4>
            <p class="text-[11px] text-muted leading-relaxed">No questions asked refund if you're not fully satisfied with Pro features.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="Lock" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
          <div>
            <h4 class="text-xs font-bold text-text mb-1">Secure Transaction</h4>
            <p class="text-[11px] text-muted leading-relaxed">Payments processed securely via LemonSqueezy using SSL encryption.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="RefreshCw" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
          <div>
            <h4 class="text-xs font-bold text-text mb-1">Lifetime Free Updates</h4>
            <p class="text-[11px] text-muted leading-relaxed">One-time payment handles all future Instagram layouts adjustments.</p>
          </div>
        </div>
      </div>

      <!-- Pricing FAQ -->
      <div class="max-w-3xl mx-auto text-left">
        <h2 class="text-h2 text-text text-center mb-8">Pricing FAQ</h2>
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-1.5">
            <h4 class="font-bold text-text text-sm">Is this really a one-time purchase?</h4>
            <p class="text-xs text-muted leading-relaxed">
              Yes. You pay $12.99 once and you own the license key forever. There are no recurring monthly charges, subscriptions, or hidden maintenance costs.
            </p>
          </div>
          <div class="flex flex-col gap-1.5">
            <h4 class="font-bold text-text text-sm">Can I use one license key on multiple computers?</h4>
            <p class="text-xs text-muted leading-relaxed">
              Each license key is intended for personal use and can be activated on up to **3 separate browser profiles** or computers (e.g. your home PC, work laptop, and secondary browser profile).
            </p>
          </div>
          <div class="flex flex-col gap-1.5">
            <h4 class="font-bold text-text text-sm">How do I receive my license key?</h4>
            <p class="text-xs text-muted leading-relaxed">
              Immediately after checkout completes, LemonSqueezy displays your license key on the checkout thank-you screen and emails a copy to your checkout email.
            </p>
          </div>
          <div class="flex flex-col gap-1.5">
            <h4 class="font-bold text-text text-sm">What payment options do you support?</h4>
            <p class="text-xs text-muted leading-relaxed">
              Our merchant processor, LemonSqueezy, supports major credit cards (Visa, Mastercard, AMEX), Apple Pay, Google Pay, and PayPal depending on your country.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
