---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${ext.data.title} Terms of Service`}
  description={`Read the dedicated Terms of Service and user license agreement for the ${ext.data.title} browser extension.`}
>
  <section class="py-24 bg-bg">
    <div class="max-w-3xl mx-auto px-6 text-left">
      <!-- Back Link -->
      <a href={`/extensions/${slug}`} class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-8 uppercase tracking-wider">
        <Icon name="ArrowLeft" class="w-4 h-4" />
        Back to {ext.data.title} Landing Page
      </a>

      <div class="flex flex-col gap-4 mb-12">
        <div class="inline-flex items-center gap-2 text-mono text-xs text-muted">
          <span>Extension Specific Terms</span>
          <span>&bull;</span>
          <span>Version {ext.data.version}</span>
        </div>
        <h1 class="text-h1 text-text">
          {ext.data.title} Terms of Service
        </h1>
        <p class="text-mono text-xs text-muted">Last Updated: June 28, 2026</p>
      </div>

      <div class="prose prose-stone leading-relaxed text-muted flex flex-col gap-6 text-base">
        <p class="text-body text-muted">
          These Terms of Service apply specifically to the installation, activation, and usage of the **{ext.data.title}** browser extension published by BramLabs.
        </p>

        <h2 class="text-h2 text-text mt-6">1. Local Execution & Account Responsibility</h2>
        <p class="text-body text-muted">
          {ext.data.title} runs entirely on your local machine and utilizes your active browser sessions. We do not provide, host, or control the target website APIs (such as Instagram). By using {ext.data.title}, you acknowledge that you are using your own credentials and sessions, and agree to hold BramLabs harmless from any account restrictions, blocks, or compliance flags issued by target websites.
        </p>

        <h2 class="text-h2 text-text mt-6">2. License Key Activation & Pro Features</h2>
        <p class="text-body text-muted">
          Pro features of {ext.data.title} are unlocked via a valid license key issued upon purchase. 
        </p>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body text-muted">
          <li><strong>Personal License:</strong> Each license key is intended for use by a single user across their personal browser profiles (up to 3 profiles).</li>
          <li><strong>Fair Use:</strong> Automated distribution, publishing of keys, or heavy proxy-bypassing via license scripts is strictly prohibited and will result in key termination without refund.</li>
          <li><strong>Zero Tracking:</strong> The activation system verifies license keys via simple cryptographic hashes. No personal identifiers, browsing history, or host activities are tracked or transmitted.</li>
        </ul>

        <h2 class="text-h2 text-text mt-6">3. Third-Party API Changes & Disclaimers</h2>
        <p class="text-body text-muted">
          Because {ext.data.title} interfaces directly with web-based platforms, major updates to host platform scripts can occasionally disrupt extension functionality. We strive to release hotfixes within 24-48 hours. However, we make no guarantees of perpetual compatibility in the event of permanent API deprecation or platform changes.
        </p>

        <h2 class="text-h2 text-text mt-6">4. Intellectual Property</h2>
        <p class="text-body text-muted">
          While the source code is public and open for audit on GitHub, the brand names **BramLabs**, **StoryPeek**, and matching assets are trademarked and cannot be repackaged, resold, or redistributed on app stores without express permission.
        </p>

        <h2 class="text-h2 text-text mt-6">5. Refunds & Support</h2>
        <p class="text-body text-muted">
          We offer a **30-day money-back guarantee** if {ext.data.title} does not function correctly on your system. To request troubleshooting support or refunds, please email: 
          <a href="mailto:support@bramlabs.co" class="text-accent hover:underline font-medium">support@bramlabs.co</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    font-family: var(--font-heading);
  }
  .prose p {
    color: var(--color-muted);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    color: var(--color-text);
  }
</style>
