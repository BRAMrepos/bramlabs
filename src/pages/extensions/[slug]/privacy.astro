---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${ext.data.title} Privacy Policy`}
  description={`Read the dedicated privacy policy for the ${ext.data.title} browser extension.`}
>
  <section class="py-24 bg-bg">
    <div class="max-w-3xl mx-auto px-6 text-left">
      <!-- Back Link -->
      <a href={`/extensions/${slug}`} class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-8 uppercase tracking-wider">
        <Icon name="ArrowLeft" class="w-4 h-4" />
        Back to {ext.data.title} Landing Page
      </a>

      <div class="flex flex-col gap-4 mb-12">
        <div class="inline-flex items-center gap-2 text-mono text-xs text-muted">
          <span>Extension Specific Policy</span>
          <span>&bull;</span>
          <span>Version {ext.data.version}</span>
        </div>
        <h1 class="text-h1 text-text">
          {ext.data.title} Privacy Policy
        </h1>
        <p class="text-mono text-xs text-muted">Last Updated: June 25, 2026</p>
      </div>

      <div class="prose prose-stone leading-relaxed text-muted flex flex-col gap-6 text-base">
        <p class="text-body text-muted">
          This policy applies specifically to the **{ext.data.title}** browser extension published by BramLabs on the Chrome Web Store, Firefox Add-ons, and other browser registries.
        </p>

        <h2 class="text-h2 text-text mt-6">1. Dedicated Data Practice Statement</h2>
        <p class="text-body text-muted">
          Unlike modern commercial extensions, **{ext.data.title}** is designed to operate 100% locally on your computer. 
        </p>
        <div class="bg-surface border border-border rounded-xl p-5 flex items-start gap-3 my-2 shadow-sm">
          <Icon name="ShieldAlert" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
          <p class="text-small text-muted">
            <strong>No Data Collection:</strong> We do not collect, transmit, upload, or process any of your personal data, browser tabs, URLs, or browsing history. Zero bytes of analytics data are transmitted to third parties or to BramLabs.
          </p>
        </div>

        <h2 class="text-h2 text-text mt-6">2. Requested Permissions & Why They Are Needed</h2>
        <p class="text-body text-muted">
          To perform its utilities, {ext.data.title} requests the minimum browser permissions. Here is exactly what is requested and how it is used:
        </p>
        
        {slug === 'tab-snoozer' ? (
          <ul class="list-disc pl-6 flex flex-col gap-2 text-body text-muted">
            <li><strong>`tabs` permission:</strong> Needed to retrieve the title and URL of the active tab when you trigger a snooze action, and to open the tab when it wakes up.</li>
            <li><strong>`alarms` permission:</strong> Needed to schedule local background alarms that trigger when a tab is scheduled to wake up.</li>
            <li><strong>`storage` permission:</strong> Needed to save the title, URL, and wake-up timestamp of your snoozed tabs locally in your browser's secure cache.</li>
          </ul>
        ) : (
          <ul class="list-disc pl-6 flex flex-col gap-2 text-body text-muted">
            <li><strong>`declarativeNetRequest` permission & Host Permissions:</strong> Needed to intercept and filter network request headers locally on Instagram domains. This blocks the telemetry headers that report seen receipts to Instagram, ensuring anonymous viewing.</li>
            <li><strong>`downloads` permission:</strong> Needed to save media files (stories, reels, posts, and profile media) directly to your local downloads folder.</li>
            <li><strong>`storage` permission:</strong> Needed to save local settings (e.g. dark mode state, local view counts) inside your browser sandbox.</li>
            <li><strong>`scripting` permission:</strong> Needed to inject the client-side blocking scripts locally on Instagram pages to prevent view receipt tracking.</li>
            <li><strong>`tabs` permission:</strong> Needed to detect when you are on Instagram pages to enable the media detector scanner.</li>
          </ul>
        )}

        <h2 class="text-h2 text-text mt-6">3. Storage Practices</h2>
        <p class="text-body text-muted">
          All configurations, lists, and metadata are saved using the browser's `chrome.storage.local` API. This storage is sandbox-isolated and protected by the browser's security architecture. It cannot be accessed by other websites or extensions, and is deleted completely if you uninstall the extension.
        </p>

        <h2 class="text-h2 text-text mt-6">4. Compliance & Review</h2>
        <p class="text-body text-muted">
          This extension conforms to the Chrome Web Store Developer Program Policies, including the User Data Privacy guidelines. The source code is publicly accessible on GitHub, allowing full audit transparency.
        </p>

        <h2 class="text-h2 text-text mt-6">5. Contact & Support</h2>
        <p class="text-body text-muted">
          For questions or technical support regarding this specific extension's data practices, please email:
          <a href="mailto:privacy@bramlabs.co" class="text-accent hover:underline font-semibold">privacy@bramlabs.co</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Markdown subcontent rendering */
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    font-family: var(--font-heading);
  }
  .prose p {
    color: var(--color-muted);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    color: var(--color-text);
  }
</style>
