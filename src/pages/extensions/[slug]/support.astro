---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const extensions = await getCollection('extensions');
  return extensions.map((ext) => ({
    params: { slug: ext.slug },
    props: { ext },
  }));
}

const { ext } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${ext.data.title} Support & Help Desk`}
  description={`Got questions or issues with the ${ext.data.title} extension? Access documentation, troubleshooting, and direct support.`}
>
  <section class="py-24 bg-bg">
    <div class="max-w-6xl mx-auto px-6 text-left">
      <!-- Back Link -->
      <a href={`/extensions/${slug}`} class="inline-flex items-center gap-1.5 text-mono text-xs text-muted hover:text-text transition-colors mb-8 uppercase tracking-wider">
        <Icon name="ArrowLeft" class="w-4 h-4" />
        Back to {ext.data.title} Landing Page
      </a>

      <!-- Header Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        <!-- Left: FAQ & Troubleshooting -->
        <div class="lg:col-span-7 flex flex-col gap-12">
          <div>
            <h1 class="text-h1 text-text leading-tight mb-4">
              StoryPeek Support
            </h1>
            <p class="text-body text-muted">
              We're here to assist. Find answers to common questions and resolve technical issues immediately. Average response time for support tickets: <strong>within 24 hours</strong>.
            </p>
          </div>

          <!-- Troubleshooting Guide -->
          <div class="flex flex-col gap-6">
            <h2 class="text-h2 text-text">Common Troubleshooting Checklist</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-surface border border-border rounded-xl p-5 flex flex-col gap-2">
                <h4 class="font-bold text-text text-sm flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-red-500"></span>
                  Stories Not Loading
                </h4>
                <p class="text-xs text-muted leading-relaxed">
                  Make sure you are logged into Instagram on your active browser tab. StoryPeek operates client-side and requires your active session to fetch stories.
                </p>
              </div>
              <div class="bg-surface border border-border rounded-xl p-5 flex flex-col gap-2">
                <h4 class="font-bold text-text text-sm flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
                  License Code Fails
                </h4>
                <p class="text-xs text-muted leading-relaxed">
                  Ensure you copy the entire key string from your checkout receipt without leading or trailing spaces. Copying partial tokens will report invalid states.
                </p>
              </div>
              <div class="bg-surface border border-border rounded-xl p-5 flex flex-col gap-2">
                <h4 class="font-bold text-text text-sm flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                  Downloads Failing
                </h4>
                <p class="text-xs text-muted leading-relaxed">
                  Check if your browser has downloads permissions enabled for StoryPeek. If blocked, check Chrome’s privacy & security settings to allow local saving.
                </p>
              </div>
              <div class="bg-surface border border-border rounded-xl p-5 flex flex-col gap-2">
                <h4 class="font-bold text-text text-sm flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Popup UI Glitches
                </h4>
                <p class="text-xs text-muted leading-relaxed">
                  Instagram updates its web layouts regularly. Simply reload the tab, reopen the extension popup, or check the Chrome Web Store for the latest hotfix.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="flex flex-col gap-6">
            <h2 class="text-h2 text-text">Frequently Asked Questions</h2>
            <div class="flex flex-col gap-4">
              {ext.data.faq.map((faqItem, idx) => (
                <details class="group bg-surface border border-border rounded-xl p-4 transition-all duration-200 outline-none select-none">
                  <summary class="font-semibold text-sm text-text cursor-pointer flex items-center justify-between list-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                    <span>{faqItem.question}</span>
                    <span class="text-muted group-open:rotate-180 transition-transform duration-200">&darr;</span>
                  </summary>
                  <p class="mt-3 text-xs text-muted leading-relaxed border-t border-border/40 pt-3 select-text">
                    {faqItem.answer}
                  </p>
                </details>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Support Contact Form -->
        <div class="lg:col-span-5 w-full sticky top-24">
          <div class="bg-surface border border-border rounded-2xl p-6 shadow-sm flex flex-col gap-5">
            <div>
              <h3 class="text-lg font-bold text-text mb-1">Submit a Support Ticket</h3>
              <p class="text-xs text-muted">
                Need more help? Send our dev team a direct query. We'll respond shortly.
              </p>
            </div>

            <!-- Form -->
            <form id="support-form" class="flex flex-col gap-4 text-xs">
              <div class="flex flex-col gap-1.5">
                <label for="name" class="font-semibold text-text">Name</label>
                <input
                  type="text"
                  id="name"
                  required
                  placeholder="Enter your name"
                  class="bg-surface-2 border border-border rounded-lg px-3 py-2.5 text-text focus:outline-none focus:border-accent text-xs"
                />
              </div>
              
              <div class="flex flex-col gap-1.5">
                <label for="email" class="font-semibold text-text">Email Address</label>
                <input
                  type="email"
                  id="email"
                  required
                  placeholder="yourname@email.com"
                  class="bg-surface-2 border border-border rounded-lg px-3 py-2.5 text-text focus:outline-none focus:border-accent text-xs"
                />
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="subject" class="font-semibold text-text">How can we help?</label>
                <select
                  id="subject"
                  class="bg-surface-2 border border-border rounded-lg px-3 py-2.5 text-text focus:outline-none focus:border-accent text-xs"
                >
                  <option>License & Pro Activation Support</option>
                  <option>Bug Report or Technical Issue</option>
                  <option>Feature Request / Feedback</option>
                  <option>Refund Request</option>
                  <option>Other Query</option>
                </select>
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="message" class="font-semibold text-text">Message Details</label>
                <textarea
                  id="message"
                  required
                  rows="4"
                  placeholder="Explain your problem or request in detail..."
                  class="bg-surface-2 border border-border rounded-lg px-3 py-2.5 text-text focus:outline-none focus:border-accent text-xs resize-none"
                ></textarea>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                class="bg-accent hover:bg-accent-hover text-white py-3 rounded-lg font-semibold transition-colors focus:outline-none cursor-pointer text-xs"
              >
                Send Message
              </button>
            </form>

            <!-- Success Notification -->
            <div id="form-success" class="hidden bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200/40 dark:border-emerald-900/30 rounded-xl p-4 text-xs text-emerald-800 dark:text-emerald-400 flex items-start gap-2.5 leading-relaxed">
              <Icon name="ShieldCheck" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5" />
              <div>
                <p class="font-bold">Ticket Submitted Successfully!</p>
                <p class="mt-1">We have received your ticket. A developer will review it and reply within 24 hours to your provided email address.</p>
              </div>
            </div>

            <div class="border-t border-border pt-4 text-center">
              <p class="text-[11px] text-muted">
                Or email us directly: <a href="mailto:support@bramlabs.co" class="text-accent hover:underline">support@bramlabs.co</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script for form submission handling -->
  <script is:inline>
    (function() {
      const form = document.getElementById('support-form');
      const successMsg = document.getElementById('form-success');
      if (form && successMsg) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
        });
      }
    })();
  </script>
</BaseLayout>
