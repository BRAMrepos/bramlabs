---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');
---

<BaseLayout
  title="Extensions"
  description="BramLabs Chrome extensions: StoryPeek, SnapElite, and SonicShield — focused utilities with full privacy, help, and support pages."
>
  <section class="py-20 bg-bg">
    <div class="max-w-6xl mx-auto px-6 text-left">
      <div class="max-w-2xl flex flex-col gap-4 mb-16">
        <span class="text-mono text-xs text-accent uppercase tracking-wider font-semibold">Chrome Web Store</span>
        <h1 class="text-h1 text-text">Extensions</h1>
        <p class="text-body text-muted">
          Focused browser utilities from BramLabs. Each product has its own landing page, privacy policy, terms, help, and support.
        </p>
      </div>

      <!-- Directory Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {extensions.map((ext) => (
          <div class="bg-surface rounded-2xl border border-border/80 p-8 flex flex-col justify-between shadow-sm glow-card text-left relative overflow-hidden">
            <div class="absolute -right-20 -bottom-20 w-36 h-36 rounded-full bg-accent/3 blur-3xl pointer-events-none"></div>
            <div>
              <!-- Header -->
              <div class="flex items-center justify-between border-b border-border/50 pb-6 mb-6">
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent flex-shrink-0">
                    <Icon name={ext.data.icon} class="w-7 h-7 text-accent" />
                  </div>
                  <div>
                    <h2 class="text-h3 text-text leading-tight">{ext.data.title}</h2>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-mono text-xs text-muted">v{ext.data.version}</span>
                    </div>
                  </div>
                </div>
                <span class="text-mono text-[10px] px-2.5 py-0.5 rounded-full bg-accent-muted text-accent font-semibold border border-accent/10">Verified Utility</span>
              </div>

              <!-- Tagline -->
              <p class="text-small text-muted leading-relaxed mb-8">
                {ext.data.description}
              </p>

              <!-- Features checklist -->
              <div class="flex flex-col gap-3 mb-8">
                <h3 class="text-mono text-xs font-bold text-text tracking-wider uppercase mb-1">Key Features</h3>
                {ext.data.features.map((feat) => (
                  <div class="flex items-start gap-2.5 text-sm text-muted">
                    <div class="mt-0.5 text-accent flex-shrink-0">
                      <Icon name="Check" class="w-4 h-4 text-accent" />
                    </div>
                    <span><strong class="text-text">{feat.title}:</strong> {feat.description}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTAs -->
            <div class="border-t border-border/50 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 mt-auto">
              <a href={`/extensions/${ext.slug}`} class="text-accent hover:underline text-sm font-semibold flex items-center gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none">
                View Landing Page
                <Icon name="ArrowRight" class="w-4 h-4" />
              </a>
              <a
                href={ext.data.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-border text-text hover:bg-bg text-sm px-5 py-2.5 rounded-lg transition-colors font-semibold shadow-sm w-full sm:w-auto text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
              >
                Add to Chrome
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
