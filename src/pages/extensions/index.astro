---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');
---

<BaseLayout
  title="Browser Extensions"
  description="Focused Chrome extensions built by BramLabs — SonicShield, SnapElite, Tab Snoozer, PromptVault, and more. Local-first privacy, clear terms, and zero telemetry."
>
  <section class="section-block pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-12 reveal" data-reveal>
        <span class="badge badge-sky text-xs font-mono mb-3">Chrome Web Store</span>
        <h1 class="mb-4">Browser Extensions</h1>
        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          Focused tools built directly for modern web browsers. Each extension features local-first processing, dedicated privacy documentation, and zero background telemetry.
        </p>
      </div>

      <!-- Directory Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {extensions.map((ext, i) => (
          <div
            class="glass-card flex flex-col justify-between p-8 reveal"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <div>
              <!-- Header -->
              <div class="flex items-start justify-between gap-4 pb-6 border-b border-white/[0.06] mb-6">
                <div class="flex items-center gap-3.5">
                  <div class="w-12 h-12 rounded-xl bg-sky-400/10 border border-sky-400/20 flex items-center justify-center text-sky-400 flex-shrink-0">
                    <Icon name={ext.data.icon} class="w-6 h-6 text-sky-400" />
                  </div>
                  <div>
                    <h2 class="text-lg font-bold text-[var(--text-primary)] leading-tight">{ext.data.title}</h2>
                    <span class="text-xs font-mono text-[var(--text-faint)]">v{ext.data.version} · {ext.data.lastUpdated}</span>
                  </div>
                </div>
                <span class={`badge text-[10px] font-mono ${ext.data.status === 'live' ? 'badge-emerald' : 'badge-amber'}`}>
                  {ext.data.status === 'live' ? 'Live' : 'Coming Soon'}
                </span>
              </div>

              <!-- Tagline -->
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
                {ext.data.description}
              </p>

              <!-- Key Features -->
              {ext.data.features && ext.data.features.length > 0 && (
                <div class="flex flex-col gap-2.5 mb-8">
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--text-faint)]">Key Features</span>
                  {ext.data.features.slice(0, 3).map((feat) => (
                    <div class="flex items-start gap-2.5 text-xs text-[var(--text-muted)]">
                      <Icon name="Check" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0 mt-0.5" />
                      <span><strong class="text-[var(--text-primary)] font-medium">{feat.title}:</strong> {feat.description}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- CTAs -->
            <div class="pt-5 border-t border-white/[0.06] flex items-center justify-between gap-3 mt-auto">
              <a
                href={`/extensions/${ext.slug}`}
                class="text-sky-400 hover:text-sky-300 text-xs font-semibold flex items-center gap-1.5 transition-colors"
              >
                Product Details →
              </a>
              {ext.data.storeUrl ? (
                <a
                  href={ext.data.storeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary text-xs px-3.5 py-1.5"
                  style="min-height:2rem;"
                >
                  Chrome Store
                </a>
              ) : (
                <span class="text-[10px] font-mono text-[var(--text-faint)] px-2.5 py-1 rounded bg-white/[0.04]">
                  In Review
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
