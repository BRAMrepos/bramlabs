---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedSoftware } from "@/data/software";

const products = getPublishedSoftware();

const amazonProducts = products.filter((p) => p.platform === "Amazon Appstore");
const chromeProducts = products.filter((p) => p.platform === "Chrome Web Store");
const webProducts = products.filter((p) => p.platform === "Web");

const platformGroups = [
  { name: "Amazon Appstore", items: amazonProducts },
  { name: "Chrome Web Store", items: chromeProducts },
  { name: "Web Products", items: webProducts },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Studio — BramLabs"
  description="Independent software from BramLabs — live apps and browser utilities with public storefronts only."
>
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <p class="eyebrow">Studio credentials</p>
        <h1 class="h-page">Independent software from BramLabs</h1>
        <p class="lede">
          Live apps and browser tools with public storefronts only. Apparel graphics live in the <a href="/collection/" class="inline-link">Collection</a>.
        </p>
      </header>

      {
        platformGroups.map((group) => (
          <div class="platform-group">
            <h2 class="h-section group-title">{group.name}</h2>
            <div class="pub-list">
              {group.items.map((p) => (
                <article class="product-card">
                  {p.icon ? (
                    <img src={p.icon} alt="" width="64" height="64" class="icon" />
                  ) : (
                    <div class="icon-fallback" aria-hidden="true">
                      <span>{p.title.slice(0, 2).toUpperCase()}</span>
                    </div>
                  )}
                  <div class="card-content">
                    <div class="card-header">
                      <h3 class="h-card">{p.title}</h3>
                      <span class="platform-badge">{p.platform}</span>
                    </div>
                    <p class="desc">{p.longDescription || p.description}</p>
                    {p.bullets && (
                      <ul class="bullets">
                        {p.bullets.map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    )}
                    <div class="links">
                      {p.externalUrl && (
                        <a
                          href={p.externalUrl}
                          class="btn -primary"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          View public listing ↗
                        </a>
                      )}
                      {p.supportUrl && (
                        <a href={p.supportUrl} class="btn -ghost">
                          Support
                        </a>
                      )}
                      {p.privacyUrl && (
                        <a href={p.privacyUrl} class="btn -ghost">
                          Privacy
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }

      <div class="apparel-strip">
        <div>
          <h2 class="h-card">Original apparel graphics</h2>
          <p class="body muted">
            BramLabs also designs technical vector illustration and typographic apparel graphics for developers, shift workers, and focused minds.
          </p>
        </div>
        <div class="strip-actions">
          <a href="/collection/" class="btn -primary">Explore Collection</a>
          <a href="/process/" class="btn -ghost">See Process</a>
        </div>
      </div>

      <div class="ops">
        <h2 class="h-card">Operational links</h2>
        <ul class="ops-list">
          <li><a href="/contact/">Contact studio</a></li>
          <li><a href="/privacy/">Sitewide Privacy Policy</a></li>
          <li><a href="mailto:support@bramlabs.co">support@bramlabs.co</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-head {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: var(--s-7);

    .inline-link {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .platform-group {
    margin-bottom: var(--s-7);

    &:last-of-type {
      margin-bottom: var(--s-6);
    }
  }

  .group-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--s-4);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .pub-list {
    display: grid;
    gap: var(--s-4);
  }

  .product-card {
    display: grid;
    gap: 1.25rem;
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);

    @media (width >= 640px) {
      grid-template-columns: auto 1fr;
    }
  }

  .icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    object-fit: cover;
    background: var(--canvas);
  }

  .icon-fallback {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: color-mix(in oklab, var(--ink) 8%, var(--canvas));
    border: 1px solid var(--line);
    display: grid;
    place-content: center;

    span {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--ink);
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }

  .platform-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--canvas);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .desc {
    color: var(--muted);
    font-size: 0.975rem;
    line-height: 1.6;
    max-width: 44rem;
  }

  .bullets {
    margin: 0.85rem 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;

    li {
      font-size: 0.925rem;
      color: var(--muted);
      padding-left: 1rem;
      position: relative;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ink);
      }
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: auto;
  }

  .apparel-strip {
    margin-top: var(--s-7);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--canvas);
    display: grid;
    gap: var(--s-4);

    @media (width >= 800px) {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    h2 {
      margin-bottom: 0.35rem;
    }

    .body {
      font-size: 0.95rem;
      max-width: 36rem;
    }
  }

  .strip-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ops {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);

    h2 {
      margin-bottom: 0.75rem;
      font-size: 1rem;
    }
  }

  .ops-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;

    a {
      color: var(--muted);
      font-size: 0.925rem;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color var(--t);

      &:hover {
        color: var(--ink);
      }
    }
  }
</style>
