---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getPublishedSoftware,
  getInDevelopmentSoftware,
} from "@/data/software";

const products = getPublishedSoftware();
const inDev = getInDevelopmentSoftware();
---

<BaseLayout
  title="Studio — BramLabs"
  description="Independent software from BramLabs: focused applications, browser utilities and web products."
>
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <h1 class="h-page">Independent software from BramLabs</h1>
        <p class="lede">
          Focused applications, browser utilities and web products designed and
          published by the studio. Public listings appear only when a real
          storefront URL exists.
        </p>
      </header>

      <h2 class="h-card block-title">Published products</h2>
      <div class="pub-list">
        {
          products.map((p) => (
            <article class="product-card">
              {p.icon && (
                <img src={p.icon} alt="" width="72" height="72" class="icon" />
              )}
              <div>
                <p class="meta">{p.platform}</p>
                <h3 class="h-card">{p.title}</h3>
                <p class="desc">{p.longDescription || p.description}</p>
                {p.bullets && (
                  <ul class="bullets">
                    {p.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                <div class="links">
                  {p.externalUrl && (
                    <a
                      href={p.externalUrl}
                      class="btn -primary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      View public listing
                    </a>
                  )}
                  {p.supportUrl && (
                    <a href={p.supportUrl} class="btn -link">
                      Support
                    </a>
                  )}
                  {p.privacyUrl && (
                    <a href={p.privacyUrl} class="btn -link">
                      Privacy
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {
        inDev.length > 0 && (
          <div class="dev">
            <h2 class="h-card">In development</h2>
            <p class="body intro">
              These products keep support and privacy documentation online for
              store requirements. They are not shown as public storefront listings
              until an external URL is live.
            </p>
            <ul class="dev-list">
              {inDev.map((p) => (
                <li>
                  <div>
                    <h3>{p.title}</h3>
                    <p>{p.description}</p>
                    <p class="meta">{p.platform} · in development</p>
                  </div>
                  <div class="links">
                    {p.supportUrl && (
                      <a href={p.supportUrl} class="btn -link">
                        Support
                      </a>
                    )}
                    {p.privacyUrl && (
                      <a href={p.privacyUrl} class="btn -link">
                        Privacy
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="ops">
        <h2 class="h-card">Operational links</h2>
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="mailto:support@bramlabs.co">support@bramlabs.co</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-head {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .block-title {
    margin-bottom: 1rem;
  }
  .product-card {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--canvas);
    margin-bottom: 1.5rem;
    @media (width >= 720px) {
      grid-template-columns: auto 1fr;
    }
  }
  .icon {
    width: 72px;
    height: 72px;
    border-radius: 18px;
  }
  .desc {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: 40rem;
  }
  .bullets {
    margin: 1rem 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    li {
      font-size: 0.95rem;
      color: var(--muted);
      padding-left: 1rem;
      position: relative;
      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--cyan);
      }
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .dev {
    margin: 3rem 0;
  }
  .intro {
    margin: 0.75rem 0 1.25rem;
    color: var(--muted);
  }
  .dev-list {
    border-top: 1px solid var(--line);
    li {
      display: grid;
      gap: 1rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--line);
      @media (width >= 800px) {
        grid-template-columns: 1fr auto;
        align-items: center;
      }
      h3 {
        font-size: 1.1rem;
        font-weight: 500;
      }
      p {
        color: var(--muted);
        margin-top: 0.25rem;
        font-size: 0.95rem;
      }
    }
  }
  .ops {
    margin-top: 2rem;
    a {
      color: var(--muted);
      text-decoration: underline;
      text-underline-offset: 3px;
      display: inline-block;
      padding: 0.25rem 0;
    }
  }
</style>
