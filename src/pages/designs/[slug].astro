---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignCard from "@/components/DesignCard.astro";
import { designs, getDesign, getRelated } from "@/data/designs";

export function getStaticPaths() {
  return designs.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const design = getDesign(slug!);
if (!design) return Astro.redirect("/collection/");
const related = getRelated(design);
const n = String(design.order).padStart(2, "0");

const isLightShirt = design.shirtColor === "white";

const artworkLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name: design.title,
  description: design.fullDescription,
  image: new URL(design.images.rawArtwork, Astro.site).href,
  creator: { "@type": "Person", name: "Bram" },
  artform: "Apparel graphic / vector illustration",
};

const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://bramlabs.co/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Collection",
      item: "https://bramlabs.co/collection/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: design.title,
      item: new URL(`/designs/${design.slug}/`, Astro.site).href,
    },
  ],
};
---

<BaseLayout
  title={design.seo.title}
  description={design.seo.description}
  image={`/og/design-${design.slug}.png`}
  type="article"
  jsonLd={[artworkLd, crumbs]}
>
  <article class="section">
    <div class="wrap">
      
      {/* Breadcrumbs */}
      <nav class="crumbs meta" aria-label="Breadcrumb">
        <a href="/collection/">Collection</a>
        <span aria-hidden="true">/</span>
        <span>{design.title}</span>
      </nav>

      {/* Header Meta Badges */}
      <div class="header-meta">
        <span class="meta-tag">{n} / {design.category}</span>
        <span class:list={["shirt-badge", { "light-badge": isLightShirt }]}>
          {design.shirtColor === "white" ? "Studio White Tee" : design.shirtColor === "navy" ? "Midnight Navy Tee" : "Master Black Tee"}
        </span>
      </div>

      <h1 class="h-page">{design.title}</h1>
      <p class="lede">{design.shortDescription}</p>

      {/* Hero Gallery Grid */}
      <div class="hero-gallery">
        
        {/* Garment Mockup Card */}
        <div class="card-hero mockup-card">
          <div class="card-canvas">
            <picture>
              <source srcset={design.images.primaryMockup.replace(/\.jpg$/, ".webp")} type="image/webp" />
              <img
                src={design.images.primaryMockup}
                alt={`${design.shirtColor} T-shirt featuring the ${design.title} graphic`}
                width="800"
                height="1000"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          </div>
          <div class="card-footer">
            <span class="card-label">01 / Garment Application</span>
            <span class="card-val">{design.application}</span>
          </div>
        </div>

        {/* Vector Art & Detail Panels */}
        <div class="side-panel-grid">
          
          {/* Raw Artwork Panel */}
          <div class:list={["card-side", { "light-theme": isLightShirt, "dark-theme": !isLightShirt }]}>
            <div class="card-canvas">
              <img
                src={design.images.rawArtwork}
                alt={`${design.title} raw vector artwork`}
                width="800"
                height="800"
                loading="eager"
              />
            </div>
            <div class="card-footer">
              <span class="card-label">02 / Vector Artwork</span>
              <span class="card-val">1024 × 1024 SVG</span>
            </div>
          </div>

          {/* Print Detail Crop Panel */}
          <div class:list={["card-side", { "light-theme": isLightShirt, "dark-theme": !isLightShirt }]}>
            <div class="card-canvas">
              <img
                src={design.images.detail}
                alt={`${design.title} print detail crop`}
                width="800"
                height="800"
                loading="eager"
              />
            </div>
            <div class="card-footer">
              <span class="card-label">03 / Print Detail</span>
              <span class="card-val">Chest Scale Crop</span>
            </div>
          </div>

        </div>

      </div>

      {/* Concept & Specifications Breakdown Grid */}
      <div class="detail-grid">
        
        {/* Concept Column */}
        <section class="spec-section">
          <h2 class="h-card">The Concept</h2>
          <p class="body-text">{design.fullDescription}</p>
          {
            design.conceptExtra?.map((p) => (
              <p class="body-text extra">{p}</p>
            ))
          }
          {
            design.rejectedNote && (
              <p class="rejected-note">
                <strong>Rejected:</strong> {design.rejectedNote}
              </p>
            )
          }
        </section>

        {/* Technical System Specs Column */}
        <section class="spec-section">
          <h2 class="h-card">Visual System</h2>
          <dl class="sys">
            <div>
              <dt>Visual Language</dt>
              <dd>{design.visualLanguage.join(" • ")}</dd>
            </div>
            <div>
              <dt>Primary Forms</dt>
              <dd>{design.primaryForms.join(" • ")}</dd>
            </div>
            <div>
              <dt>Color Palette</dt>
              <dd>
                <ul class="swatches">
                  {
                    design.palette.map((c) => (
                      <li>
                        <span class="swatch-color" style={`background:${c.hex}`} />
                        <span class="swatch-name">{c.name}</span>
                        <code class="swatch-code">{c.hex}</code>
                      </li>
                    ))
                  }
                </ul>
              </dd>
            </div>
            <div>
              <dt>Garment Application</dt>
              <dd>{design.application}</dd>
            </div>
            <div>
              <dt>Target Audience</dt>
              <dd>{design.audience.join(", ")}</dd>
            </div>
            {
              design.printNotes && (
                <div>
                  <dt>Print Specification Notes</dt>
                  <dd>{design.printNotes}</dd>
                </div>
              )
            }
          </dl>
        </section>

      </div>

      {/* Process Stages Timeline */}
      {
        design.processStages &&
          design.processStages.length > 0 && (
            <section class="stages-block">
              <h2 class="h-card">Iterative Process</h2>
              <ol class="stages">
                {design.processStages.map((s, i) => (
                  <li>
                    {s.image && (
                      <div class="stage-img-wrap">
                        <img
                          src={s.image}
                          alt={`${design.title}: ${s.label}`}
                          width="640"
                          height="640"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <span class="stage-num">{String(i + 1).padStart(2, "0")}</span>
                    <h3>{s.label}</h3>
                    <p>{s.body}</p>
                  </li>
                ))}
              </ol>
            </section>
          )
      }

      {/* Related Collection Pieces */}
      {
        related.length > 0 && (
          <section class="related">
            <h2 class="h-card">Related Collection Pieces</h2>
            <div class="related-grid">
              {related.map((d) => (
                <DesignCard design={d} />
              ))}
            </div>
          </section>
        )
      }

    </div>
  </article>
</BaseLayout>

<style lang="scss">
  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    a:hover {
      color: var(--ink);
    }
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .shirt-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    background: #1C1F28;
    color: #F4F1E9;
    border: 1px solid rgba(255, 255, 255, 0.1);

    &.light-badge {
      background: #E5DED5;
      color: #1C1917;
      border: 1px solid #D5CBD2;
    }
  }

  .h-page {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    line-height: 1.1;
    font-weight: 700;
    margin-bottom: 0.75rem;

    @media (width >= 768px) {
      font-size: 3.25rem;
    }
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 44rem;
  }

  /* Hero Gallery Grid */
  .hero-gallery {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 3.5rem;

    @media (width >= 900px) {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .side-panel-grid {
    display: grid;
    gap: 1.5rem;
    
    @media (width >= 600px) and (width < 900px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card-hero,
  .card-side {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .card-canvas {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: var(--paper);

    picture {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
    }

    picture > img,
    img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }
  }

  .card-footer {
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .card-val {
    font-weight: 500;
    color: var(--ink);
  }

  /* Dynamic Themes for Vector & Detail Cards */
  .card-side.light-theme {
    .card-canvas {
      background: #FFFFFF;
    }
    .card-footer {
      background: #FAF7F2;
      border-top-color: var(--line);
    }
  }

  .card-side.dark-theme {
    border-color: #2A2E39;
    .card-canvas {
      background: #111318;
    }
    .card-footer {
      background: #1C1F28;
      border-top-color: #2A2E39;
    }
    .card-val {
      color: #F4F1E9;
    }
  }

  /* Concept & Specs Detail Grid */
  .detail-grid {
    display: grid;
    gap: 3rem;
    margin-bottom: 4rem;

    @media (width >= 900px) {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .spec-section {
    .h-card {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }
  }

  .body-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink);

    &.extra {
      margin-top: 1rem;
      color: var(--muted);
    }
  }

  .rejected-note {
    margin-top: 1.25rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--line);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);

    strong {
      color: var(--ink);
      font-weight: 600;
    }
  }

  .sys {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    div {
      border-top: 1px solid var(--line);
      padding-top: 1rem;
    }

    dt {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }

    dd {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--ink);
    }
  }

  .swatches {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9rem;
    }

    .swatch-color {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      border: 1px solid rgba(0, 0, 0, 0.15);
      flex-shrink: 0;
    }

    .swatch-name {
      font-weight: 500;
      min-width: 110px;
    }

    .swatch-code {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--muted);
      background: var(--canvas);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      border: 1px solid var(--line);
    }
  }

  .stages-block {
    margin-bottom: 4rem;
  }

  .stages {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;

    @media (width >= 768px) {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    li {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      border-top: 2px solid var(--line);
      padding-top: 1rem;
    }

    .stage-img-wrap {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--surface);
      margin-bottom: 0.5rem;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 0.75rem;
      }
    }

    .stage-num {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 600;
    }

    h3 {
      font-size: 1.05rem;
      font-weight: 600;
    }

    p {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.5;
    }
  }

  .related {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }

  .related-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;

    @media (width >= 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
