---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('web')).sort((a, b) => Number(b.data.status === 'live') - Number(a.data.status === 'live'));
---

<BaseLayout
  title="Web Applications & Platforms"
  description="Production web products built by BramLabs — WorkflowAI.site, DesignTokens.dev, StackDeck, and high-performance edge applications."
>
  <section class="section-block pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-12 reveal" data-reveal>
        <span class="badge badge-sky text-xs font-mono mb-3">Web Stack &amp; Platforms</span>
        <h1 class="mb-4">Web Applications</h1>
        <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed">
          Full-stack web products built for real traffic, rich content systems, and edge deployment — not superficial landing page templates.
        </p>
      </div>

      <!-- Projects List -->
      <div class="flex flex-col gap-8">
        {projects.map((project, i) => (
          <article
            class="glass-card p-8 md:p-10 flex flex-col gap-6 reveal"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8">
              <div class="flex-grow flex flex-col gap-4">
                <div class="flex items-center gap-3.5 flex-wrap">
                  <div class="w-12 h-12 rounded-xl bg-sky-400/10 border border-sky-400/20 flex items-center justify-center text-sky-400 flex-shrink-0">
                    <Icon name={project.data.icon} class="w-6 h-6 text-sky-400" />
                  </div>
                  <div>
                    <h2 class="text-xl font-bold text-[var(--text-primary)]">{project.data.title}</h2>
                    <span class="text-xs font-mono text-[var(--text-faint)]">{project.data.role} · {project.data.year}</span>
                  </div>
                  {project.data.featured && (
                    <span class="badge badge-sky text-[10px] font-mono ml-auto lg:ml-2">
                      Flagship Platform
                    </span>
                  )}
                </div>

                <p class="text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed">{project.data.description}</p>

                {project.data.highlights && project.data.highlights.length > 0 && (
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 my-2">
                    {project.data.highlights.map((item) => (
                      <li class="flex items-start gap-2.5 text-xs text-[var(--text-muted)]">
                        <Icon name="Check" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0 mt-0.5" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="flex flex-wrap gap-2 pt-2">
                  {project.data.stack.map((tech) => (
                    <span class="text-mono text-[11px] px-2.5 py-1 rounded-md border border-white/[0.08] bg-white/[0.03] text-[var(--text-muted)]">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-col gap-3 flex-shrink-0 w-full lg:w-44 pt-2 lg:pt-0">
                <a
                  href={project.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary text-xs w-full justify-center"
                >
                  Visit Platform ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
