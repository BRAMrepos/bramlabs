---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('web')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
  title="Web"
  description="Web products built by BramLabs — WorkflowAI.site and the studio publisher platform."
>
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl flex flex-col gap-4 mb-16">
        <span class="text-mono text-xs text-accent uppercase tracking-wider font-semibold">Web development</span>
        <h1 class="text-h1 text-text">Sites we ship</h1>
        <p class="text-body text-muted">
          Production web products with real content systems and edge deployment — not landing-page demos.
        </p>
      </div>

      <div class="flex flex-col gap-8">
        {projects.map((project) => (
          <article class="bg-surface border border-border rounded-xl p-8 md:p-10 shadow-sm transition-transform duration-200 hover:translate-y-[-2px]">
            <div class="flex flex-col lg:flex-row lg:items-start gap-8">
              <div class="flex-grow flex flex-col gap-4">
                <div class="flex items-center gap-3 flex-wrap">
                  <div class="w-10 h-10 rounded-lg bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                    <Icon name={project.data.icon} class="w-5 h-5 text-accent" />
                  </div>
                  <h2 class="text-h2 text-text">{project.data.title}</h2>
                  {project.data.featured && (
                    <span class="text-mono text-[10px] px-2.5 py-0.5 rounded-full bg-accent-muted text-accent border border-accent/10 font-semibold">
                      Flagship
                    </span>
                  )}
                </div>
                <p class="text-body text-muted max-w-prose">{project.data.description}</p>
                <p class="text-small text-muted"><span class="text-text font-medium">Role:</span> {project.data.role}</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {project.data.highlights.map((item) => (
                    <li class="flex items-start gap-2 text-small text-muted">
                      <Icon name="Check" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-2 pt-2">
                  {project.data.stack.map((tech) => (
                    <span class="text-mono text-[11px] px-2.5 py-1 rounded-full border border-border text-muted">{tech}</span>
                  ))}
                </div>
              </div>
              <div class="flex flex-col gap-3 flex-shrink-0 w-full lg:w-44">
                <a
                  href={project.data.url}
                  target={project.data.url.startsWith('http') && !project.data.url.includes('bramlabs.co') ? '_blank' : undefined}
                  rel={project.data.url.startsWith('http') && !project.data.url.includes('bramlabs.co') ? 'noopener noreferrer' : undefined}
                  class="bg-accent hover:bg-accent-hover text-white py-3 px-6 rounded-lg font-medium transition-colors text-center text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 outline-none"
                >
                  {project.data.url === 'https://bramlabs.co' || project.data.url === 'https://bramlabs.co/'
                    ? 'You are here'
                    : 'Visit site'}
                </a>
                <span class="text-mono text-xs text-muted text-center lg:text-left">{project.data.year}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
