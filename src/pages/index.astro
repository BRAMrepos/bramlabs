---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');
const apps       = await getCollection('apps');
const web        = await getCollection('web');
const art        = await getCollection('art');

const featuredArt  = art.slice(0, 6);
---

<BaseLayout
  title="BramLabs | Independent Software Studio & IP Developer"
  description="BramLabs is an independent product studio shipping Amazon Appstore apps, Android utilities, Chrome extensions, web platforms, and original merchandise for our own IP."
>

  <!-- ========================================================
       HERO SECTION
       ======================================================== -->
  <section class="section-block pt-12 md:pt-20 pb-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">

        <!-- Left Hero Text -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          <!-- Studio Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.12] bg-white/[0.04] mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono text-[var(--text-secondary)] font-semibold uppercase tracking-wider">Independent Software Studio</span>
          </div>

          <!-- Main Title -->
          <h1 class="mb-6 leading-[1.08]">
            We ship software tools<br class="hidden sm:block" />
            <span class="text-gradient">&amp; original IP merch.</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
            BramLabs builds original mobile applications, browser extensions, and web platforms — extended with print-ready merchandise designed strictly for our own software titles.
          </p>

          <!-- Studio Metrics Counter -->
          <div class="flex flex-wrap gap-y-2 gap-x-5 py-2.5 px-4 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-default)] mb-8 text-xs font-mono text-[var(--text-muted)]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <strong class="text-[var(--text-primary)]">{apps.length}</strong> Mobile Apps
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
              <strong class="text-[var(--text-primary)]">{extensions.length}</strong> Extensions
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <strong class="text-[var(--text-primary)]">{web.length}</strong> Web Sites
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
              <strong class="text-[var(--text-primary)]">{art.length}</strong> Art Marks
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3">
            <a href="/work" class="btn btn-primary">
              Explore Studio Work
            </a>
            <a href="/apps" class="btn btn-secondary">
              Amazon Appstore Apps
            </a>
            <a href="/merch" class="btn btn-ghost text-xs text-sky-400 hover:text-sky-300">
              MBA Portfolio →
            </a>
          </div>
        </div>

        <!-- Right Hero Showcase Matrix Card -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <HeroShowcase />
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================
       TRUST & COMPLIANCE BAR
       ======================================================== -->
  <div class="border-y border-[var(--border-default)] bg-[var(--bg-surface)] py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-xs font-mono text-[var(--text-muted)]">
        <li class="flex items-center gap-2">
          <Icon name="Smartphone" class="w-3.5 h-3.5 text-blue-500 flex-shrink-0" />
          <span>Amazon Appstore Developer</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="Puzzle" class="w-3.5 h-3.5 text-indigo-500 flex-shrink-0" />
          <span>Chrome Web Store Publisher</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="Palette" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
          <span>300 DPI Transparent PNG Masters</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="ShieldCheck" class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" />
          <span>USPTO Trademark Screened</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- ========================================================
       FOUR STUDIO LANES BENTO SECTION
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mb-10">
        <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold block mb-1">Architecture</span>
        <h2 class="text-[var(--text-primary)] mb-2">Four Disciplines</h2>
        <p class="text-[var(--text-muted)] text-sm">Active software products and studio apparel art — all produced in-house.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { href: '/apps',       icon: 'Smartphone', title: 'Mobile Apps',  count: `${apps.length} Titles`,      desc: 'ClearCue, ShiftLedger, Cadence — published on Amazon Appstore & Android.', badge: 'Appstore' },
          { href: '/extensions', icon: 'Puzzle',     title: 'Extensions',   count: `${extensions.length} Tools`, desc: 'SonicShield, SnapElite, Tab Snoozer — Chrome browser utilities.', badge: 'Chrome' },
          { href: '/web',        icon: 'Globe',      title: 'Web Apps',     count: `${web.length} Sites`,        desc: 'WorkflowAI.site, DesignTokens.dev — production web platforms.', badge: 'Web' },
          { href: '/merch',      icon: 'Shirt',      title: 'Art & Merch',  count: `${art.length} Series`,       desc: '300 DPI apparel graphics for our software IP. 100% studio original.', badge: 'MBA-Ready' },
        ].map((lane) => (
          <a
            href={lane.href}
            class="glass-card group flex flex-col justify-between p-6"
          >
            <div>
              <div class="flex items-start justify-between mb-4">
                <div class="w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.1] flex items-center justify-center">
                  <Icon name={lane.icon} class="w-4 h-4 text-blue-500" />
                </div>
                <span class="badge badge-slate text-[10px] font-mono">{lane.badge}</span>
              </div>
              <h3 class="text-[var(--text-primary)] font-bold text-base mb-1 group-hover:text-blue-400 transition-colors">{lane.title}</h3>
              <p class="text-xs font-mono text-[var(--text-faint)] mb-2.5">{lane.count}</p>
              <p class="text-[var(--text-muted)] text-xs leading-relaxed">{lane.desc}</p>
            </div>
            <span class="text-xs font-semibold text-[var(--text-primary)] mt-6 flex items-center gap-1 group-hover:gap-2 transition-all">
              Explore {lane.title} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       APPS SHOWCASE
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-default)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold block mb-1">Amazon Appstore &amp; Android</span>
          <h2 class="text-[var(--text-primary)]">Mobile Applications</h2>
        </div>
        <a href="/apps" class="text-xs font-semibold text-blue-500 hover:underline flex-shrink-0">
          View All Apps ({apps.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {apps.map((app) => (
          <WorkCard
            href="/apps"
            title={app.data.title}
            tagline={app.data.tagline}
            meta={`${app.data.platform} · ${app.data.category}`}
            icon={app.data.icon}
            badge={app.data.status === 'live' ? 'Live' : 'Coming Soon'}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       EXTENSIONS SHOWCASE
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-default)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold block mb-1">Chrome Web Store</span>
          <h2 class="text-[var(--text-primary)]">Browser Utilities</h2>
        </div>
        <a href="/extensions" class="text-xs font-semibold text-blue-500 hover:underline flex-shrink-0">
          All Extensions ({extensions.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {extensions.map((ext) => (
          <WorkCard
            href={`/extensions/${ext.slug}`}
            title={ext.data.title}
            tagline={ext.data.tagline}
            meta={`v${ext.data.version} · Chrome Extension`}
            icon={ext.data.icon}
            badge={ext.data.status === 'live' ? 'Live' : 'Coming Soon'}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       WEB PLATFORMS SHOWCASE
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-default)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-semibold block mb-1">Web Platforms</span>
          <h2 class="text-[var(--text-primary)]">Shipped Web Applications</h2>
        </div>
        <a href="/web" class="text-xs font-semibold text-blue-500 hover:underline flex-shrink-0">
          All Web Projects →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {web.map((site) => (
          <WorkCard
            href={site.data.url}
            title={site.data.title}
            tagline={site.data.tagline}
            meta={`Web · ${site.data.year}`}
            icon={site.data.icon}
            badge={site.data.status === 'live' ? 'Live' : 'Coming Soon'}
            external
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       AMAZON MERCH INSPECTOR PORTFOLIO SECTION
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-default)] bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-10">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono font-semibold w-fit">
            <Icon name="ShieldCheck" class="w-3.5 h-3.5" />
            Amazon Merch on Demand Reference
          </div>
          <h2 class="text-[var(--text-primary)]">Original Art &amp; Product Marks</h2>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed">
            BramLabs is an active Amazon Appstore developer expanding into Merch on Demand. We publish original apparel &amp; branded merchandise exclusively for our own software titles — never third-party IP, sports logos, or copyrighted characters.
          </p>
          <ul class="flex flex-col gap-2 text-xs text-[var(--text-muted)] font-mono">
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>300 DPI Masters</strong>: Transparent 4500x5400 px vector print files</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>USPTO Screened</strong>: Distinctive mark &amp; wordmark clearance before upload</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Policy Compliant</strong>: Strict adherence to Amazon Content Policy</span>
            </li>
          </ul>
          <a href="/merch" class="btn btn-secondary w-fit text-xs mt-1">
            View Full MBA Portfolio &amp; Technical Specs →
          </a>
        </div>

        <!-- Palette Swatch Cards Grid -->
        <div class="lg:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-3.5">
          {featuredArt.map((piece) => (
            <div class="glass-card overflow-hidden">
              <div class="h-14 flex overflow-hidden border-b border-[var(--border-default)]">
                {piece.data.palette.map((hex: string) => (
                  <div class="flex-1 h-full" style={`background-color:${hex};`} title={hex}></div>
                ))}
              </div>
              <div class="p-3 flex flex-col gap-0.5">
                <p class="text-[var(--text-primary)] text-xs font-bold truncate">{piece.data.title}</p>
                <p class="text-[var(--text-muted)] text-[10px] font-mono">{piece.data.printSpecs.dpi} DPI · {piece.data.series}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       DEVELOPER REFERENCE & FOOTER CTA
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-default)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 md:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--text-muted)] font-bold mb-1 block">Developer Verification</span>
          <h2 class="text-[var(--text-primary)] mb-2">BramLabs Studio Reference</h2>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed">
            Amazon Appstore Developer Account · Chrome Web Store Publisher · Merch on Demand IP Creator. For verification or inquiries:
            <a href="mailto:support@bramlabs.co" class="text-blue-500 hover:underline font-semibold ml-1">support@bramlabs.co</a>
          </p>
        </div>
        <div class="flex flex-wrap gap-3 flex-shrink-0">
          <a href="/about" class="btn btn-primary text-xs">About Studio</a>
          <a href="/merch" class="btn btn-secondary text-xs">MBA Portfolio</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
