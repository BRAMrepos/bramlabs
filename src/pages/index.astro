---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignCard from "@/components/DesignCard.astro";
import { getFeaturedDesigns, getAllDesigns } from "@/data/designs";
import { getPublishedSoftware } from "@/data/software";

const featured = getFeaturedDesigns();
const all = getAllDesigns();
const hero = featured[0] ?? all[0];
const processDesign = all.find((d) => d.processStages?.length) ?? hero;
const published = getPublishedSoftware();
const processStages = (processDesign.processStages ?? []).slice(0, 4);
---

<BaseLayout
  title="BramLabs — Original Apparel Graphics"
  description="Original apparel graphics by BramLabs: technical illustration, developer culture, shift work, focus and modern professional themes. Design portfolio — not a storefront."
  image="/mockups/rotation-dial-tee.jpg"
>
  <!-- 1. HERO ──────────────────────────────────────────── -->
  <section class="hero section">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Original Apparel Graphics</p>
        <h1 class="h-hero">Graphics built for the people who keep systems running.</h1>
        <p class="lede">
          Technical illustration and restrained typography for shift workers,
          developers and focused minds — designed in-house, from concept to print master.
        </p>
        <div class="hero-actions">
          <a href="/collection/" class="btn -primary">Explore Collection</a>
          <a href="/process/" class="btn -ghost">See Process</a>
        </div>
        <p class="hero-note meta">
          {all.length} original designs · portfolio, not a storefront
        </p>
      </div>

      <div class="hero-visual">
        <figure class="hero-garment">
          <picture>
            <source srcset={hero.images.primaryMockup.replace(/\.jpg$/, ".webp")} type="image/webp" />
            <img
              src={hero.images.primaryMockup}
              alt={`${hero.shirtColor === "navy" ? "Navy blue" : "Black"} heavyweight T-shirt featuring the ${hero.title} graphic`}
              width="800"
              height="1000"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. FEATURED COLLECTION ───────────────────────────── -->
  <section class="section" id="collection">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">First Collection</p>
        <h2 class="h-section">Featured Apparel Graphics</h2>
        <p class="lede">
          Highlights from twelve original pieces — technical illustration, visual systems, and typographic humor built for dark fabric.
        </p>
      </div>

      <div class="design-grid">
        {featured.map((d) => <DesignCard design={d} />)}
      </div>

      <div class="section-cta">
        <a href="/collection/" class="btn -ghost">View All {all.length} Collection Pieces →</a>
      </div>
    </div>
  </section>

  <!-- 3. PROCESS ──────────────────────────────────────── -->
  <section class="section process-teaser">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Construction Trail</p>
        <h2 class="h-section">How a Design is Built: {processDesign.title}</h2>
        <p class="lede">
          Every piece moves through 4 distinct evolutionary stages — from rough concept sketch to vector master and chest-scale garment application.
        </p>
      </div>

      <ol class="process-stages">
        {
          processStages.map((s, i) => (
            <li>
              <span class="meta accent">0{i + 1}</span>
              <h3>{s.label}</h3>
              <p>{s.body}</p>
              {s.image && (
                <div class="stage-img-wrap">
                  <img
                    src={s.image}
                    alt={`${processDesign.title}: ${s.label}`}
                    loading="lazy"
                    width="640"
                    height="640"
                  />
                </div>
              )}
            </li>
          ))
        }
      </ol>

      <a href="/process/" class="btn -ghost">Explore Full Process &amp; Rejected Directions →</a>
    </div>
  </section>

  <!-- 4. ORIGINALITY & CRAFT STANDARDS ───────────────── -->
  <section class="section standards">
    <div class="wrap">
      <div class="standards-grid">
        <div>
          <p class="eyebrow">Studio Craft</p>
          <h2 class="h-section">Original work. Print-ready masters.</h2>
          <p class="lede">
            This site is a design portfolio — not an online storefront. Production files stay separate from web previews to guarantee technical authenticity.
          </p>
          <div class="standards-actions">
            <a href="/collection/" class="btn -primary">Explore Collection</a>
            <a href="/about/" class="btn -ghost">About BramLabs</a>
          </div>
        </div>

        <ul class="standards-list">
          <li>
            <strong>01 / In-House Concepts</strong>
            <span>100% vector illustration crafted from scratch. Zero stock clipart, licensed characters, or third-party brand marks.</span>
          </li>
          <li>
            <strong>02 / Construction Trail</strong>
            <span>Documented evolution showing sketches, geometric grids, and rejected directions on every process page.</span>
          </li>
          <li>
            <strong>03 / Print-Ready Masters</strong>
            <span>High-resolution vector assets and 4500×5400 px sRGB transparent PNG print masters maintained offline at 300 DPI.</span>
          </li>
          <li>
            <strong>04 / Policy &amp; IP Review</strong>
            <span>Each graphic is screened against USPTO trademark databases and content policies prior to publication.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. DESIGNER ──────────────────────────────────────── -->
  <section class="section designer" id="designer">
    <div class="wrap designer-grid">
      <div class="designer-visual">
        <figure class="desk">
          <picture>
            <source srcset="/studio/workspace.webp" type="image/webp" />
            <img
              src="/studio/workspace.jpg"
              alt="BramLabs studio workspace with technical graphic artwork, drafting tools, and fabric swatches"
              width="800"
              height="1000"
              loading="lazy"
            />
          </picture>
        </figure>
      </div>

      <div>
        <p class="eyebrow">Designer &amp; Founder</p>
        <h2 class="h-section">Designed by Bram</h2>
        <p class="body">
          I founded BramLabs to put original vector craft on apparel. Every piece
          starts as a researched concept — drawn and constructed in-house with
          strict geometric systems and technical typography.
        </p>
        <p class="body second">
          No stock art. No generic brand logos. Graphics that hold up as
          standalone compositions before they ever touch fabric.
        </p>
        <a href="/about/" class="btn -link">About BramLabs →</a>
      </div>
    </div>
  </section>

  <!-- 6. SOFTWARE CREDENTIALS STRIP ────────────────────── -->
  {
    published.length > 0 && (
      <section class="section soft-strip" aria-labelledby="soft-strip-heading">
        <div class="wrap soft-inner">
          <div class="soft-head">
            <div>
              <p class="eyebrow">Studio Credentials</p>
              <h2 class="h-section" id="soft-strip-heading">Also Ships Software</h2>
            </div>
            <a href="/studio/" class="btn -ghost">All Studio Credentials →</a>
          </div>

          <div class="soft-grid">
            {published.map((p) => (
              <a
                href={p.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="soft-card"
              >
                <div class="soft-icon">
                  {p.icon ? (
                    <img src={p.icon} alt="" width="44" height="44" />
                  ) : (
                    <span class="icon-fallback">{p.title.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div class="soft-info">
                  <div class="soft-title-row">
                    <h3 class="soft-title">{p.title}</h3>
                    <span class="soft-platform">{p.platform}</span>
                  </div>
                  <p class="soft-desc">{p.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style lang="scss">
  .hero {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero-grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;

    @media (width >= 768px) {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-7);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .h-hero {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-2);
  }

  .hero-note {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-garment {
    width: 100%;
    max-width: 520px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--canvas);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);

    picture, img {
      width: 100%;
      height: auto;
      display: block;
    }

    img {
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    max-width: 44rem;
  }

  .design-grid {
    display: grid;
    gap: var(--s-6) var(--s-5);
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-cta {
    margin-top: var(--s-6);
  }

  .process-teaser {
    background: var(--canvas);
  }

  .process-stages {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      border-top: 2px solid var(--line);
      padding-top: var(--s-3);
    }

    .accent {
      color: var(--cyan);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.8rem;
    }

    h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
    }

    p {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.5;
      flex: 1;
    }

    .stage-img-wrap {
      margin-top: 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #09090b;
      overflow: hidden;

      img {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: contain;
        padding: 0.5rem;
        display: block;
      }
    }
  }

  .standards {
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }

  .standards-grid {
    display: grid;
    gap: var(--s-6);

    @media (width >= 900px) {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }

  .standards-list {
    display: grid;
    gap: 1.25rem;

    li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--line);
    }

    strong {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1rem;
      color: var(--ink);
    }

    span {
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }
  }

  .standards-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--s-4);
  }

  .designer-grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;

    @media (width >= 900px) {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--s-7);
    }
  }

  .desk {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-soft);

    img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
    }
  }

  .second {
    margin-top: var(--s-3);
    margin-bottom: var(--s-4);
    color: var(--muted);
  }

  .soft-strip {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
    background: var(--canvas);
  }

  .soft-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .soft-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .soft-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .soft-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease), border-color var(--t) var(--ease);

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lift);
      border-color: color-mix(in oklab, var(--ink) 25%, var(--line));

      .soft-title {
        color: var(--accent);
      }
    }
  }

  .soft-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--canvas);
    border: 1px solid var(--line);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .soft-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .soft-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .soft-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }

  .soft-platform {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--canvas);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    white-space: nowrap;
  }

  .soft-desc {
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
