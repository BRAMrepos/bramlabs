---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');

const structuredData = {
  "@context": "https://schema.org",
  "@type": "DeveloperArchive",
  "name": "BramLabs",
  "url": "https://bramlabs.co",
  "description": "Indie developer studio building micro browser extensions focused on privacy and user autonomy.",
  "logo": "https://bramlabs.co/favicon.svg"
};
---

<BaseLayout
  title="Privacy-First Browser Extensions"
  description="BramLabs builds lightweight, local-first, and privacy-respecting browser extensions designed to help you focus and protect your digital footprint."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative py-32 bg-bg flex items-center overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left Column: Copy -->
      <div class="lg:col-span-7 flex flex-col items-start gap-8 z-10 text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-muted text-accent text-xs font-mono font-semibold">
          <span class="text-accent">•</span>
          100% Local-First
        </div>
        <!-- Headline -->
        <h1 class="text-display text-text max-w-xl">
          Browser tools built with craft & privacy.
        </h1>
        <!-- Subtext -->
        <p class="text-body text-muted max-w-prose">
          We design lightweight, open-source browser extensions to protect your digital footprint, declutter your workspaces, and keep you safe.
        </p>
        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 w-full sm:w-auto">
          <a
            href="/extensions"
            class="bg-accent hover:bg-accent-hover text-white px-6 py-3 rounded-lg font-medium transition-colors duration-150 shadow-sm text-center flex items-center justify-center gap-2 group w-full sm:w-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none"
          >
            Explore Extensions &rarr;
          </a>
          <a
            href="/blog"
            class="border border-border bg-surface hover:bg-surface-2 text-text hover:border-text px-6 py-3 rounded-lg font-medium transition-all duration-150 text-center w-full sm:w-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none"
          >
            Read Blog
          </a>
        </div>
      </div>

      <!-- Right Column: Browser Mockup -->
      <div class="lg:col-span-5 relative w-full flex justify-center">
        <div class="w-full max-w-md bg-surface rounded-xl border border-border shadow-sm overflow-hidden flex flex-col transition-all duration-200">
          <!-- Browser Frame Header -->
          <div class="bg-surface-2 px-4 py-3 border-b border-border flex items-center justify-between">
            <div class="flex gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
            </div>
            <div class="bg-surface border border-border rounded-md px-3 py-0.5 text-mono text-muted w-48 text-center truncate select-none">
              bramlabs.co/extensions
            </div>
            <div class="w-10"></div>
          </div>
          <!-- Mock extension popup ui -->
          <div class="p-6 flex flex-col gap-6 bg-surface min-h-[300px]">
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-accent flex items-center justify-center text-white">
                  <Icon name="Layers" class="w-5 h-5 text-white" />
                </div>
                <div class="text-left">
                  <h3 class="text-h3 text-text">Extension Active</h3>
                  <p class="text-xs text-muted">Local Sandbox &bull; Enabled</p>
                </div>
              </div>
              <!-- Toggle switch mockup -->
              <span class="w-10 h-6 bg-accent rounded-full p-0.5 flex items-center justify-end cursor-pointer">
                <span class="w-5 h-5 rounded-full bg-white shadow-sm"></span>
              </span>
            </div>
            
            <div class="flex flex-col gap-3 text-left">
              <span class="text-mono text-xs font-bold text-muted uppercase tracking-wider">Status & Performance</span>
              <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center text-xs border border-border rounded-lg p-3">
                  <span class="text-muted flex items-center gap-2"><Icon name="Cpu" class="w-3.5 h-3.5 text-accent" /> Memory Overhead</span>
                  <span class="font-semibold text-text font-mono">0.1 MB</span>
                </div>
                <div class="flex justify-between items-center text-xs border border-border rounded-lg p-3">
                  <span class="text-muted flex items-center gap-2"><Icon name="Shield" class="w-3.5 h-3.5 text-accent" /> Telemetry & Tracking</span>
                  <span class="font-semibold text-green-800 bg-green-100 dark:bg-green-950/30 dark:text-green-400 px-2 py-0.5 rounded-full font-mono text-[10px]">Blocked</span>
                </div>
              </div>
            </div>

            <div class="bg-surface-2 rounded-lg p-4 flex items-start gap-3 border border-border text-left">
              <Icon name="Lock" class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" />
              <p class="text-xs text-muted leading-relaxed">
                All functions execute entirely client-side. Your browsing metadata never leaves your machine.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars / Values Section -->
  <section class="py-24 bg-surface border-y border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl flex flex-col gap-4 mb-16 text-left">
        <span class="text-[12px] font-mono text-accent uppercase tracking-wider font-semibold">How We Build</span>
        <h2 class="text-h2 text-text">Three principles. No exceptions.</h2>
      </div>

      <!-- Horizontal row layout -->
      <div class="flex flex-col w-full">
        <!-- Row 1 -->
        <div class="grid grid-cols-1 md:grid-cols-10 gap-6 py-8 border-b border-border items-start text-left">
          <div class="md:col-span-3">
            <h3 class="text-h3 text-text">Privacy by Design</h3>
          </div>
          <div class="md:col-span-7">
            <p class="text-body text-muted max-w-prose">
              No cloud servers, no telemetry, no behavioral tracking. Every setting stays on your machine.
            </p>
          </div>
        </div>

        <!-- Row 2 -->
        <div class="grid grid-cols-1 md:grid-cols-10 gap-6 py-8 border-b border-border items-start text-left">
          <div class="md:col-span-3">
            <h3 class="text-h3 text-text">Zero Bundle Bloat</h3>
          </div>
          <div class="md:col-span-7">
            <p class="text-body text-muted max-w-prose">
              Built with vanilla APIs. Loads instantly, never slows your browser, never inflates your RAM usage.
            </p>
          </div>
        </div>

        <!-- Row 3 -->
        <div class="grid grid-cols-1 md:grid-cols-10 gap-6 py-8 items-start text-left">
          <div class="md:col-span-3">
            <h3 class="text-h3 text-text">Audit-Ready Source</h3>
          </div>
          <div class="md:col-span-7">
            <p class="text-body text-muted max-w-prose">
              All code is open-source and reviewable on GitHub. Security researchers can confirm every claim we make.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Extensions Hub Section -->
  <section class="py-24 bg-bg">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 text-left">
        <div class="max-w-xl flex flex-col gap-4">
          <h2 class="text-h2 text-text">Everything we've built.</h2>
          <p class="text-small text-muted">
            Each extension is focused, lightweight, and ships with a specific privacy policy.
          </p>
        </div>
        <a href="/extensions" class="text-accent hover:underline font-semibold transition-colors flex items-center gap-1 text-sm">
          Browse all &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {extensions.length > 0 ? (
          extensions.map((ext) => (
            <div class="bg-surface rounded-xl border border-border p-6 flex flex-col justify-between shadow-sm transition-[transform,border-color,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:border-accent/40 text-left">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-12 h-12 rounded-lg bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                    <Icon name={ext.data.icon} class="w-6 h-6 text-accent" />
                  </div>
                  <div>
                    <h3 class="text-h3 text-text leading-tight">{ext.data.title}</h3>
                    {ext.data.downloadCount && (
                      <span class="text-mono text-xs text-muted mt-0.5 block">{ext.data.downloadCount}</span>
                    )}
                  </div>
                </div>
                <p class="text-small text-muted leading-relaxed mb-6">
                  {ext.data.tagline}
                </p>
              </div>
              
              <div class="border-t border-border/50 pt-4 flex items-center justify-between">
                <a href={`/extensions/${ext.slug}`} class="text-accent hover:underline text-sm font-semibold flex items-center gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none">
                  Learn More &rarr;
                </a>
                <a
                  href={ext.data.storeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-border text-text hover:bg-bg text-xs px-3.5 py-1.5 rounded-lg transition-colors font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none"
                >
                  Add to Chrome
                </a>
              </div>
            </div>
          ))
        ) : (
          <!-- Placeholder Card -->
          <div class="md:col-span-2 bg-surface rounded-xl border border-border border-dashed p-12 text-center flex flex-col items-center justify-center gap-3">
            <h3 class="text-h3 text-text">First extension loading...</h3>
            <p class="text-small text-muted max-w-sm">
              Check back soon or follow the blog for launch updates.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Newsletter / CTA Section -->
  <section class="py-24 bg-surface border-t border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
        <!-- Left column -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <h2 class="text-h2 text-text">Stay in the loop.</h2>
          <p class="text-small text-muted max-w-prose">
            New extensions, privacy guides, and release notes. No marketing. Unsubscribe anytime.
          </p>
        </div>
        <!-- Right column -->
        <div class="lg:col-span-5 w-full">
          <form class="flex flex-col sm:flex-row gap-3 w-full items-stretch" onsubmit="alert('Subscribed!'); return false;">
            <input
              type="email"
              placeholder="your@email.com"
              required
              class="flex-grow bg-surface-2 border border-border rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
            />
            <button
              type="submit"
              class="bg-accent hover:bg-accent-hover text-white px-6 py-3 rounded-lg text-sm font-semibold transition-colors duration-150 shadow-sm flex-shrink-0"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
