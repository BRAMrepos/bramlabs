---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');
const apps       = await getCollection('apps');
const web        = await getCollection('web');
const art        = await getCollection('art');

const featuredWeb  = web.filter(w => w.data.featured);
const featuredArt  = art.filter(a => a.data.featured).slice(0, 4);
const featuredExt  = extensions.find(e => e.slug === 'story-peek') ?? extensions[0];
const otherExt     = extensions.filter(e => e.slug !== 'story-peek').slice(0, 2);
const featuredApps = apps.filter(a => a.data.featured);
---

<BaseLayout
  title="Apps, Extensions, Web & Original Merch"
  description="BramLabs is an indie product studio shipping Amazon Appstore apps, Chrome extensions, web products, and original merch for our own IP only."
>

  <!-- ========================================================
       HERO
       ======================================================== -->
  <section class="relative section-block pt-24 md:pt-32 overflow-hidden">
    <!-- Glow orbs -->
    <div class="glow-orb glow-orb-sky w-[520px] h-[520px] -top-32 -left-32 opacity-30" aria-hidden="true"></div>
    <div class="glow-orb glow-orb-indigo w-[420px] h-[420px] -top-20 right-0 opacity-20" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-sky-400/30 bg-sky-400/[0.08] mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span class="text-sky-400 text-xs font-semibold tracking-wide">Indie product studio</span>
        </div>

        <!-- Headline -->
        <h1 class="mb-6">
          We build products<br class="hidden sm:block" />
          <span class="text-gradient">and the things<br class="hidden sm:block" />that belong to them.</span>
        </h1>

        <!-- Lead -->
        <p class="text-[var(--text-secondary)] text-lg leading-relaxed mb-8 max-w-xl">
          Apps, browser extensions, web tools, and original apparel — all from one studio. Merch is for our own IP only. No third-party brands, no characters.
        </p>

        <!-- Mini stats -->
        <div class="flex flex-wrap gap-x-6 gap-y-2.5 text-sm text-[var(--text-muted)] mb-10">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
            {extensions.length} Chrome extensions live
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 flex-shrink-0"></span>
            Active Appstore developer
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 flex-shrink-0"></span>
            {featuredWeb.length + featuredApps.length}+ products shipped
          </span>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3">
          <a href="/work"       class="btn btn-primary">View all work</a>
          <a href="/extensions" class="btn btn-secondary">Browse extensions →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       TRUST STRIP
       ======================================================== -->
  <div class="border-y border-[var(--border-subtle)] bg-white/[0.02] py-4 mt-16 reveal" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-[var(--text-muted)]">
        <li class="flex items-center gap-2">
          <Icon name="Smartphone" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
          Amazon Appstore developer
        </li>
        <li class="flex items-center gap-2">
          <Icon name="Puzzle" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
          Chrome Web Store publisher
        </li>
        <li class="flex items-center gap-2">
          <Icon name="Palette" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
          300 DPI print-ready art
        </li>
        <li class="flex items-center gap-2">
          <Icon name="ShieldCheck" class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
          USPTO checks before publish
        </li>
      </ul>
    </div>
  </div>

  <!-- ========================================================
       FEATURED EXTENSION SPOTLIGHT
       ======================================================== -->
  {featuredExt && (
    <section class="section-block">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8 reveal" data-reveal>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-sky-400 mb-1">Featured extension</p>
            <h2 class="text-[var(--text-primary)]">StoryPeek</h2>
          </div>
          <a href="/extensions" class="text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors flex-shrink-0">
            All extensions →
          </a>
        </div>

        <!-- Featured card - wide -->
        <div class="glass-card p-8 md:p-10 grid grid-cols-1 lg:grid-cols-2 gap-10 items-start mb-6 reveal" data-reveal style="--reveal-delay:100ms">
          <div class="flex flex-col gap-5">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center flex-shrink-0 shadow-lg shadow-sky-500/20">
                <Icon name={featuredExt.data.icon} class="w-7 h-7 text-white" />
              </div>
              <div>
                <h3 class="text-[var(--text-primary)] text-xl font-bold">{featuredExt.data.title}</h3>
                <p class="text-[var(--text-faint)] text-xs mt-0.5">v{featuredExt.data.version} · Chrome Extension · Free</p>
              </div>
            </div>

            <p class="text-[var(--text-secondary)] leading-relaxed">{featuredExt.data.description}</p>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={featuredExt.data.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                Add to Chrome — Free
              </a>
              <a href={`/extensions/${featuredExt.slug}`} class="btn btn-secondary">
                Learn more
              </a>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-[var(--text-faint)]">What it does</p>
            <ul class="flex flex-col gap-3">
              {featuredExt.data.features.map((feat) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="w-5 h-5 rounded-full bg-sky-400/10 border border-sky-400/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <Icon name="Check" class="w-3 h-3 text-sky-400" />
                  </span>
                  <span class="text-[var(--text-secondary)]">
                    <span class="text-[var(--text-primary)] font-medium">{feat.title}</span> — {feat.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Other extensions -->
        {otherExt.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal" data-reveal style="--reveal-delay:160ms">
            {otherExt.map((ext) => (
              <WorkCard
                href={`/extensions/${ext.slug}`}
                title={ext.data.title}
                tagline={ext.data.tagline}
                meta={`v${ext.data.version} · Chrome`}
                icon={ext.data.icon}
                badge="Free"
              />
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ========================================================
       FOUR LANES
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-subtle)] bg-white/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mb-12 reveal" data-reveal>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-sky-400 mb-2">What we build</p>
        <h2 class="text-[var(--text-primary)] mb-3">Four lanes. One studio.</h2>
        <p class="text-[var(--text-muted)] text-sm leading-relaxed">Real product work — not a service offering. Everything ships under the BramLabs identity.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { href: '/apps',       icon: 'Smartphone', title: 'Apps',         desc: 'Original titles on Amazon Appstore. Local-first, minimal permissions.',            badge: 'Active' },
          { href: '/extensions', icon: 'Puzzle',     title: 'Extensions',   desc: 'StoryPeek, SnapElite, SonicShield — Chrome utilities with full support trees.',   badge: 'Live' },
          { href: '/web',        icon: 'Globe',      title: 'Web',          desc: 'Production sites with real content systems. Led by WorkflowAI.site.',              badge: 'Shipped' },
          { href: '/merch',      icon: 'Shirt',      title: 'Art & Merch',  desc: '300 DPI originals for our products only. USPTO-checked before every publish.',    badge: 'MBA-ready' },
        ].map((lane, i) => (
          <a
            href={lane.href}
            class="glass-card group flex flex-col gap-4 p-6 reveal"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <div class="flex items-start justify-between">
              <div class="w-10 h-10 rounded-lg bg-sky-400/10 border border-sky-400/20 flex items-center justify-center">
                <Icon name={lane.icon} class="w-5 h-5 text-sky-400" />
              </div>
              <span class="badge badge-sky text-[10px]">{lane.badge}</span>
            </div>
            <div>
              <h3 class="text-[var(--text-primary)] font-semibold mb-1.5 group-hover:text-sky-300 transition-colors">{lane.title}</h3>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed">{lane.desc}</p>
            </div>
            <span class="text-sky-400 text-sm font-medium mt-auto flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
              Explore
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       WEB + APPS WORK GRID
       ======================================================== -->
  {(featuredWeb.length > 0 || featuredApps.length > 0) && (
    <section class="section-block border-t border-[var(--border-subtle)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8 reveal" data-reveal>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-sky-400 mb-1">Shipped, not sketched</p>
            <h2 class="text-[var(--text-primary)]">Web &amp; Apps</h2>
          </div>
          <a href="/work" class="text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors flex-shrink-0">All work →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {featuredWeb.map((project, i) => (
            <div class="reveal" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <WorkCard
                href={project.data.url}
                title={project.data.title}
                tagline={project.data.tagline}
                meta={`Web · ${project.data.year}`}
                icon={project.data.icon}
                badge="Live"
                external
              />
            </div>
          ))}
          {featuredApps.map((app, i) => (
            <div class="reveal" data-reveal style={`--reveal-delay:${(featuredWeb.length + i) * 80}ms`}>
              <WorkCard
                href="/apps"
                title={app.data.title}
                tagline={app.data.tagline}
                meta={`${app.data.platform} · ${app.data.year}`}
                icon={app.data.icon}
                badge={app.data.status === 'live' ? 'Live' : 'In progress'}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ========================================================
       ART / MERCH BRIEF
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-subtle)] bg-white/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-5 reveal" data-reveal>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-sky-400 mb-2">Merch on Demand</p>
            <h2 class="text-[var(--text-primary)] mb-3">Original art for our own products.</h2>
            <p class="text-[var(--text-muted)] leading-relaxed">
              BramLabs is an active Amazon Appstore developer expanding into Merch on Demand. We publish original apparel for our apps, games, extensions, and sites — not third-party IP, sports brands, or copyrighted characters.
            </p>
          </div>
          <ul class="flex flex-col gap-2.5 text-sm text-[var(--text-muted)]">
            {[
              '300 DPI transparent PNG masters',
              'USPTO trademark screen before every publish',
              'Amazon Content Policy review on every design',
            ].map(item => (
              <li class="flex items-center gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-400/10 border border-emerald-400/20 flex items-center justify-center flex-shrink-0">
                  <Icon name="Check" class="w-3 h-3 text-emerald-400" />
                </span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/merch" class="text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors w-fit">
            Art &amp; process →
          </a>
        </div>

        <!-- Palette preview cards -->
        <div class="grid grid-cols-2 gap-4 reveal" data-reveal style="--reveal-delay:120ms">
          {featuredArt.map((piece) => (
            <div class="glass-card overflow-hidden">
              <!-- Actual hex palette stripe -->
              <div class="h-20 flex overflow-hidden">
                {piece.data.palette.map((hex: string) => (
                  <div class="flex-1 h-full" style={`background-color:${hex};`} title={hex}></div>
                ))}
              </div>
              <div class="p-4 flex flex-col gap-0.5">
                <p class="text-[var(--text-primary)] text-sm font-semibold leading-tight">{piece.data.title}</p>
                <p class="text-[var(--text-faint)] text-[11px]">{piece.data.series} · {piece.data.printSpecs.dpi} DPI</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       BOTTOM CTA
       ======================================================== -->
  <section class="section-block border-t border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-8 reveal" data-reveal>
        <div class="max-w-xl">
          <h2 class="text-[var(--text-primary)] mb-3">Developer reference</h2>
          <p class="text-[var(--text-muted)] leading-relaxed">
            Amazon Appstore developer · Chrome publisher · Expanding into Merch on Demand for original apparel tied to our own products.
            Questions or verification:
            <a href="mailto:support@bramlabs.co" class="text-sky-400 hover:text-sky-300 transition-colors">support@bramlabs.co</a>
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
          <a href="/about"  class="btn btn-primary">About the studio</a>
          <a href="/merch"  class="btn btn-secondary">MBA portfolio</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
