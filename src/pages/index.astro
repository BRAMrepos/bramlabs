---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignCard from "@/components/DesignCard.astro";
import { getFeaturedDesigns, getAllDesigns } from "@/data/designs";
import { getPublishedSoftware } from "@/data/software";
import { getLatestPosts } from "@/data/journal";

// Driven from data, not a hardcoded slug list — a published product can no
// longer go missing from the homepage the way StoryPeek did.
const products = getPublishedSoftware();
const featuredDesigns = getFeaturedDesigns().slice(0, 3);
const allDesigns = getAllDesigns();
const posts = getLatestPosts(3);
---

<BaseLayout
  title="BramLabs — Independent Software Studio"
  description="BramLabs builds small, focused software: shift and routine apps for Android, browser utilities for Chrome, and web tools. Plus original apparel graphics from the same desk."
>
  <!-- 1. HERO ──────────────────────────────────────────── -->
  <section class="hero section">
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Independent software studio</p>
        <h1 class="h-hero">Small software for people who work in systems.</h1>
        <p class="lede">
          Shift tracking, spoken routines, browser tools that stay out of the way.
          Every one of the {products.length} products here is built and maintained by
          one person, with a real support page and a real privacy policy behind it.
        </p>
        <div class="hero-actions">
          <a href="/software/" class="btn -primary">Browse the software</a>
          <a href="/about/" class="btn -ghost">About the studio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PRODUCTS ─────────────────────────────────────── -->
  <section class="section products" id="products" aria-labelledby="products-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2 class="h-section" id="products-heading">Everything currently shipping</h2>
      </div>

      <ul class="product-grid">
        {
          products.map((p) => (
            <li>
              <a href={`/software/${p.slug}/`} class="product-card">
                {p.icon ? (
                  <img src={p.icon} alt="" width="52" height="52" class="p-icon" loading="lazy" />
                ) : (
                  <div class="p-icon p-icon-fallback" aria-hidden="true">
                    <span>{p.title.slice(0, 2).toUpperCase()}</span>
                  </div>
                )}
                <div class="p-body">
                  <div class="p-head">
                    <h3 class="p-title">{p.title}</h3>
                    <span class="p-platform">{p.platform}</span>
                  </div>
                  <p class="p-tagline">{p.tagline}</p>
                  <p class="p-desc">{p.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="section-cta">
        <a href="/software/" class="btn -ghost">All {products.length} products, with support and privacy →</a>
      </div>
    </div>
  </section>

  <!-- 3. HOW THE STUDIO WORKS ─────────────────────────── -->
  <section class="section principles" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 class="h-section" id="principles-heading">One person, and no dark patterns.</h2>
      </div>

      <ul class="principle-grid">
        <li>
          <h3>On-device by default</h3>
          <p>
            The mobile and browser products do their work locally. No account to
            create, and nothing uploaded to a server that does not need to be.
          </p>
        </li>
        <li>
          <h3>Every product documented</h3>
          <p>
            Each one has a support page that answers real questions and a privacy
            policy that says what is collected, why, and for how long.
          </p>
        </li>
        <li>
          <h3>Bugs reach a human</h3>
          <p>
            Feedback goes to one inbox, read by the person who wrote the code.
            There is no ticket queue and no support bot.
          </p>
        </li>
        <li>
          <h3>Nothing is sold on</h3>
          <p>
            No advertising trackers, no data brokers, no mailing list you did not
            ask for. The site itself sets no cookies.
          </p>
        </li>
      </ul>

      <div class="section-cta">
        <a href="/feedback/" class="btn -ghost">Report a bug or request a feature →</a>
      </div>
    </div>
  </section>

  <!-- 4. APPAREL ──────────────────────────────────────── -->
  <section class="section apparel" id="apparel" aria-labelledby="apparel-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Also from the studio</p>
        <h2 class="h-section" id="apparel-heading">Original apparel graphics</h2>
        <p class="lede">
          The same systems thinking, applied to fabric. {allDesigns.length} original
          vector pieces for shift workers, developers and focused minds — each with
          its construction trail documented from sketch to print master.
        </p>
      </div>

      <div class="design-grid">
        {featuredDesigns.map((d) => <DesignCard design={d} />)}
      </div>

      <div class="apparel-actions">
        <a href="/collection/" class="btn -ghost">View all {allDesigns.length} pieces →</a>
        <a href="/process/" class="btn -link">See the process →</a>
      </div>
    </div>
  </section>

  <!-- 5. JOURNAL ──────────────────────────────────────── -->
  {
    posts.length > 0 && (
      <section class="section journal" aria-labelledby="journal-heading">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">Journal</p>
            <h2 class="h-section" id="journal-heading">Notes from the desk</h2>
          </div>

          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/journal/${post.slug}/`} class="post">
                  <time class="post-date meta" datetime={post.date}>
                    {post.dateLabel}
                  </time>
                  <h3 class="post-title">{post.title}</h3>
                  <p class="post-excerpt">{post.excerpt}</p>
                </a>
              </li>
            ))}
          </ul>

          <div class="section-cta">
            <a href="/journal/" class="btn -ghost">Read the journal →</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 6. WHO ──────────────────────────────────────────── -->
  <section class="section designer" id="designer">
    <div class="wrap designer-grid">
      <div class="designer-visual">
        <figure class="desk">
          <picture>
            <source srcset="/studio/workspace.webp" type="image/webp" />
            <img
              src="/studio/workspace.jpg"
              alt="The BramLabs desk: technical vector artwork, drafting tools and fabric swatches"
              width="800"
              height="1000"
              loading="lazy"
            />
          </picture>
        </figure>
      </div>

      <div>
        <p class="eyebrow">Who builds this</p>
        <h2 class="h-section">Designed and built by Bram</h2>
        <p class="body">
          I write the software, design the graphics, answer the support mail and
          keep the policies current. Everything published here comes off one desk.
        </p>
        <p class="body second">
          The software and the apparel work share the same habits — clear
          hierarchy, exact line weight, and no decoration that is not carrying
          information.
        </p>
        <div class="designer-actions">
          <a href="/about/" class="btn -ghost">About BramLabs</a>
          <a href="/contact/" class="btn -link">Get in touch →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  /* ── hero ─────────────────────────────────────────── */
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 46rem;
  }

  .h-hero {
    font-family: var(--font-heading, var(--font-display));
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .lede {
    max-width: 40rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-2);
  }

  /* ── shared section furniture ─────────────────────── */
  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    max-width: 44rem;
  }

  .section-cta {
    margin-top: var(--s-5);
  }

  /* ── products ─────────────────────────────────────── */
  .products {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .product-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1080px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-card {
    height: 100%;
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: var(--s-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm, var(--shadow-soft));
    transition:
      transform var(--t) var(--ease),
      box-shadow var(--t) var(--ease),
      border-color var(--t) var(--ease);

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lift);
      border-color: color-mix(in oklab, var(--ink) 25%, var(--line));

      .p-title {
        color: var(--accent, var(--ink));
      }
    }
  }

  .p-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--canvas);
    object-fit: cover;
    flex-shrink: 0;
  }

  .p-icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .p-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .p-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .p-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    transition: color var(--t) var(--ease);
  }

  .p-platform {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .p-tagline {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .p-desc {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  /* ── principles ───────────────────────────────────── */
  .principles {
    background: var(--canvas);
    border-block: 1px solid var(--line);
  }

  .principle-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      border-top: 2px solid var(--line);
      padding-top: var(--s-3);
      transition: border-color var(--t) var(--ease);

      &:hover {
        border-color: var(--ink);
      }
    }

    h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
    }

    p {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.6;
    }
  }

  /* ── apparel ──────────────────────────────────────── */
  .design-grid {
    display: grid;
    gap: var(--s-6) var(--s-5);
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .apparel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-6);
  }

  /* ── journal ──────────────────────────────────────── */
  .journal {
    background: var(--canvas);
    border-block: 1px solid var(--line);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;

    @media (width >= 760px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    border-top: 2px solid var(--line);
    padding-top: var(--s-3);
    transition: border-color var(--t) var(--ease);

    &:hover {
      border-color: var(--ink);

      .post-title {
        color: var(--accent, var(--ink));
      }
    }
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    transition: color var(--t) var(--ease);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── designer ─────────────────────────────────────── */
  .designer-grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;

    @media (width >= 900px) {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--s-7);
    }
  }

  .desk {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-soft);

    img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
    }
  }

  .second {
    margin-top: var(--s-3);
    color: var(--muted);
  }

  .designer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-4);
  }
</style>
