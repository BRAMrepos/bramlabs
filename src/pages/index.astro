---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesignCard from "@/components/DesignCard.astro";
import { getFeaturedDesigns, getAllDesigns } from "@/data/designs";
import { getPublishedSoftware } from "@/data/software";

const featured = getFeaturedDesigns();
const all = getAllDesigns();
const hero = featured[0] ?? all[0];
const processDesign = all.find((d) => d.processStages?.length) ?? hero;
const published = getPublishedSoftware();
const processStages = (processDesign.processStages ?? []).slice(0, 4);
---

<BaseLayout
  title="BramLabs — Original Apparel Graphics"
  description="Original apparel graphics by BramLabs: technical illustration, developer culture, shift work, focus and modern professional themes. Design portfolio — not a storefront."
  image="/mockups/rotation-dial-tee.jpg"
>
  <!-- 1. HERO ──────────────────────────────────────────── -->
  <section class="hero section">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Original apparel graphics</p>
        <h1 class="h-hero">Graphics built for the people who keep systems running.</h1>
        <p class="lede">
          Technical illustration and restrained typography for shift workers,
          developers and focused minds — designed in-house, from concept to print master.
        </p>
        <div class="hero-actions">
          <a href="/collection/" class="btn -primary">Explore the Collection</a>
          <a href="/process/" class="btn -ghost">See the Process</a>
        </div>
        <p class="hero-note meta">
          {all.length} original designs · portfolio, not a store
        </p>
      </div>
      <div class="hero-visual">
        <figure class="hero-garment">
          <picture>
            <source srcset={hero.images.primaryMockup.replace(/\.jpg$/, ".webp")} type="image/webp" />
            <img
              src={hero.images.primaryMockup}
              alt={`${hero.shirtColor === "navy" ? "Navy blue" : "Black"} heavyweight T-shirt featuring the ${hero.title} graphic`}
              width="800"
              height="1000"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </figure>
        <figure class="hero-art">
          <img
            src={hero.images.rawArtwork}
            alt={`${hero.title} raw artwork`}
            width="800"
            height="800"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. FEATURED COLLECTION ───────────────────────────── -->
  <section class="section" id="collection">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h-section">Featured from the First Collection</h2>
        <p class="lede">
          Six highlights from twelve original graphics — technical illustration,
          visual systems and typographic humor.
        </p>
      </div>
      <div class="design-grid">
        {featured.map((d) => <DesignCard design={d} />)}
      </div>
      <div class="section-cta">
        <a href="/collection/" class="btn -ghost">View all {all.length} designs</a>
      </div>
    </div>
  </section>

  <!-- 3. PROCESS (one case, compressed) ────────────────── -->
  <section class="section process-teaser">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How a design is built</p>
        <h2 class="h-section">{processDesign.title}</h2>
        <p class="lede">
          {processDesign.shortDescription} Every piece moves from research and
          rough concept through geometric construction before it touches fabric.
        </p>
      </div>
      <ol class="process-stages">
        {
          processStages.map((s, i) => (
            <li>
              <span class="meta accent">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.label}</h3>
              <p>{s.body}</p>
              {s.image && (
                <img
                  src={s.image}
                  alt={`${processDesign.title}: ${s.label}`}
                  loading="lazy"
                  width="640"
                  height="640"
                />
              )}
            </li>
          ))
        }
      </ol>
      <a href="/process/" class="btn -ghost">Explore the full process</a>
    </div>
  </section>

  <!-- 4. ORIGINALITY + PRINT READINESS ────── -->
  <section class="section standards">
    <div class="wrap">
      <div class="standards-grid">
        <div>
          <h2 class="h-section">Original work. Print-ready masters.</h2>
          <p class="lede">
            This site is a design portfolio — not an online store. Production
            files stay separate from web previews.
          </p>
        </div>
        <ul class="standards-list">
          <li>
            <strong>In-house concepts</strong>
            <span>No stock clipart, licensed characters or brand marks.</span>
          </li>
          <li>
            <strong>Construction trail</strong>
            <span>Sketch, geometry and rejected directions documented on process pages.</span>
          </li>
          <li>
            <strong>Print-ready masters</strong>
            <span>High-resolution vector assets and 4500×5400 sRGB transparent PNG masters held offline.</span>
          </li>
          <li>
            <strong>Policy review</strong>
            <span>Each graphic checked for IP and marketplace compliance before listing.</span>
          </li>
        </ul>
      </div>
      <div class="standards-actions">
        <a href="/collection/" class="btn -primary">Explore the collection</a>
        <a href="/about/" class="btn -ghost">About the designer</a>
      </div>
    </div>
  </section>

  <!-- 5. DESIGNER (compact) ────────────────────────────── -->
  <section class="section designer" id="designer">
    <div class="wrap designer-grid">
      <div class="designer-visual">
        <figure class="desk">
          <picture>
            <source srcset="/studio/workspace.webp" type="image/webp" />
            <img
              src="/studio/workspace.jpg"
              alt="BramLabs studio workspace with technical graphic artwork, drafting tools, and fabric swatches"
              width="800"
              height="1000"
              loading="lazy"
            />
          </picture>
        </figure>
      </div>
      <div>
        <p class="eyebrow">Designer</p>
        <h2 class="h-section">Designed by Bram</h2>
        <p class="body">
          I founded BramLabs to put original vector craft on apparel. Every piece
          starts as a researched concept — drawn and constructed in-house with
          strict geometric systems and technical typography.
        </p>
        <p class="body second">
          No stock art. No generic brand logos. Graphics that hold up as
          standalone compositions before they ever become a shirt.
        </p>
        <a href="/about/" class="btn -link">About BramLabs →</a>
      </div>
    </div>
  </section>

  <!-- 6. SOFTWARE CREDENTIALS STRIP ────────────────────── -->
  {
    published.length > 0 && (
      <section class="section soft-strip" aria-labelledby="soft-strip-heading">
        <div class="wrap soft-inner">
          <div class="soft-head">
            <div>
              <p class="eyebrow">Studio Credentials</p>
              <h2 class="h-section text-xl md:text-2xl font-bold" id="soft-strip-heading">Also Ships Software</h2>
            </div>
            <a href="/studio/" class="btn -ghost">All Studio Credentials →</a>
          </div>

          <div class="soft-grid">
            {published.map((p) => (
              <a
                href={p.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="soft-card"
              >
                <div class="soft-icon">
                  {p.icon ? (
                    <img src={p.icon} alt="" width="44" height="44" />
                  ) : (
                    <span class="icon-fallback">{p.title.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div class="soft-info">
                  <div class="soft-title-row">
                    <h3 class="soft-title">{p.title}</h3>
                    <span class="soft-platform">{p.platform}</span>
                  </div>
                  <p class="soft-desc">{p.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style lang="scss">
  .hero {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero-grid {
    display: grid;
    gap: var(--s-5);
    align-items: center;

    @media (width >= 720px) {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--s-7);
      min-height: 62vh;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--s-2);
  }

  .hero-note {
    margin-top: var(--s-1);
  }

  .hero-visual {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: 1fr;

    @media (width >= 480px) {
      grid-template-columns: 1.2fr 0.8fr;
    }
    align-items: end;
  }

  /* On narrow mobile, hide the raw art thumbnail to keep things clean */
  .hero-art {
    display: none;

    @media (width >= 480px) {
      display: block;
    }
  }

  .hero-garment,
  .hero-art {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-card);
  }

  .hero-garment picture,
  .hero-garment img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-garment img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 28%;
  }

  .hero-art img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    /* Dark canvas so ivory SVG strokes are visible */
    background: #111315;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    max-width: 42rem;
  }

  .section-cta {
    margin-top: var(--s-5);
  }

  .design-grid {
    display: grid;
    gap: var(--s-6) var(--s-5);
    grid-template-columns: 1fr;

    @media (width >= 720px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .process-teaser {
    background: var(--canvas);
  }

  .process-stages {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);

    @media (width >= 900px) {
      grid-template-columns: repeat(4, 1fr);
    }

    li {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      border-top: 2px solid var(--line);
      padding-top: var(--s-3);
    }

    .accent { color: var(--cyan); }

    h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
    }

    p {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.5;
      flex: 1;
    }

    img {
      margin-top: 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
      aspect-ratio: 1;
      object-fit: contain;
      padding: 0.5rem;
    }
  }

  .standards {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .standards-grid {
    display: grid;
    gap: var(--s-6);
    margin-bottom: var(--s-5);

    @media (width >= 900px) {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }

  .standards-list {
    display: grid;
    gap: 1.15rem;

    li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--line);
    }

    strong {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.05rem;
    }

    span {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
  }

  .standards-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .designer-grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;

    @media (width >= 900px) {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--s-7);
    }
  }

  .desk {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow-soft);

    img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
  }

  .second {
    margin-top: var(--s-3);
    color: var(--muted);
  }

  .soft-strip {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
    background: var(--canvas);
  }

  .soft-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .soft-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .soft-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;

    @media (width >= 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .soft-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease), border-color var(--t) var(--ease);

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lift);
      border-color: color-mix(in oklab, var(--ink) 25%, var(--line));

      .soft-title {
        color: var(--accent);
      }
    }
  }

  .soft-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--canvas);
    border: 1px solid var(--line);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .soft-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .soft-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .soft-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }

  .soft-platform {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--canvas);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    white-space: nowrap;
  }

  .soft-desc {
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
