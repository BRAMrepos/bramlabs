---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const extensions = await getCollection('extensions');

const structuredData = {
  "@context": "https://schema.org",
  "@type": "DeveloperArchive",
  "name": "BramLabs",
  "url": "https://bramlabs.co",
  "description": "Indie developer studio building micro browser extensions focused on privacy and user autonomy.",
  "logo": "https://bramlabs.co/favicon.svg"
};
---

<BaseLayout
  title="Privacy-First Browser Extensions"
  description="BramLabs builds lightweight, local-first, and privacy-respecting browser extensions designed to help you focus and protect your digital footprint."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative py-24 md:py-32 overflow-hidden flex items-center justify-center min-h-[70vh]">
    <!-- Background Glow Blobs -->
    <div class="bg-glow-blob"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.02),transparent_60%)]"></div>

    <div class="max-w-4xl mx-auto px-6 w-full text-center flex flex-col items-center gap-8 relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-muted border border-accent/20 text-accent text-xs font-mono font-semibold hover:border-accent/40 transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        Browser Extensions
      </div>
      <!-- Headline -->
      <h1 class="text-display text-text max-w-3xl leading-[1.05] tracking-tight">
        Lightweight browser extensions that <span class="bg-gradient-to-r from-accent via-indigo-400 to-accent bg-clip-text text-transparent">do one thing well.</span>
      </h1>
      <!-- Subtext -->
      <p class="text-body text-muted max-w-2xl leading-relaxed">
        Discover simple, beautifully designed browser utilities built to capture pages, manage audio volume, and browse content smoothly. No complex setups, no clutter.
      </p>
      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center w-full">
        <a
          href="/extensions"
          class="bg-accent hover:bg-accent-hover text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 hover:scale-[1.02] shadow-lg shadow-accent/15 text-center flex items-center justify-center gap-2 group w-full sm:w-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
        >
          Explore Extension Store
          <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
        <a
          href="/extensions"
          class="border border-border bg-surface/40 backdrop-blur-sm text-text hover:bg-surface hover:border-accent/30 px-8 py-4 rounded-xl font-semibold transition-all duration-300 hover:scale-[1.02] text-center w-full sm:w-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
        >
          View Directory
        </a>
      </div>
    </div>
  </section>

  <!-- Pillars / Values Section -->
  <section class="py-24 bg-bg border-y border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl flex flex-col gap-4 mb-16 text-left">
        <span class="text-[12px] font-mono text-accent uppercase tracking-wider font-semibold">Our Focus</span>
        <h2 class="text-h2 text-text">Built for utility. Designed for simplicity.</h2>
      </div>

      <!-- Cards grid layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="bg-surface border border-border/80 rounded-2xl p-8 flex flex-col gap-5 shadow-sm glow-card text-left">
          <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
            <Icon name="Zap" class="w-6 h-6 text-accent" />
          </div>
          <h3 class="text-h3 text-text font-bold">Instant Utility</h3>
          <p class="text-small text-muted leading-relaxed">
            Designed to solve a specific browsing task in a single click. Install and get to work immediately without any setup hurdles.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-surface border border-border/80 rounded-2xl p-8 flex flex-col gap-5 shadow-sm glow-card text-left">
          <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
            <Icon name="Activity" class="w-6 h-6 text-accent" />
          </div>
          <h3 class="text-h3 text-text font-bold">Lightweight &amp; Fast</h3>
          <p class="text-small text-muted leading-relaxed">
            Optimized code built for minimal browser overhead. Runs smoothly in the background without affecting your tab load speed.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-surface border border-border/80 rounded-2xl p-8 flex flex-col gap-5 shadow-sm glow-card text-left">
          <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
            <Icon name="Sparkles" class="w-6 h-6 text-accent" />
          </div>
          <h3 class="text-h3 text-text font-bold">Native Integration</h3>
          <p class="text-small text-muted leading-relaxed">
            Interfaces designed to blend directly into your browser layout, offering an intuitive experience that feels completely native.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Extensions Hub Section -->
  <section class="py-24 bg-bg">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 text-left">
        <div class="max-w-xl flex flex-col gap-4">
          <h2 class="text-h2 text-text">Everything we've built.</h2>
          <p class="text-small text-muted">
            Focused, lightweight browser tools designed to elevate your daily web browsing experience.
          </p>
        </div>
        <a href="/extensions" class="text-accent hover:underline font-semibold transition-colors flex items-center gap-1 text-sm">
          Browse all &rarr;
        </a>
      </div>

      <!-- Asymmetrical Spotlight Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Featured Spotlight Card: StoryPeek -->
        {(() => {
          const storyPeek = extensions.find(e => e.slug === 'story-peek');
          if (!storyPeek) return null;
          return (
            <div class="md:col-span-2 bg-surface border border-border/80 p-8 md:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 shadow-sm glow-card text-left relative overflow-hidden rounded-2xl">
              <div class="absolute -right-20 -bottom-20 w-48 h-48 rounded-full bg-accent/5 blur-3xl pointer-events-none"></div>
              <div class="flex-grow flex flex-col md:flex-row items-start gap-6 max-w-3xl">
                <div class="w-16 h-16 rounded-2xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent flex-shrink-0 shadow-sm">
                  <Icon name={storyPeek.data.icon} class="w-8 h-8 text-accent" />
                </div>
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-3 flex-wrap">
                    <h3 class="text-h2 text-text leading-tight">{storyPeek.data.title}</h3>
                    <span class="text-mono text-[10px] px-2.5 py-0.5 rounded-full bg-accent-muted text-accent font-semibold border border-accent/10">Featured Release</span>
                    <span class="text-mono text-xs text-muted">v{storyPeek.data.version}</span>
                  </div>
                  <p class="text-body text-muted leading-relaxed max-w-prose">
                    {storyPeek.data.description}
                  </p>
                  <div class="flex flex-wrap gap-4 mt-2">
                    {storyPeek.data.features.slice(0, 3).map((feat) => (
                      <span class="flex items-center gap-1.5 text-xs text-muted font-medium">
                        <Icon name="Check" class="w-4 h-4 text-accent" />
                        {feat.title}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
              
              <div class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto flex-shrink-0">
                <a
                  href={storyPeek.data.storeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-accent hover:bg-accent-hover text-white px-6 py-3 rounded-lg font-semibold transition-colors text-center text-sm shadow-sm w-full md:w-44 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer"
                >
                  Add to Chrome (Free)
                </a>
                <a href={`/extensions/${storyPeek.slug}`} class="border border-border text-text hover:bg-bg px-6 py-3 rounded-lg font-semibold transition-colors text-center text-sm w-full md:w-44 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none cursor-pointer">
                  Learn More &rarr;
                </a>
              </div>
            </div>
          );
        })()}

        <!-- Secondary Utilities: SnapElite and SonicShield -->
        {extensions.filter(e => e.slug !== 'story-peek').map((ext) => (
          <div class="bg-surface rounded-2xl border border-border/80 p-8 flex flex-col justify-between shadow-sm glow-card text-left relative overflow-hidden">
            <div class="absolute -right-20 -bottom-20 w-36 h-36 rounded-full bg-accent/3 blur-3xl pointer-events-none"></div>
            <div>
              <div class="flex items-center justify-between mb-6 border-b border-border/50 pb-4">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-center text-accent">
                    <Icon name={ext.data.icon} class="w-6 h-6 text-accent" />
                  </div>
                  <div>
                    <h3 class="text-h3 text-text leading-tight">{ext.data.title}</h3>
                    <span class="text-mono text-xs text-muted mt-1 block">v{ext.data.version}</span>
                  </div>
                </div>
                <span class="text-mono text-[10px] px-2 py-0.5 rounded-full bg-surface-2 text-muted border border-border">Preview</span>
              </div>
              
              <p class="text-small text-muted leading-relaxed mb-6">
                {ext.data.description}
              </p>
              
              <div class="flex flex-col gap-2.5 mb-8">
                {ext.data.features.slice(0, 2).map((feat) => (
                  <span class="flex items-start gap-2 text-xs text-muted font-medium">
                    <div class="mt-0.5 text-accent flex-shrink-0">
                      <Icon name="Check" class="w-3.5 h-3.5 text-accent" />
                    </div>
                    <span><strong class="text-text">{feat.title}:</strong> {feat.description}</span>
                  </span>
                ))}
              </div>
            </div>
            
            <div class="border-t border-border/50 pt-5 flex items-center justify-between gap-4">
              <a href={`/extensions/${ext.slug}`} class="text-accent hover:underline text-sm font-semibold flex items-center gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none">
                Learn More
                <Icon name="ArrowRight" class="w-4 h-4" />
              </a>
              <a
                href={ext.data.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-border text-text hover:bg-bg text-sm px-4 py-2 rounded-lg transition-colors font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent outline-none"
              >
                Add to Chrome
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter / CTA Section -->
  <section class="py-24 bg-surface border-t border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
        <!-- Left column -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <h2 class="text-h2 text-text">Stay in the loop.</h2>
          <p class="text-small text-muted max-w-prose">
            New extensions, privacy guides, and release notes. No marketing. Unsubscribe anytime.
          </p>
        </div>
        <!-- Right column -->
        <div class="lg:col-span-5 w-full">
          <div class="flex flex-col gap-2 w-full">
            <form class="flex flex-col sm:flex-row gap-3 w-full items-stretch" onsubmit="alert('Subscribed!'); return false;">
              <input
                type="email"
                placeholder="your@email.com"
                required
                class="flex-grow bg-surface-2 border border-border rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent text-text placeholder:text-muted"
              />
              <button
                type="submit"
                class="bg-accent hover:bg-accent-hover text-white px-6 py-3 rounded-lg text-sm font-semibold transition-colors duration-150 shadow-sm flex-shrink-0 cursor-pointer"
              >
                Subscribe
              </button>
            </form>
            <span class="text-[11px] text-muted flex items-center gap-1 mt-1 justify-start">
              <Icon name="Lock" class="w-3.5 h-3.5 text-accent" />
              We value your privacy. Zero spam. Unsubscribe anytime.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
