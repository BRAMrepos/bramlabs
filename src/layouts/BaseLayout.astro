---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';

import SiteBackground from '../components/SiteBackground.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
}

const { title, description, ogImage, structuredData } = Astro.props;
const extensions = await getCollection('extensions');
const siteUrl = 'https://bramlabs.co';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};

const navLinks = [
  { href: '/apps',       label: 'Apps' },
  { href: '/extensions', label: 'Extensions' },
  { href: '/web',        label: 'Web' },
  { href: '/merch',      label: 'Merch' },
  { href: '/blog',       label: 'Blog' },
  { href: '/about',      label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <!-- Prevent theme flicker before paint -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('bramlabs-theme');
          var theme = (t === 'light' || t === 'dark') ? t : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch(e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />

    <title>{title} | BramLabs</title>
    <meta name="title"       content={`${title} | BramLabs`} />
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow, max-image-preview:large" />
    <link rel="canonical"    href={canonicalURL} />
    <link rel="icon"         type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | BramLabs`} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | BramLabs`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />}

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body class="flex flex-col min-h-screen">
    <SiteBackground />

    <!-- Skip link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-blue-500 text-white rounded-md font-medium">
      Skip to content
    </a>

    <!-- Navigation Header -->
    <header
      id="site-header"
      class="sticky top-0 z-50 w-full backdrop-blur-md border-b border-white/[0.08] bg-[var(--header-bg)] transition-colors duration-150"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-6">

          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" aria-label="BramLabs Home">
            <div class="w-6 h-6 rounded bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150 shadow-sm">
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="1" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.95"/>
                <rect x="8" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.75"/>
                <rect x="1" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.75"/>
                <rect x="8" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.45"/>
              </svg>
            </div>
            <span class="text-base font-bold tracking-tight text-[var(--text-primary)]">
              BramLabs
            </span>
          </a>

          <!-- Desktop Navigation Links -->
          <nav class="hidden lg:flex items-center gap-1">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors duration-150',
                  isActive(link.href)
                    ? 'text-[var(--text-primary)] bg-white/[0.08]'
                    : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
                ]}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <!-- Right Header Controls -->
          <div class="hidden lg:flex items-center gap-3">
            <ThemeToggle />
            <a
              href="/work"
              class="btn btn-secondary text-xs px-3.5 py-1.5"
            >
              Explore Work
            </a>
          </div>

          <!-- Mobile Hamburger & Theme Toggle -->
          <div class="flex items-center gap-2 lg:hidden">
            <ThemeToggle />
            <button
              id="menu-btn"
              class="p-2 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.06] transition-colors"
              aria-label="Open menu"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          </div>

        </div>
      </div>
    </header>

    <!-- Mobile Drawer -->
    <div
      id="mobile-drawer"
      class="fixed inset-y-0 right-0 z-[60] w-72 bg-[var(--bg-surface)] border-l border-[var(--border-default)] shadow-2xl transform translate-x-full transition-transform duration-200 ease-out lg:hidden flex flex-col"
    >
      <div class="flex items-center justify-between p-4 border-b border-[var(--border-default)]">
        <span class="font-bold text-sm text-[var(--text-primary)]">Navigation</span>
        <button
          id="close-drawer-btn"
          class="p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.06] transition-colors"
          aria-label="Close menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <nav class="flex flex-col gap-1 p-3 flex-grow">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors duration-150',
              isActive(link.href)
                ? 'text-[var(--text-primary)] bg-white/[0.08]'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="p-4 border-t border-[var(--border-default)]">
        <a href="/work" class="btn btn-primary w-full justify-center text-xs">
          Explore Studio Work
        </a>
      </div>
    </div>

    <div id="drawer-overlay" class="fixed inset-0 z-[55] bg-black/60 hidden lg:hidden backdrop-blur-sm"></div>

    <!-- Main Page Content -->
    <main id="main-content" class="flex-grow relative z-1 font-sans">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--border-default)] bg-[var(--bg-surface)] py-14 text-sm text-[var(--text-muted)] relative z-1">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">

          <!-- Brand Info -->
          <div class="flex flex-col gap-3 lg:col-span-2">
            <a href="/" class="flex items-center gap-2 group w-fit">
              <div class="w-5 h-5 rounded bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white text-[10px] font-bold">
                B
              </div>
              <span class="font-bold text-[var(--text-primary)]">BramLabs</span>
            </a>
            <p class="text-xs leading-relaxed max-w-sm text-[var(--text-muted)]">
              Independent product studio. We ship mobile applications on the Amazon Appstore, Chrome extensions, web platforms, and original merchandise for our own IP.
            </p>
            <a href="mailto:support@bramlabs.co" class="text-xs font-semibold text-[var(--text-primary)] hover:underline w-fit">
              support@bramlabs.co
            </a>
          </div>

          <!-- Studio Navigation -->
          <div class="flex flex-col gap-2">
            <h4 class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-faint)] mb-1">Products</h4>
            <a href="/apps"       class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Mobile Apps</a>
            <a href="/extensions" class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Extensions</a>
            <a href="/web"        class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Web Apps</a>
            <a href="/work"       class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">All Work</a>
          </div>

          <!-- Merch & Reviewers -->
          <div class="flex flex-col gap-2">
            <h4 class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-faint)] mb-1">Merch &amp; Legal</h4>
            <a href="/merch"   class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">MBA Portfolio</a>
            <a href="/about"   class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">About Studio</a>
            <a href="/privacy" class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Privacy Policy</a>
            <a href="/terms"   class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Terms of Service</a>
          </div>

          <!-- Resources & Support -->
          <div class="flex flex-col gap-2">
            <h4 class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-faint)] mb-1">Resources</h4>
            <a href="/blog"     class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Developer Blog</a>
            <a href="/feedback" class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Feedback Portal</a>
            <a href="mailto:support@bramlabs.co" class="text-xs hover:text-[var(--text-primary)] transition-colors py-0.5">Support Email</a>
          </div>

        </div>

        <div class="mt-12 pt-6 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-faint)]">
          <p>&copy; {new Date().getFullYear()} BramLabs Studio. All rights reserved.</p>
          <div class="flex items-center gap-5">
            <a href="/privacy" class="hover:text-[var(--text-primary)] transition-colors">Privacy</a>
            <a href="/terms"   class="hover:text-[var(--text-primary)] transition-colors">Terms</a>
            <a href="/merch"   class="hover:text-[var(--text-primary)] transition-colors">Merch Reference</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Drawer & Drawer Script -->
    <script is:inline>
      (function() {
        var menuBtn  = document.getElementById('menu-btn');
        var closeBtn = document.getElementById('close-drawer-btn');
        var drawer   = document.getElementById('mobile-drawer');
        var overlay  = document.getElementById('drawer-overlay');

        function openDrawer() {
          if (!drawer || !overlay) return;
          drawer.classList.remove('translate-x-full');
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function closeDrawer() {
          if (!drawer || !overlay) return;
          drawer.classList.add('translate-x-full');
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
        }

        if (menuBtn)  menuBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (overlay)  overlay.addEventListener('click', closeDrawer);
      })();
    </script>
  </body>
</html>
