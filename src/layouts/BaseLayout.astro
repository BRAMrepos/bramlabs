---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
// Spec: Geist Mono for code/labels (replaces IBM Plex Mono)
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@/styles/global.scss";

interface Props {
  title?: string;
  description?: string;
  /** Social card. Should be a 1200x630 PNG — crawlers reject SVG. */
  image?: string;
  /**
   * Real pixel dimensions of `image`. Defaults to the 1200x630 card size.
   * Pass the true values when using a non-card image, otherwise crawlers get
   * dimensions that do not match the file and lay the preview out wrongly.
   */
  imageWidth?: number;
  imageHeight?: number;
  type?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "BramLabs — Independent Software Studio",
  description = "BramLabs builds small, focused software: shift and routine apps for Android, browser utilities for Chrome, and web tools — plus original apparel graphics from the same desk.",
  image = "/og/home.png",
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BramLabs",
  description:
    "Independent studio publishing small software products and original apparel graphics.",
  url: "https://bramlabs.co",
  email: "contact@bramlabs.co",
  logo: "https://bramlabs.co/icons/icon-512.png",
  founder: { "@type": "Person", name: "Bram" },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "support@bramlabs.co",
    url: "https://bramlabs.co/feedback/",
  },
};

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "BramLabs",
  url: "https://bramlabs.co",
  inLanguage: "en",
};

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- theme-color matches --paper and site.webmanifest; keep all three in sync -->
    <meta name="theme-color" content="#f3efe6" />
    <meta name="msapplication-TileColor" content="#f3efe6" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="BramLabs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta name="author" content="BramLabs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {
      extra.map((ld) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
