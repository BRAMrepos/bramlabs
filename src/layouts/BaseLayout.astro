---
import '../styles/global.css';
import SiteBackground from '../components/SiteBackground.astro';
import ScrollEffects from '../components/ScrollEffects.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
}

const { title, description, ogImage, structuredData } = Astro.props;
const extensions = await getCollection('extensions');
const siteUrl = 'https://bramlabs.co';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};

const navLinks = [
  { href: '/work',       label: 'Work' },
  { href: '/extensions', label: 'Extensions' },
  { href: '/web',        label: 'Web' },
  { href: '/merch',      label: 'Merch' },
  { href: '/blog',       label: 'Blog' },
  { href: '/about',      label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <!-- Theme before paint: no flash -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('bramlabs-theme');
          document.documentElement.setAttribute('data-theme', (t === 'light' || t === 'dark') ? t : 'dark');
        } catch(e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#06080f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f7fb" media="(prefers-color-scheme: light)" />

    <title>{title} | BramLabs</title>
    <meta name="title"       content={`${title} | BramLabs`} />
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow, max-image-preview:large" />
    <link rel="canonical"    href={canonicalURL} />
    <link rel="icon"         type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | BramLabs`} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | BramLabs`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />}

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Critical inline shell — paints before full CSS downloads -->
    <style is:inline>
      :root {
        --surface-0:#06080f; --surface-1:#0a0e17;
        --text-primary:#f1f5fb; --text-secondary:#b8c0d0;
        --text-muted:#8f99ab; --border-default:rgba(148,163,184,.12);
        --brand-sky:#38bdf8; --header-bg:rgba(6,8,15,.72);
        --site-bg-base:#06080f;
      }
      html { scroll-behavior:smooth; }
      body {
        margin:0; background:var(--surface-0); color:var(--text-secondary);
        font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
        -webkit-font-smoothing:antialiased; line-height:1.65; min-height:100vh;
      }
      h1,h2,h3 { font-weight:700; color:var(--text-primary); letter-spacing:-0.025em; }
      h1 { font-size:clamp(2.25rem,5vw,3.5rem); line-height:1.08; letter-spacing:-0.03em; }
      a { color:inherit; text-decoration:none; }
      .text-gradient {
        background:linear-gradient(115deg,#e0f2fe 0%,#38bdf8 38%,#818cf8 72%,#a78bfa 100%);
        -webkit-background-clip:text; background-clip:text;
        color:transparent; -webkit-text-fill-color:transparent;
      }
      #site-header {
        position:sticky; top:0; z-index:50;
        background:var(--header-bg);
        backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
        border-bottom:1px solid rgba(148,163,184,.07);
        transition:background .3s ease,border-color .3s ease,box-shadow .3s ease;
      }
      #site-header.scrolled {
        background:rgba(6,8,15,.94);
        border-bottom-color:rgba(255,255,255,.1);
        box-shadow:0 10px 30px -10px rgba(0,0,0,.7);
      }
      main,.site-footer { position:relative; z-index:1; }
      .site-bg { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;
        background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(56,189,248,.12),transparent 55%),
          radial-gradient(ellipse 50% 40% at 90% 10%,rgba(129,140,248,.1),transparent 50%),
          var(--surface-0); }
      .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px;
        padding:10px 20px; border-radius:8px; font-weight:600; font-size:.875rem; cursor:pointer; }
      .btn-primary {
        background:linear-gradient(160deg,#38bdf8 0%,#0ea5e9 100%);
        color:#fff; border:1px solid rgba(125,211,252,.35);
        box-shadow:0 6px 18px -8px rgba(14,165,233,.45);
      }
      .btn-secondary {
        background:rgba(255,255,255,.05); color:var(--text-primary);
        border:1px solid rgba(148,163,184,.2);
      }
    </style>

    <!-- Fonts: deferred, system UI paints first -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" />
    </noscript>
  </head>

  <body class="flex flex-col min-h-screen">
    <SiteBackground />
    <ScrollEffects />

    <!-- Read progress bar -->
    <div id="read-progress" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-400 z-[100] transition-all duration-150 ease-out" style="width:0%;pointer-events:none;"></div>

    <!-- Skip to main -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- Header -->
    <header
      id="site-header"
      class="sticky top-0 z-50 w-full backdrop-blur-xl border-b border-white/[0.07] bg-[var(--header-bg)] transition-all duration-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-[68px] gap-6">

          <!-- Logo -->
          <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" aria-label="BramLabs Home">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-105 transition-transform duration-200">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="1" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.9"/>
                <rect x="8" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.6"/>
                <rect x="1" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.6"/>
                <rect x="8" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.35"/>
              </svg>
            </div>
            <span class="text-[1.05rem] font-bold tracking-tight text-[var(--text-primary)]" style="font-family:Outfit,system-ui,sans-serif;">
              Bram<span class="text-sky-400">Labs</span>
            </span>
          </a>

          <!-- Desktop nav -->
          <nav class="hidden lg:flex items-center gap-1">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'px-3.5 py-2 rounded-lg text-sm font-medium transition-colors duration-150',
                  isActive(link.href)
                    ? 'text-[var(--text-primary)] bg-white/[0.06]'
                    : 'text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
                ]}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <!-- Right: theme toggle + CTA -->
          <div class="hidden lg:flex items-center gap-3">
            <ThemeToggle />
            <a
              href="/extensions"
              class="btn btn-primary text-xs px-4 py-2"
              style="min-height:2rem;"
            >
              Browse Extensions
            </a>
          </div>

          <!-- Mobile: theme + hamburger -->
          <div class="flex items-center gap-2 lg:hidden">
            <ThemeToggle />
            <button
              id="menu-btn"
              class="p-2 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.06] transition-colors"
              aria-label="Open navigation menu"
              aria-expanded="false"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Mobile drawer -->
    <div
      id="mobile-drawer"
      class="fixed inset-y-0 right-0 z-[60] w-72 bg-[var(--surface-1)] border-l border-[var(--border-default)] shadow-2xl transform translate-x-full transition-transform duration-250 ease-out lg:hidden flex flex-col"
    >
      <div class="flex items-center justify-between p-5 border-b border-[var(--border-default)]">
        <span class="font-bold text-[var(--text-primary)]" style="font-family:Outfit,sans-serif;">Menu</span>
        <button
          id="close-drawer-btn"
          class="p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.06] transition-colors"
          aria-label="Close menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <nav class="flex flex-col gap-0.5 p-4 flex-grow">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2.5 rounded-lg text-sm font-medium transition-colors duration-150',
              isActive(link.href)
                ? 'text-[var(--text-primary)] bg-white/[0.07]'
                : 'text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="p-4 border-t border-[var(--border-default)]">
        <a
          href="/extensions"
          class="btn btn-primary w-full justify-center"
        >
          Browse Chrome Extensions
        </a>
      </div>
    </div>
    <div id="drawer-overlay" class="fixed inset-0 z-[55] bg-black/60 hidden lg:hidden backdrop-blur-sm"></div>

    <!-- Main content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer border-t border-[var(--border-subtle)] bg-[var(--surface-1)] py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
          <!-- Brand -->
          <div class="flex flex-col gap-4 lg:col-span-2">
            <a href="/" class="flex items-center gap-2.5 group w-fit">
              <div class="w-6 h-6 rounded-md bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <rect x="1" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.9"/>
                  <rect x="8" y="1" width="5" height="5" rx="1.5" fill="white" opacity="0.6"/>
                  <rect x="1" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.6"/>
                  <rect x="8" y="8" width="5" height="5" rx="1.5" fill="white" opacity="0.35"/>
                </svg>
              </div>
              <span class="font-bold text-[var(--text-primary)]" style="font-family:Outfit,sans-serif;">
                Bram<span class="text-sky-400">Labs</span>
              </span>
            </a>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed max-w-xs">
              Indie product studio: Amazon Appstore apps, Chrome extensions, web products, and original merch for our own IP only.
            </p>
            <a href="mailto:support@bramlabs.co" class="text-sky-400 hover:text-sky-300 transition-colors text-sm font-medium w-fit">
              support@bramlabs.co
            </a>
          </div>

          <!-- Studio -->
          <div class="flex flex-col gap-2">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-[var(--text-faint)] mb-1">Studio</h3>
            <a href="/work"       class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Work</a>
            <a href="/apps"       class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Apps</a>
            <a href="/web"        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Web</a>
            <a href="/merch"      class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Merch &amp; Art</a>
            <a href="/about"      class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">About</a>
          </div>

          <!-- Extensions -->
          <div class="flex flex-col gap-2">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-[var(--text-faint)] mb-1">Extensions</h3>
            {extensions.map((ext) => (
              <a href={`/extensions/${ext.slug}`} class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">
                {ext.data.title}
              </a>
            ))}
            <a href="/extensions" class="text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors mt-1">
              All extensions →
            </a>
          </div>

          <!-- Resources -->
          <div class="flex flex-col gap-2">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-[var(--text-faint)] mb-1">Resources</h3>
            <a href="/blog"     class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Blog</a>
            <a href="/feedback" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Feedback</a>
            <a href="/privacy"  class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Privacy</a>
            <a href="/terms"    class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-sm transition-colors py-0.5">Terms</a>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-[var(--text-faint)] text-sm">
          <p>&copy; {new Date().getFullYear()} BramLabs. All rights reserved.</p>
          <div class="flex gap-6">
            <a href="/privacy" class="hover:text-[var(--text-muted)] transition-colors">Privacy</a>
            <a href="/terms"   class="hover:text-[var(--text-muted)] transition-colors">Terms</a>
            <a href="/merch"   class="hover:text-[var(--text-muted)] transition-colors">MBA portfolio</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Inline interaction script -->
    <script is:inline>
      (function() {
        // Mobile drawer
        var menuBtn    = document.getElementById('menu-btn');
        var closeBtn   = document.getElementById('close-drawer-btn');
        var drawer     = document.getElementById('mobile-drawer');
        var overlay    = document.getElementById('drawer-overlay');

        function openDrawer() {
          if (!drawer || !overlay) return;
          drawer.classList.remove('translate-x-full');
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
        }
        function closeDrawer() {
          if (!drawer || !overlay) return;
          drawer.classList.add('translate-x-full');
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
          if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
        }
        if (menuBtn)  menuBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (overlay)  overlay.addEventListener('click', closeDrawer);

        // Theme toggle
        var toggles = document.querySelectorAll('.theme-toggle');
        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          try { localStorage.setItem('bramlabs-theme', theme); } catch(e) {}
        }
        toggles.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var cur = document.documentElement.getAttribute('data-theme') || 'dark';
            applyTheme(cur === 'dark' ? 'light' : 'dark');
          });
        });
      })();
    </script>
  </body>
</html>
